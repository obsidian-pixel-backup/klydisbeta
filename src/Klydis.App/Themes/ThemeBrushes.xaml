<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ThemeColors.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource ColorBlueCharcoal}" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource ColorSurface1}" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{StaticResource ColorBlueCharcoal}" />
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="{StaticResource ColorBlueCharcoal}" />
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="{StaticResource ColorBlueCharcoal}" />
    <SolidColorBrush x:Key="BackgroundTertiary" Color="{StaticResource ColorSurface1}" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource ColorSurface1}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{StaticResource ColorSurface2}" />

    <!-- Surfaces -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource ColorSurface1}" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource ColorSurface2}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource ColorSurface3}" />

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource ColorBorderSubtle}" />
    <SolidColorBrush x:Key="BorderMidBrush" Color="{StaticResource ColorBorderMid}" />
    <SolidColorBrush x:Key="BorderBrushStrong" Color="{StaticResource ColorFluorescentBlue}" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource ColorTextMuted}" />
    <SolidColorBrush x:Key="TextInverse" Color="{StaticResource ColorBlueCharcoal}" />

    <!-- Accents -->
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="{StaticResource ColorFluorescentBlue}" />
    <SolidColorBrush x:Key="AccentSecondaryBrush" Color="{StaticResource ColorThinAir}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource ColorAccentSoft}" />

    <!-- Chat Bubbles -->
    <SolidColorBrush x:Key="UserBubbleBackgroundBrush" Color="{StaticResource ColorFluorescentBlue}" />
    <SolidColorBrush x:Key="UserBubbleTextBrush" Color="{StaticResource ColorBlueCharcoal}" />

    <SolidColorBrush x:Key="AssistantBubbleBackgroundBrush" Color="{StaticResource ColorSurface2}" />
    <SolidColorBrush x:Key="AssistantBubbleBorderBrush" Color="{StaticResource ColorBorderSubtle}" />
    <SolidColorBrush x:Key="ThinkingBubbleBackgroundBrush" Color="{StaticResource ColorSurface1}" />
    <SolidColorBrush x:Key="ThinkingBubbleBorderBrush" Color="{StaticResource ColorBorderSubtle}" />
    <SolidColorBrush x:Key="ToolBubbleBackgroundBrush" Color="{StaticResource ColorSurface1}" />
    <SolidColorBrush x:Key="SystemBubbleBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ErrorBubbleBackgroundBrush" Color="{StaticResource ColorErrorSoft}" />

    <!-- Utilities -->
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource ColorSuccess}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ColorError}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource ColorWarning}" />

</ResourceDictionary>
