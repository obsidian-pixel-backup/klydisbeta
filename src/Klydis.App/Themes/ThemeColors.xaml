<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Strict Palette -->
    <Color x:Key="ColorFluorescentBlue">#50E8F4</Color>
    <Color x:Key="ColorThinAir">#C7F8FE</Color>
    <Color x:Key="ColorBlueCharcoal">#0B0E14</Color>
    
    <!-- Utility Colors -->
    <Color x:Key="ColorSuccess">#3FB950</Color>
    <Color x:Key="ColorError">#F85149</Color>
    <Color x:Key="ColorWarning">#D29922</Color>

</ResourceDictionary>
