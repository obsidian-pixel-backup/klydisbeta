<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Markdown element theming for every MdXaml MarkdownScrollViewer in the app (chat
         messages, thinking bubble, artifact preview). MdXaml's built-in renderer hardcodes
         its own colors — light table zebra-striping, an off-theme heading tint, light
         inline-code chips — regardless of app theme, which reads as invisible text in dark
         mode. These styles are wired into the Markdown engine by MarkdownViewerStyler
         (Engine.TableStyle/HeadingStyle/CodeStyle/...), which the library applies
         unconditionally when non-null, so every element matches whichever mode + accent is
         active. -->

    <Style x:Key="MdTableStyle" TargetType="{x:Type Table}">
        <Setter Property="CellSpacing" Value="0"/>
        <Setter Property="Margin" Value="0,8,0,8"/>
    </Style>
    <Style x:Key="MdTableHeaderStyle" TargetType="{x:Type TableRowGroup}">
        <Style.Resources>
            <Style TargetType="{x:Type TableCell}">
                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="0,0,1,1"/>
            </Style>
        </Style.Resources>
    </Style>
    <Style x:Key="MdTableBodyStyle" TargetType="{x:Type TableRowGroup}">
        <Style.Resources>
            <Style TargetType="{x:Type TableCell}">
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="0,0,1,1"/>
            </Style>
        </Style.Resources>
    </Style>

    <!-- Headings with crisp proportional sizing, semi-bold weights, and clean vertical margins -->
    <Style x:Key="MdHeading1Style" TargetType="{x:Type Paragraph}">
        <Setter Property="FontSize" Value="21"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Margin" Value="0,16,0,8"/>
    </Style>
    <Style x:Key="MdHeading2Style" TargetType="{x:Type Paragraph}">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Margin" Value="0,14,0,6"/>
    </Style>
    <Style x:Key="MdHeading3Style" TargetType="{x:Type Paragraph}">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Margin" Value="0,12,0,5"/>
    </Style>
    <Style x:Key="MdHeadingMinorStyle" TargetType="{x:Type Paragraph}">
        <Setter Property="FontSize" Value="14.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Margin" Value="0,10,0,4"/>
    </Style>

    <!-- Body paragraph style with comfortable line height and paragraph spacing -->
    <Style x:Key="MdParagraphStyle" TargetType="{x:Type Paragraph}">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <!-- Inline code chips: monospace font, elevated surface, and vibrant accent color -->
    <Style x:Key="MdInlineCodeStyle" TargetType="{x:Type Run}">
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}"/>
        <Setter Property="FontSize" Value="13.5"/>
    </Style>

    <!-- Fenced code block fallback style -->
    <Style x:Key="MdCodeBlockStyle" TargetType="{x:Type Block}">
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Margin" Value="0,8"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- Blockquotes: 3px accent primary border with subtle surface tint -->
    <Style x:Key="MdBlockquoteStyle" TargetType="{x:Type Section}">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="3,0,0,0"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Margin" Value="0,8"/>
    </Style>

    <!-- Hyperlinks: styled with accent primary color -->
    <Style x:Key="MdLinkStyle" TargetType="{x:Type Hyperlink}">
        <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}"/>
        <Setter Property="TextDecorations" Value="None"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="TextDecorations" Value="Underline"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Horizontal separator lines -->
    <Style x:Key="MdSeparatorStyle" TargetType="{x:Type Separator}">
        <Setter Property="Background" Value="{DynamicResource BorderMidBrush}"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="0,10"/>
    </Style>

    <!-- Callout note blocks -->
    <Style x:Key="MdNoteStyle" TargetType="{x:Type Paragraph}">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="3,0,0,0"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Margin" Value="0,8"/>
    </Style>

</ResourceDictionary>
