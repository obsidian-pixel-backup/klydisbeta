<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Amber accent, Dark mode variant. Bright/vivid shade paired with the
         dark-mode TextInverse (near-black), matching the brand bubble pairing. -->
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#FFC24B" />
    <SolidColorBrush x:Key="AccentSecondaryBrush" Color="#FFE0A3" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#332711" />
    <SolidColorBrush x:Key="BorderBrushStrong" Color="#FFC24B" />

    <SolidColorBrush x:Key="UserBubbleBackgroundBrush" Color="#FFC24B" />
    <SolidColorBrush x:Key="UserBubbleTextBrush" Color="#2B1D02" />
    <!-- Attachment chips sit ON the bubble, so they are tinted with the bubble's own
         ink rather than white: the bubble is a bright pastel in BOTH modes, and a
         translucent-white wash on it never reached 1.3:1. Border alpha is tuned per
         accent to clear the 3:1 non-text contrast floor against that accent's bubble. -->
    <SolidColorBrush x:Key="UserBubbleChipBackgroundBrush" Color="#1F2B1D02" />
    <SolidColorBrush x:Key="UserBubbleChipBorderBrush" Color="#882B1D02" />

</ResourceDictionary>
