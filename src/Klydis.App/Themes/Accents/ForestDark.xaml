<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Forest accent, Dark mode variant. Bright/vivid shade paired with the
         dark-mode TextInverse (near-black), matching the brand bubble pairing. -->
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#7BE39B" />
    <SolidColorBrush x:Key="AccentSecondaryBrush" Color="#C4F5D4" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#12291B" />
    <SolidColorBrush x:Key="BorderBrushStrong" Color="#7BE39B" />

    <SolidColorBrush x:Key="UserBubbleBackgroundBrush" Color="#7BE39B" />
    <SolidColorBrush x:Key="UserBubbleTextBrush" Color="#08170E" />
    <!-- Attachment chips sit ON the bubble, so they are tinted with the bubble's own
         ink rather than white: the bubble is a bright pastel in BOTH modes, and a
         translucent-white wash on it never reached 1.3:1. Border alpha is tuned per
         accent to clear the 3:1 non-text contrast floor against that accent's bubble. -->
    <SolidColorBrush x:Key="UserBubbleChipBackgroundBrush" Color="#1F08170E" />
    <SolidColorBrush x:Key="UserBubbleChipBorderBrush" Color="#7E08170E" />

</ResourceDictionary>
