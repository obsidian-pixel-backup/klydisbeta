<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Rose accent, Dark mode variant. Bright/vivid shade paired with the
         dark-mode TextInverse (near-black), matching the brand bubble pairing. -->
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#FF8FB3" />
    <SolidColorBrush x:Key="AccentSecondaryBrush" Color="#FFCBDD" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#331420" />
    <SolidColorBrush x:Key="BorderBrushStrong" Color="#FF8FB3" />

    <SolidColorBrush x:Key="UserBubbleBackgroundBrush" Color="#FF8FB3" />
    <SolidColorBrush x:Key="UserBubbleTextBrush" Color="#2B0A16" />
    <!-- Attachment chips sit ON the bubble, so they are tinted with the bubble's own
         ink rather than white: the bubble is a bright pastel in BOTH modes, and a
         translucent-white wash on it never reached 1.3:1. Border alpha is tuned per
         accent to clear the 3:1 non-text contrast floor against that accent's bubble. -->
    <SolidColorBrush x:Key="UserBubbleChipBackgroundBrush" Color="#1F2B0A16" />
    <SolidColorBrush x:Key="UserBubbleChipBorderBrush" Color="#8A2B0A16" />

</ResourceDictionary>
