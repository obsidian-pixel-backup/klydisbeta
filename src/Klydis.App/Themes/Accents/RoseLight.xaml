<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Rose accent, Light mode variant. Deepened shade so white
         (TextInverse) text stays legible on accent-filled controls; hover is a
         darker step (a safe direction that can only improve contrast further). -->
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#C23566" />
    <SolidColorBrush x:Key="AccentSecondaryBrush" Color="#9C2A52" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#FBE3EC" />
    <SolidColorBrush x:Key="BorderBrushStrong" Color="#C23566" />

    <!-- Bubble stays the theme's bright shade regardless of mode: it carries its
         own background, so it reads fine on both a white and a dark page. -->
    <SolidColorBrush x:Key="UserBubbleBackgroundBrush" Color="#FF8FB3" />
    <SolidColorBrush x:Key="UserBubbleTextBrush" Color="#2B0A16" />

</ResourceDictionary>
