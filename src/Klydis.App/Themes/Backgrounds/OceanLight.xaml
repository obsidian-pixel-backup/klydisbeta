<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light mode: neutrals only. Canvas is a visibly tinted off-white; the main
         panel rises to pure white above it, mirroring Dark's elevation relationship
         (main content sits on the base tone, sidebar is a lifted surface). -->

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#EAF6F7" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#EAF6F7" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#EAF6F7" />
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#EAF6F7" />
    <SolidColorBrush x:Key="BackgroundTertiary" Color="#EAF6F7" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#D8EFF1" />

    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#EAF6F7" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#D8EFF1" />

    <SolidColorBrush x:Key="BorderBrush" Color="#CFE9EC" />
    <SolidColorBrush x:Key="BorderMidBrush" Color="#9FD6DB" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#04262B" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#3D6B72" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#6C959C" />
    <SolidColorBrush x:Key="TextInverse" Color="#FFFFFF" />

    <SolidColorBrush x:Key="AssistantBubbleBackgroundBrush" Color="#EAF6F7" />
    <SolidColorBrush x:Key="AssistantBubbleBorderBrush" Color="#CFE9EC" />
    <SolidColorBrush x:Key="ThinkingBubbleBackgroundBrush" Color="#EAF6F7" />
    <SolidColorBrush x:Key="ThinkingBubbleBorderBrush" Color="#CFE9EC" />
    <SolidColorBrush x:Key="ToolBubbleBackgroundBrush" Color="#EAF6F7" />
    <SolidColorBrush x:Key="SystemBubbleBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ErrorBubbleBackgroundBrush" Color="#FCEAEA" />

    <SolidColorBrush x:Key="SuccessBrush" Color="#1E8E3E" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#D5433D" />
    <SolidColorBrush x:Key="WarningBrush" Color="#A9720F" />

</ResourceDictionary>
