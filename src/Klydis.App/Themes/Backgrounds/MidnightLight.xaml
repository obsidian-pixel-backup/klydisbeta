<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F0F4FA" />

    <!-- Elevation shadow. DropShadowEffect takes a Color, not a Brush, so this is a
         Color resource. Light themes use a deep tint of their own hue: pure black at
         the authored opacities reads as a smudge on a pale ground. -->
    <Color x:Key="ShadowColor">#2B3A52</Color>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#F0F4FA" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#F0F4FA" />
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#F0F4FA" />
    <SolidColorBrush x:Key="BackgroundTertiary" Color="#F0F4FA" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#E1EBF5" />

    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#F0F4FA" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#E1EBF5" />

    <SolidColorBrush x:Key="BorderBrush" Color="#A4B5C5" />
    <SolidColorBrush x:Key="BorderMidBrush" Color="#7796B0" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#001533" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#204975" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#4B729C" />
    <SolidColorBrush x:Key="TextInverse" Color="#FFFFFF" />

    <SolidColorBrush x:Key="AssistantBubbleBackgroundBrush" Color="#F0F4FA" />
    <SolidColorBrush x:Key="AssistantBubbleBorderBrush" Color="#C8DDF0" />
    <SolidColorBrush x:Key="ThinkingBubbleBackgroundBrush" Color="#F0F4FA" />
    <SolidColorBrush x:Key="ThinkingBubbleBorderBrush" Color="#C8DDF0" />
    <SolidColorBrush x:Key="ToolBubbleBackgroundBrush" Color="#F0F4FA" />
    <SolidColorBrush x:Key="SystemBubbleBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ErrorBubbleBackgroundBrush" Color="#FCEAEA" />

    <SolidColorBrush x:Key="SuccessBrush" Color="#1B8038" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#C83F39" />
    <SolidColorBrush x:Key="WarningBrush" Color="#97660D" />

</ResourceDictionary>
