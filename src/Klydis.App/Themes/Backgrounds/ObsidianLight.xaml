<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F4F6" />

    <!-- Elevation shadow. DropShadowEffect takes a Color, not a Brush, so this is a
         Color resource. Light themes use a deep tint of their own hue: pure black at
         the authored opacities reads as a smudge on a pale ground. -->
    <Color x:Key="ShadowColor">#3F4247</Color>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="BackgroundTertiary" Color="#F3F4F6" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#E5E7EB" />

    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#E5E7EB" />

    <SolidColorBrush x:Key="BorderBrush" Color="#B0B3B8" />
    <SolidColorBrush x:Key="BorderMidBrush" Color="#8D939E" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#111827" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#4B5563" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#69707E" />
    <SolidColorBrush x:Key="TextInverse" Color="#FFFFFF" />

    <SolidColorBrush x:Key="AssistantBubbleBackgroundBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="AssistantBubbleBorderBrush" Color="#E5E7EB" />
    <SolidColorBrush x:Key="ThinkingBubbleBackgroundBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="ThinkingBubbleBorderBrush" Color="#E5E7EB" />
    <SolidColorBrush x:Key="ToolBubbleBackgroundBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="SystemBubbleBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ErrorBubbleBackgroundBrush" Color="#FEE2E2" />

    <SolidColorBrush x:Key="SuccessBrush" Color="#1B8038" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#C83F39" />
    <SolidColorBrush x:Key="WarningBrush" Color="#97660D" />

</ResourceDictionary>
