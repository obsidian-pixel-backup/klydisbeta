<Application x:Class="Klydis.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Klydis.App.Converters"
             xmlns:viewmodels="clr-namespace:Klydis.App.ViewModels"
             xmlns:views="clr-namespace:Klydis.App.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Index 0/1: active mode + accent, hot-swapped at runtime by ThemeService.
                     Kept as two independent dictionaries so light/dark and the brand
                     color can be chosen separately, mirroring Windows' own
                     Mode / Themes split in Settings > Personalization. -->
                <ResourceDictionary Source="Themes/Backgrounds/OceanDark.xaml" />
                <ResourceDictionary Source="Themes/Accents/FluorescentDark.xaml" />
                <ResourceDictionary Source="Themes/ThemeStyles.xaml" />
                <!-- Index 3: typography (font family/weight/style), hot-swapped by ThemeService. -->
                <ResourceDictionary Source="Themes/Typography.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
            <converters:BoolToColorConverter x:Key="BoolToColorConverter" />
            <converters:RoleToVisibilityConverter x:Key="RoleToVisibilityConverter" />
            <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
            <converters:StringEmptyToVisibilityConverter x:Key="StringEmptyToVisibilityConverter" />
            <converters:BoolToVisConverter x:Key="BoolToVisConverter" />
            <converters:InverseBoolToVisConverter x:Key="InverseBoolToVisConverter" />
            <converters:BoolToVisConverter x:Key="BooleanToVisibilityConverter" />
            <converters:InverseBoolToVisConverter x:Key="InverseBooleanToVisibilityConverter" />
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <converters:PercentToDashOffsetConverter x:Key="PercentToDashOffsetConverter" />
            <converters:SeverityToBrushConverter x:Key="SeverityToBrushConverter" />
            <converters:ZeroToCollapsedConverter x:Key="ZeroToCollapsedConverter" />
            
            <Style x:Key="PulsingDotStyle" TargetType="Ellipse">
                <Setter Property="Width" Value="7"/>
                <Setter Property="Height" Value="7"/>
                <Setter Property="Fill" Value="{DynamicResource AccentPrimaryBrush}"/>
                <Style.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.25" To="1" Duration="0:0:0.5"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Style.Triggers>
            </Style>
            
            <!-- View to ViewModel Bindings -->
            <DataTemplate DataType="{x:Type viewmodels:ChatViewModel}">
                <views:ChatView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:ModelLibraryViewModel}">
                <views:ModelLibraryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:SkillLibraryViewModel}">
                <views:SkillsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:SystemMonitorViewModel}">
                <views:SystemMonitorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:RagViewModel}">
                <views:RagView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
