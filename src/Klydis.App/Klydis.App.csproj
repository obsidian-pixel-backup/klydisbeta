<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <StartupObject>Klydis.App.Program</StartupObject>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Klydis.App</RootNamespace>
    <AssemblyName>Klydis</AssemblyName>
    <Description>Klydis - Self-contained local LLM orchestrator with premium UI</Description>

    <!-- Product identity: surfaces in Klydis.exe properties, Add/Remove Programs, and is
         what a code-signing certificate subject is matched against. -->
    <Version>0.5.0</Version>
    <AssemblyVersion>0.5.0.0</AssemblyVersion>
    <FileVersion>0.5.0.0</FileVersion>
    <InformationalVersion>0.5.0-beta</InformationalVersion>
    <Product>Klydis</Product>
    <Company>Klydis</Company>
    <Authors>Klydis</Authors>
    <Copyright>Copyright © Klydis 2026</Copyright>

    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <!-- Manifest supplies DPI awareness + Windows compatibility. Runs asInvoker
         (no UAC prompt) so dotnet run / Start-Klydis.bat work from a normal
         terminal. Elevated operations are handled per-action, not per-process. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Runtime knobs: TieredPgo layers the JIT profile-guided optimizations for the
         inference hot loops; ServerGarbageCollection uses per-core heaps, which suits the
         app's large native working set + parallel generation tasks better than workstation GC. -->
    <TieredPgo>true</TieredPgo>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Klydis.Core\Klydis.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dependency injection -->
    <PackageReference Include="MdXaml" Version="1.27.0" />
    <!-- MdXaml renders fenced code blocks as AvalonEdit TextEditor controls; the app rewrites
         them into themed FlowDocument code blocks (see MarkdownViewerStyler), so the control
         type is a direct dependency rather than a transitive one. -->
    <PackageReference Include="AvalonEdit" Version="6.3.0.90" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.11" />
    
    <!-- MVVM support -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    
    <!-- Markdown rendering -->
  </ItemGroup>

  <!-- Runtime data files: SystemPromptManager probes AppDomain.CurrentDomain.BaseDirectory
       for these, so they must sit next to Klydis.exe in every build — not just at the repo
       CWD under `dotnet run` (otherwise an installed build silently falls back to the generic
       assistant persona). -->
  <ItemGroup>
    <!-- The LOCAL runtime profile (see SystemPromptManager.MasterPromptFileName). The old
         "klydis master system prompt.md" cloud-product persona is deliberately NOT shipped or
         loaded — it made the local model behave like a cloud assistant. -->
    <Content Include="..\..\klydis local system prompt.md"
             Link="klydis local system prompt.md"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\UserStyle_Modes.md"
             Link="UserStyle_Modes.md"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Bundled skills: only assets/skills/custom ships (the awesome-llm-skills and
       nvidia-skills submodules are uninitialised and would otherwise produce empty globs).
       SkillLibraryManager treats BaseDirectory\assets\skills as read-only bundled content and
       seeds the user-writable copy (%USERPROFILE%\.klydis\skills) from it on first run. -->
  <ItemGroup>
    <Content Include="..\..\assets\skills\custom\**\*"
             Link="assets\skills\custom\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Bundled model manifests: SplitModelRestorer and ModelDiscoveryService locate
       the model binaries from dev repository root (FindDevRoot) and %USERPROFILE%\.klydis\models.
       Only copy manifest.json metadata to avoid copying 15+ GB of GGUF/part binaries on build. -->
  <ItemGroup>
    <Content Include="..\..\assets\models\**\manifest.json"
             Link="assets\models\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Update="runtimes\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\icon.ico" />
  </ItemGroup>

</Project>
