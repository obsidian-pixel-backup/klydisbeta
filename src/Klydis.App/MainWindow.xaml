<Window x:Class="Klydis.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:Klydis.App.ViewModels"
        xmlns:views="clr-namespace:Klydis.App.Views"
        xmlns:converters="clr-namespace:Klydis.App.Converters"
        mc:Ignorable="d"
        Title="{Binding AppTitle}"
        Icon="Assets/icon.ico"
        Height="800" Width="1200"
        MinHeight="600" MinWidth="800"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowState="Maximized">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CornerRadius="10" CaptionHeight="32" ResizeBorderThickness="6"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <converters:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
        <!-- DataTemplates for routing ViewModels to Views -->
        <DataTemplate DataType="{x:Type viewmodels:ChatViewModel}">
            <views:ChatView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:SkillLibraryViewModel}">
            <views:SkillsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:RagViewModel}">
            <views:RagView />
        </DataTemplate>
        <!-- TitleBarButtonStyle/CloseButtonStyle now live in ThemeStyles.xaml (shared
             with TextContextWindow's custom chrome) - resolved via the app-wide merged
             dictionary, so no local copy is needed here. -->

        <!-- Status bar telemetry item styles with severity coloring -->
        <Style x:Key="StatusBarItemText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style x:Key="StatusBarCpuText" TargetType="TextBlock" BasedOn="{StaticResource StatusBarItemText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SystemMonitorViewModel.CpuSeverity}" Value="Warning">
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SystemMonitorViewModel.CpuSeverity}" Value="Critical">
                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusBarGpuText" TargetType="TextBlock" BasedOn="{StaticResource StatusBarItemText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SystemMonitorViewModel.GpuSeverity}" Value="Warning">
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SystemMonitorViewModel.GpuSeverity}" Value="Critical">
                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusBarRamText" TargetType="TextBlock" BasedOn="{StaticResource StatusBarItemText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SystemMonitorViewModel.RamSeverity}" Value="Warning">
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SystemMonitorViewModel.RamSeverity}" Value="Critical">
                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusBarVramText" TargetType="TextBlock" BasedOn="{StaticResource StatusBarItemText}">
            <Setter Property="Margin" Value="0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SystemMonitorViewModel.VramSeverity}" Value="Warning">
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SystemMonitorViewModel.VramSeverity}" Value="Critical">
                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusBarContextText" TargetType="TextBlock" BasedOn="{StaticResource StatusBarItemText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SystemMonitorViewModel.ContextWindowSeverity}" Value="Warning">
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SystemMonitorViewModel.ContextWindowSeverity}" Value="Critical">
                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="MainBorder" Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="10">
        <Grid x:Name="MainGrid" Margin="8">
            <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="38"/>
        </Grid.RowDefinitions>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="48"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Custom Title Bar -->
        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" 
                Background="{DynamicResource TitleBarBackgroundBrush}" 
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                    <TextBlock Text="K" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding AppTitle}" Margin="5,0,0,0" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource TitleBarButtonStyle}" Click="MinimizeButton_Click" AutomationProperties.Name="Minimize">
                        <Path Data="M 0,5 L 10,5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource TitleBarButtonStyle}" Click="MaximizeButton_Click" AutomationProperties.Name="Maximize">
                        <Path Data="M 1,1 L 1,9 L 9,9 L 9,1 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
                    </Button>
                    <Button Style="{StaticResource CloseButtonStyle}" Click="CloseButton_Click" AutomationProperties.Name="Close">
                        <Path Data="M 1,1 L 9,9 M 1,9 L 9,1" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Left Activity Bar -->
        <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="0,10,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <StackPanel Grid.Row="0">
                    <RadioButton Style="{DynamicResource ActivityTabStyle}" GroupName="ActivityBar" 
                                 IsChecked="{Binding ActivePanel, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Chat}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Chat"
                                 AutomationProperties.Name="Chat" ToolTip="Chat">
                        <Path Data="M 2,2 L 14,2 L 14,10 L 10,10 L 6,14 L 6,10 L 2,10 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                    </RadioButton>
                    <RadioButton Style="{DynamicResource ActivityTabStyle}" GroupName="ActivityBar" 
                                 IsChecked="{Binding ActivePanel, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Models}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Models"
                                 AutomationProperties.Name="Model hub" ToolTip="Model hub">
                        <Path Data="M 2,14 L 2,4 C 2,2 14,2 14,4 L 14,14 Z M 5,7 L 11,7" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5" Fill="Transparent"/>
                    </RadioButton>

                    <!-- Active model download indicator: sits under the Models icon where the
                         download actually happens (was previously placed between Skills and
                         Monitor, under the wrong icon). -->
                    <StackPanel Margin="0,-5,0,5" Visibility="{Binding ModelLibraryViewModel.HasActiveDownloads, Converter={StaticResource BooleanToVisibilityConverter}}"
                                AutomationProperties.Name="Model download progress"
                                ToolTip="Downloading model files…">
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding ModelLibraryViewModel.TotalDownloadProgress}" 
                                     Height="4" Margin="8,0,8,2" Foreground="{DynamicResource AccentPrimaryBrush}" Background="{DynamicResource BackgroundTertiary}" BorderThickness="0" />
                        <TextBlock Text="{Binding ModelLibraryViewModel.TotalDownloadProgress, StringFormat={}{0:F0}%}" 
                                   Foreground="{DynamicResource AccentPrimaryBrush}" FontSize="9" HorizontalAlignment="Center" FontWeight="SemiBold" />
                    </StackPanel>

                    <RadioButton Style="{DynamicResource ActivityTabStyle}" GroupName="ActivityBar" 
                                 IsChecked="{Binding ActivePanel, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Skills}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Skills"
                                 AutomationProperties.Name="Skill library and brain"
                                 ToolTip="Skill Library &amp; Brain">
                        <Path Data="M 12 2 L 2 7 L 12 12 L 22 7 Z M 2 17 L 12 22 L 22 17 M 2 12 L 12 17 L 22 12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5" Fill="Transparent"/>
                    </RadioButton>
                    <RadioButton Style="{DynamicResource ActivityTabStyle}" GroupName="ActivityBar" 
                                 IsChecked="{Binding ActivePanel, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Rag}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Rag"
                                 AutomationProperties.Name="Knowledge base and workspace indexer"
                                 ToolTip="Local Vector RAG &amp; Workspace Indexer">
                        <Path Data="M 4 2 L 16 2 C 17 2 18 3 18 4 L 18 16 C 18 17 17 18 16 18 L 4 18 C 3 18 2 17 2 16 L 2 4 C 2 3 3 2 4 2 Z M 6 6 L 14 6 M 6 10 L 14 10 M 6 14 L 10 14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5" Fill="Transparent"/>
                    </RadioButton>
                </StackPanel>

                <RadioButton Grid.Row="1" Style="{DynamicResource ActivityTabStyle}" GroupName="ActivityBar" 
                             IsChecked="{Binding ActivePanel, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Settings}"
                             Command="{Binding NavigateCommand}" CommandParameter="Settings"
                             AutomationProperties.Name="Settings" ToolTip="Settings">
                    <Path Data="M 6,2 L 10,2 L 10,4 L 12,5 L 14,3 L 16,5 L 14,7 L 15,9 L 17,9 L 17,13 L 15,13 L 14,15 L 16,17 L 14,19 L 12,17 L 10,18 L 10,20 L 6,20 L 6,18 L 4,17 L 2,19 L 0,17 L 2,15 L 1,13 L -1,13 L -1,9 L 1,9 L 2,7 L 0,5 L 2,3 L 4,5 L 6,4 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                </RadioButton>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding CurrentView}"/>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Background="{DynamicResource StatusBarBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Unload" Command="{Binding ChatViewModel.UnloadModelCommand}" 
                            Visibility="{Binding IsModelLoaded, Converter={StaticResource BoolToVisConverter}}"
                            Margin="0,0,10,0" Padding="8,2"
                            Background="Transparent" Foreground="{DynamicResource TextMutedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            ToolTip="Unload the current model" AutomationProperties.Name="Unload the current model"/>
                    <Ellipse Width="8" Height="8" Margin="0,0,6,0"
                             Visibility="{Binding ChatViewModel.IsModelLoading, Converter={StaticResource InverseBoolToVisConverter}}">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ChatViewModel.IsModelReady}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <Ellipse Style="{StaticResource PulsingDotStyle}" Width="8" Height="8" Margin="0,0,6,0"
                             Visibility="{Binding ChatViewModel.IsModelLoading, Converter={StaticResource BoolToVisConverter}}"/>

                    <TextBlock Text="Model:" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    
                    <ComboBox Width="250" Height="30" AutomationProperties.Name="Active model"
                              ItemsSource="{Binding ChatViewModel.AvailableModels}" 
                              SelectedItem="{Binding ChatViewModel.SelectedModelId, Mode=TwoWay}"
                              ToolTip="Choose which model answers your messages"
                              Background="{DynamicResource InputBackgroundBrush}" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}"
                              VerticalContentAlignment="Center"
                              VerticalAlignment="Center"/>
                              
                    <TextBlock Text="{Binding ChatViewModel.ModelLoadStatusText}" FontSize="12" FontStyle="Italic" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"
                               AutomationProperties.Name="{Binding ChatViewModel.ModelLoadStatusText}"
                               Visibility="{Binding ChatViewModel.IsModelLoading, Converter={StaticResource BoolToVisConverter}}"/>
                    <TextBlock Text="ready" FontSize="12" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding ChatViewModel.IsModelReady}" Value="True"/>
                                            <Condition Binding="{Binding ChatViewModel.IsModelLoading}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- Background dependency-update notification (driven by DependencyUpdateChecker).
                         Clickable: opens the update dialog where the user can apply the updates. -->
                    <Button Margin="16,0,8,0" Padding="0" Background="Transparent" BorderThickness="0"
                            Cursor="Hand" HorizontalContentAlignment="Left"
                            Command="{Binding OpenDependencyUpdateCommand}"
                            Visibility="{Binding DependencyUpdatesAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x26A0; " FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}"/>
                            <TextBlock Text="{Binding DependencyUpdateSummary}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}"/>
                        </StackPanel>
                        <Button.ToolTip>
                            <ToolTip>
                                <StackPanel>
                                    <TextBlock Text="Newer dependency versions are available on NuGet. Click to review and update." FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding DependencyUpdateDetails}" TextWrapping="Wrap" MaxWidth="420"/>
                                </StackPanel>
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>

                    <!-- Chat and system telemetry stats in status-bar formation -->
                    <TextBlock Text="{Binding SystemMonitorViewModel.CpuUsagePercent, StringFormat='CPU: {0:F1}%'}"
                               Style="{StaticResource StatusBarCpuText}"
                               ToolTip="{Binding SystemMonitorViewModel.ProcessCpuUsagePercent, StringFormat=Process CPU: {0:F1}% | System CPU: Total Load}"/>

                    <TextBlock Text="{Binding SystemMonitorViewModel.GpuUsagePercent, StringFormat='GPU: {0}%'}"
                               Style="{StaticResource StatusBarGpuText}"
                               ToolTip="{Binding SystemMonitorViewModel.GpuName, StringFormat=GPU: {0}}"/>

                    <TextBlock Text="{Binding SystemMonitorViewModel.RamUsedGb, StringFormat='RAM: {0:F1} GB'}"
                               Style="{StaticResource StatusBarRamText}"
                               ToolTip="{Binding SystemMonitorViewModel.AppRamUsedMb, StringFormat=App WorkingSet RAM: {0} MB}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center"
                                ToolTip="{Binding SystemMonitorViewModel.VramFreePercent, StringFormat='VRAM free: {0:F0}%'}">
                        <TextBlock Text="{Binding SystemMonitorViewModel.VramUsedMb, StringFormat='VRAM: {0} MB / '}"
                                   Style="{StaticResource StatusBarVramText}"/>
                        <TextBlock Text="{Binding SystemMonitorViewModel.VramTotalMb, StringFormat='{}{0} MB'}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="{Binding SystemMonitorViewModel.ModelMemoryMb, StringFormat='Model Mem: {0:F1} MB'}"
                               Style="{StaticResource StatusBarItemText}"
                               ToolTip="Estimated model memory footprint"/>

                    <TextBlock Text="{Binding SystemMonitorViewModel.CurrentTokensPerSecond, StringFormat='Speed: {0:F1} t/s'}"
                               Style="{StaticResource StatusBarItemText}"
                               ToolTip="Token generation throughput (live and last generation run)"/>

                    <TextBlock Text="{Binding SystemMonitorViewModel.TokenUsageSummary}"
                               Style="{StaticResource StatusBarItemText}"
                               ToolTip="{Binding SystemMonitorViewModel.TokenUsageTooltip}"/>

                    <TextBlock Text="{Binding SystemMonitorViewModel.ContextWindowRemainingPercent, StringFormat='Context: {0:F0}% free'}"
                               Style="{StaticResource StatusBarContextText}"
                               ToolTip="{Binding SystemMonitorViewModel.ContextWindowSummary}"
                               Margin="0,0,4,0"/>
                </StackPanel>
            </Grid>
        </Border>
        </Grid>
    </Border>
</Window>
