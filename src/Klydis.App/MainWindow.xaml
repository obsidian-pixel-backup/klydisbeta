<Window x:Class="Klydis.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:Klydis.App.ViewModels"
        xmlns:views="clr-namespace:Klydis.App.Views"
        xmlns:converters="clr-namespace:Klydis.App.Converters"
        mc:Ignorable="d"
        Title="{Binding AppTitle}" 
        Height="800" Width="1200" 
        MinHeight="600" MinWidth="800"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowState="Maximized">

    <Window.Resources>
        <converters:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
        <!-- DataTemplates for routing ViewModels to Views -->
        <DataTemplate DataType="{x:Type viewmodels:ChatViewModel}">
            <views:ChatView />
        </DataTemplate>
        <Style TargetType="Button" x:Key="TitleBarButtonStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="CloseButtonStyle" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="48"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Custom Title Bar -->
        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" 
                Background="{DynamicResource TitleBarBackgroundBrush}" 
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                    <TextBlock Text="K" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding AppTitle}" Margin="5,0,0,0" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource TitleBarButtonStyle}" Click="MinimizeButton_Click">
                        <Path Data="M 0,5 L 10,5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource TitleBarButtonStyle}" Click="MaximizeButton_Click">
                        <Path Data="M 1,1 L 1,9 L 9,9 L 9,1 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
                    </Button>
                    <Button Style="{StaticResource CloseButtonStyle}" Click="CloseButton_Click">
                        <Path Data="M 1,1 L 9,9 M 1,9 L 9,1" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Left Activity Bar -->
        <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <StackPanel Margin="0,10,0,0">
                <RadioButton Style="{DynamicResource ActivityTabStyle}" GroupName="ActivityBar" 
                             IsChecked="{Binding ActivePanel, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Chat}"
                             Command="{Binding NavigateCommand}" CommandParameter="Chat">
                    <Path Data="M 2,2 L 14,2 L 14,10 L 10,10 L 6,14 L 6,10 L 2,10 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                </RadioButton>
                <RadioButton Style="{DynamicResource ActivityTabStyle}" GroupName="ActivityBar" 
                             IsChecked="{Binding ActivePanel, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Models}"
                             Command="{Binding NavigateCommand}" CommandParameter="Models">
                    <Path Data="M 2,14 L 2,4 C 2,2 14,2 14,4 L 14,14 Z M 5,7 L 11,7" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5" Fill="Transparent"/>
                </RadioButton>
                <RadioButton Style="{DynamicResource ActivityTabStyle}" GroupName="ActivityBar" 
                             IsChecked="{Binding ActivePanel, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Monitor}"
                             Command="{Binding NavigateCommand}" CommandParameter="Monitor">
                    <Path Data="M 2,14 L 14,14 M 4,14 L 4,8 M 8,14 L 8,4 M 12,14 L 12,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5"/>
                </RadioButton>
                <RadioButton Style="{DynamicResource ActivityTabStyle}" GroupName="ActivityBar" 
                             IsChecked="{Binding ActivePanel, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Settings}"
                             Command="{Binding NavigateCommand}" CommandParameter="Settings" Margin="0,100,0,0">
                    <Path Data="M 6,2 L 10,2 L 10,4 L 12,5 L 14,3 L 16,5 L 14,7 L 15,9 L 17,9 L 17,13 L 15,13 L 14,15 L 16,17 L 14,19 L 12,17 L 10,18 L 10,20 L 6,20 L 6,18 L 4,17 L 2,19 L 0,17 L 2,15 L 1,13 L -1,13 L -1,9 L 1,9 L 2,7 L 0,5 L 2,3 L 4,5 L 6,4 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                </RadioButton>
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding CurrentView}"/>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Background="{DynamicResource StatusBarBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M 2,8 A 6,6 0 1,1 14,8 A 6,6 0 1,1 2,8" 
                          Fill="{Binding IsModelLoaded, Converter={StaticResource BoolToColorConverter}}" 
                          Width="8" Height="8" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SystemMonitorViewModel.CpuUsagePercent, StringFormat='CPU: {0:F1}%'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding SystemMonitorViewModel.RamUsedGb, StringFormat='RAM: {0:F1} GB'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding SystemMonitorViewModel.VramUsedMb, StringFormat='VRAM: {0} MB / '}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                    <TextBlock Text="{Binding SystemMonitorViewModel.VramTotalMb, StringFormat='{}{0} MB'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding SystemMonitorViewModel.ModelMemoryMb, StringFormat='Model Mem: {0:F1} MB'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding SystemMonitorViewModel.CurrentTokensPerSecond, StringFormat='{}{0:F1} t/s'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
