<UserControl x:Class="Klydis.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewmodels="clr-namespace:Klydis.App.ViewModels"
             xmlns:services="clr-namespace:Klydis.App.Services"
             xmlns:controls="clr-namespace:Klydis.App.Controls"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1000"
             Background="{DynamicResource PanelBackgroundBrush}">

    <UserControl.Resources>
        <!-- Sub-nav item: mirrors the session-list selection convention (tinted
             background on the active row) so Settings reads as one more section of
             the same app, not a bolted-on page. -->
        <Style x:Key="SettingsNavItemStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Mode row: compact, matches Windows Settings > Personalization > Colors
             ("Choose your mode" + a dropdown), not a big card - mode is a single
             lightness switch, not a visual identity choice. -->
        <Style x:Key="ModeOptionStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="MinWidth" Value="66"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Theme gallery tile: a small mockup of the accent color rather than a
             flat swatch, so it previews how the accent will actually read. -->
        <Style x:Key="ThemeTileStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Width" Value="135"/>
        </Style>
        <Style x:Key="ThemeCheckRingStyle" TargetType="Ellipse">
            <Setter Property="Stroke" Value="{DynamicResource BorderMidBrush}"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Settings sub-navigation -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <StackPanel Margin="12,20">
                <TextBlock Text="SETTINGS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="8,0,0,12"/>

                <Border>
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateSettingsCommand}" CommandParameter="Appearance"/>
                    </Border.InputBindings>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource SettingsNavItemStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedCategory}" Value="Appearance">
                                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M 8,1 A 7,7 0 1 0 8,15 A 3.2,3.2 0 0 1 8,8.6 A 3.2,3.2 0 0 0 8,1 Z M 4.5,5 A 1,1 0 1 1 4.5,5.01 M 11.5,5 A 1,1 0 1 1 11.5,5.01 M 4,10.5 A 1,1 0 1 1 4,10.51"
                              Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedCategory}" Value="Appearance">
                                            <Setter Property="Fill" Value="{DynamicResource AccentPrimaryBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <TextBlock Text="Appearance" FontSize="13" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                    <Setter Property="FontWeight" Value="Normal"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedCategory}" Value="Appearance">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border>
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateSettingsCommand}" CommandParameter="ModelSettings"/>
                    </Border.InputBindings>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource SettingsNavItemStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedCategory}" Value="ModelSettings">
                                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M 8,2 A 4,4 0 1 1 8,10 A 4,4 0 0 1 8,2 Z M 2,15 C 2,11.5 5,11 8,11 C 11,11 14,11.5 14,15 Z"
                              Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedCategory}" Value="ModelSettings">
                                            <Setter Property="Fill" Value="{DynamicResource AccentPrimaryBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <TextBlock Text="Model Settings" FontSize="13" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                    <Setter Property="FontWeight" Value="Normal"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedCategory}" Value="ModelSettings">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>


                <Border>
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateSettingsCommand}" CommandParameter="About"/>
                    </Border.InputBindings>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource SettingsNavItemStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedCategory}" Value="About">
                                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M 8,1 A 7,7 0 1 0 8.01,1 M 8,7 L 8,11.5 M 8,4.3 L 8,4.31"
                              StrokeThickness="1.4" Fill="Transparent"
                              Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedCategory}" Value="About">
                                            <Setter Property="Stroke" Value="{DynamicResource AccentPrimaryBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <TextBlock Text="About" FontSize="13" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                    <Setter Property="FontWeight" Value="Normal"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedCategory}" Value="About">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,24" HorizontalAlignment="Stretch" MaxWidth="1180">

                <!-- Appearance section (2-column layout) -->
                <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource RoleToVisibilityConverter}, ConverterParameter=Appearance}">
                    <!-- Appearance Header with Reset All to Defaults -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Appearance" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Personalize how Klydis looks across themes, backgrounds, colors, and typography." FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Reset All to Defaults" Command="{Binding ResetAllAppearanceCommand}"
                                Style="{DynamicResource SecondaryButton}" VerticalAlignment="Center" Padding="14,7" FontSize="12"
                                ToolTip="Reset mode, background, accent theme, typography, and all manual color overrides back to factory defaults" AutomationProperties.Name="Reset mode, background, accent theme, typography, and all manual color overrides back to factory defaults"/>
                    </Grid>

                    <!-- 2-Column Grid -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*" MinWidth="340"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="1*" MinWidth="320"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT COLUMN: Mode + Backgrounds + Themes -->
                        <StackPanel Grid.Column="0">
                            <!-- Mode: a single compact row, like Windows' "Choose your mode" -->
                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="18,16" Margin="0,0,0,18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                                        <Grid Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Ellipse Stroke="{DynamicResource AccentPrimaryBrush}" StrokeThickness="1.4" Width="16" Height="16"/>
                                            <Path Data="M 8,1 A 7,7 0 0 1 8,15 Z" Fill="{DynamicResource AccentPrimaryBrush}"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,12,0">
                                        <TextBlock Text="Mode" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Change the lightness across Klydis" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>

                                    <Border Grid.Column="2" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderMidBrush}" BorderThickness="1" CornerRadius="9" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="2" VerticalAlignment="Center">
                                            <Border>
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource ModeOptionStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedMode}" Value="Dark">
                                                                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick" Command="{Binding SelectModeCommand}" CommandParameter="Dark"/>
                                                </Border.InputBindings>
                                                <TextBlock Text="Dark" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </Border>
                                            <Border>
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource ModeOptionStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedMode}" Value="Light">
                                                                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick" Command="{Binding SelectModeCommand}" CommandParameter="Light"/>
                                                </Border.InputBindings>
                                                <TextBlock Text="Light" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </Border>
                                            <Border>
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource ModeOptionStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedMode}" Value="System">
                                                                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick" Command="{Binding SelectModeCommand}" CommandParameter="System"/>
                                                </Border.InputBindings>
                                                <TextBlock Text="System" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Backgrounds: a gallery of background color identities -->
                            <TextBlock Text="BACKGROUNDS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="2,0,0,10"/>
                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="18,16" Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="Pick the background color identity of the app." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,14"/>
                                    <ItemsControl ItemsSource="{Binding BackgroundSwatches}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type viewmodels:BackgroundSwatch}">
                                                <Border Margin="0,0,10,10">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource ThemeTileStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
                                                                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Border.InputBindings>
                                                        <MouseBinding MouseAction="LeftClick"
                                                                      Command="{Binding DataContext.SelectBackgroundCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                      CommandParameter="{Binding Name}"/>
                                                    </Border.InputBindings>
                                                    <StackPanel>
                                                        <Border CornerRadius="6" Height="50" ClipToBounds="True" Background="{Binding Swatch}">
                                                            <StackPanel VerticalAlignment="Center" Margin="8">
                                                                <Border Height="8" Width="58" CornerRadius="4" Background="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Left" Margin="0,0,0,5" Opacity="0.85"/>
                                                                <Border Height="8" Width="38" CornerRadius="4" Background="{DynamicResource TextPrimaryBrush}" Opacity="0.4" HorizontalAlignment="Left"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <Grid Margin="1,8,1,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                            <Grid Grid.Column="1" Width="15" Height="15">
                                                                <Ellipse Style="{StaticResource ThemeCheckRingStyle}" Visibility="{Binding IsSelected, Converter={StaticResource InverseBoolToVisConverter}}"/>
                                                                <Ellipse Fill="{DynamicResource AccentPrimaryBrush}" Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisConverter}}"/>
                                                                <Path Data="M 3,8 L 6.5,11.5 L 13,4" Stroke="{DynamicResource TextInverse}" StrokeThickness="2"
                                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                                      Width="9" Height="9" Stretch="Uniform"
                                                                      Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisConverter}}"/>
                                                            </Grid>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Themes: a gallery of accent color identities -->
                            <TextBlock Text="THEMES" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="2,0,0,10"/>
                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="18,16" Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="Pick the accent color Klydis uses across the whole app." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,14"/>
                                    <ItemsControl ItemsSource="{Binding AccentSwatches}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type viewmodels:AccentSwatch}">
                                                <Border Margin="0,0,10,10">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource ThemeTileStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
                                                                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Border.InputBindings>
                                                        <MouseBinding MouseAction="LeftClick"
                                                                      Command="{Binding DataContext.SelectAccentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                      CommandParameter="{Binding Name}"/>
                                                    </Border.InputBindings>
                                                    <StackPanel>
                                                        <Border CornerRadius="6" Height="50" ClipToBounds="True" Background="{DynamicResource SurfaceBrush}">
                                                            <StackPanel VerticalAlignment="Center" Margin="8">
                                                                <Border Height="8" Width="58" CornerRadius="4" Background="{Binding Swatch}" HorizontalAlignment="Left" Margin="0,0,0,5"/>
                                                                <Border Height="8" Width="38" CornerRadius="4" Background="{Binding Swatch}" Opacity="0.4" HorizontalAlignment="Left"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <Grid Margin="1,8,1,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                            <Grid Grid.Column="1" Width="15" Height="15">
                                                                <Ellipse Style="{StaticResource ThemeCheckRingStyle}" Visibility="{Binding IsSelected, Converter={StaticResource InverseBoolToVisConverter}}"/>
                                                                <Ellipse Fill="{DynamicResource AccentPrimaryBrush}" Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisConverter}}"/>
                                                                <Path Data="M 3,8 L 6.5,11.5 L 13,4" Stroke="{DynamicResource TextInverse}" StrokeThickness="2"
                                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                                      Width="9" Height="9" Stretch="Uniform"
                                                                      Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisConverter}}"/>
                                                            </Grid>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- RIGHT COLUMN: Custom Colors + Fonts & Styles -->
                        <StackPanel Grid.Column="2">
                            <!-- Custom colors card -->
                            <TextBlock Text="CUSTOM COLORS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="2,0,0,10"/>
                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="18,16" Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="Customize your own colors. Selecting any theme or background preset immediately overrides these."
                                               FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                                    <!-- Accent Color Picker -->
                                    <Border Background="{DynamicResource BackgroundTertiary}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="14" Margin="0,0,0,12">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Accent color" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="Buttons, highlights &amp; links" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Reset to theme" Command="{Binding ResetCustomAccentColorCommand}"
                                                        Style="{DynamicResource GhostButton}" FontSize="11" Padding="8,4" VerticalAlignment="Center"
                                                        ToolTip="Reset accent color override to active theme preset" AutomationProperties.Name="Reset accent color override to active theme preset"/>
                                            </Grid>
                                            <controls:ColorPickerControl SelectedColor="{Binding CustomAccentColorHex, Mode=TwoWay}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Background Color Picker -->
                                    <Border Background="{DynamicResource BackgroundTertiary}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="14" Margin="0,0,0,12">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Background color" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="Windows, panels &amp; surfaces" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Reset to theme" Command="{Binding ResetCustomBackgroundColorCommand}"
                                                        Style="{DynamicResource GhostButton}" FontSize="11" Padding="8,4" VerticalAlignment="Center"
                                                        ToolTip="Reset background override to active background preset" AutomationProperties.Name="Reset background override to active background preset"/>
                                            </Grid>
                                            <controls:ColorPickerControl SelectedColor="{Binding CustomBackgroundColorHex, Mode=TwoWay}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Font / Text Color Picker -->
                                    <Border Background="{DynamicResource BackgroundTertiary}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="14">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Font / text color" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="Primary text color" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Reset to theme" Command="{Binding ResetCustomFontColorCommand}"
                                                        Style="{DynamicResource GhostButton}" FontSize="11" Padding="8,4" VerticalAlignment="Center"
                                                        ToolTip="Reset text color override to active theme preset" AutomationProperties.Name="Reset text color override to active theme preset"/>
                                            </Grid>
                                            <controls:ColorPickerControl SelectedColor="{Binding CustomFontColorHex, Mode=TwoWay}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Fonts & styles: app font family + global weight/style -->
                            <TextBlock Text="FONTS &amp; STYLES" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="2,0,0,10"/>
                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="18,16" Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="Choose the app font family and global typography style."
                                               FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,14"/>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Font family" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                                            <ComboBox ItemsSource="{Binding AvailableFontFamilies}"
                                                      SelectedItem="{Binding SelectedFontFamily, Mode=TwoWay}"
                                                      Height="30" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Style" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                                            <ComboBox ItemsSource="{Binding AvailableFontStyles}"
                                                      SelectedItem="{Binding SelectedFontStyle, Mode=TwoWay}"
                                                      DisplayMemberPath="Label" Height="30" FontSize="12"
                                                      MinWidth="110"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4" VerticalAlignment="Bottom" Margin="0,0,0,7">
                                            <Button Content="Reset fonts" Command="{Binding ResetTypographyCommand}"
                                                    Style="{DynamicResource GhostButton}" FontSize="11" Padding="10,5"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border Background="{DynamicResource BackgroundTertiary}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="14,12">
                                        <StackPanel>
                                            <TextBlock Text="PREVIEW" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                                            <TextBlock Text="The quick brown fox jumps over the lazy dog" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                            <TextBlock Text="0123456789 · Klydis Desktop · ABCDEFGHIJKLMNOPQRSTUVWXYZ" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Model Settings section -->
                <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource RoleToVisibilityConverter}, ConverterParameter=ModelSettings}">
                    <TextBlock Text="Model Settings" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="Configure output personality styles and model generation directives." FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,24"/>

                    <!-- Model Personality: a card to select personality mode loaded from user style.md / UserStyle_Modes.md -->
                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="16,14" Margin="0,0,0,20">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                                    <Path Data="M 8,2 A 4,4 0 1 1 8,10 A 4,4 0 0 1 8,2 Z M 2,15 C 2,11.5 5,11 8,11 C 11,11 14,11.5 14,15 Z"
                                          Fill="{DynamicResource AccentPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,12,0">
                                    <TextBlock Text="Model Personality &amp; User Style" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Set model output tone &amp; personality loaded from user style.md" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ComboBox ItemsSource="{Binding AvailablePersonalities}"
                                              SelectedItem="{Binding SelectedPersonality, Mode=TwoWay}"
                                              Width="190" Height="30"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0"/>
                                    <Button Content="Reload"
                                            Command="{Binding RefreshPersonalitiesCommand}"
                                            ToolTip="Reload user style modes from disk"
                                            Padding="10,5"
                                            FontSize="11.5"
                                            Background="{DynamicResource SurfaceHoverBrush}"
                                            Foreground="{DynamicResource TextPrimaryBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            VerticalAlignment="Center" AutomationProperties.Name="Reload user style modes from disk"/>
                                </StackPanel>
                            </Grid>

                            <!-- Active Personality Directives Preview -->
                            <Border Margin="0,12,0,0" Padding="12,10" Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="ACTIVE PERSONALITY DIRECTIVES PREVIEW" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                                    <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                                        <TextBlock Text="{Binding SelectedPersonalityDescription}" 
                                                   FontSize="11.5" 
                                                   FontFamily="Consolas, Segoe UI, sans-serif" 
                                                   Foreground="{DynamicResource TextSecondaryBrush}" 
                                                   TextWrapping="Wrap" 
                                                   LineHeight="17"/>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Model Context Window Limit Slider card -->
                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="18,16" Margin="0,0,0,20">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                                    <Path Data="M 2,4 L 14,4 M 2,8 L 14,8 M 2,12 L 14,12 M 6,2 L 6,6 M 10,6 L 10,10 M 4,10 L 4,14"
                                          Stroke="{DynamicResource AccentPrimaryBrush}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,12,0">
                                    <TextBlock Text="Model Context Window Limit" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Configure maximum token context limit for LLM generation (1K to 1 Million tokens or Auto)." FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                                <Border Grid.Column="2" Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedContextSizeFormatted}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                </Border>
                            </Grid>

                            <!-- Slider control snapping to discrete token buckets (0=Auto, 1K, 2K, 4K, 8K, 16K, 32K, 64K, 128K, 256K, 512K, 1M) -->
                            <Slider Minimum="0"
                                    Maximum="11"
                                    SmallChange="1"
                                    LargeChange="1"
                                    TickFrequency="1"
                                    TickPlacement="BottomRight"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding ContextSliderIndex, Mode=TwoWay}"
                                    Margin="0,6,0,4"/>

                             <!-- Bucket labels below slider mathematically aligned to 12 slider ticks (0=Auto to 11=1M) -->
                            <Grid Margin="6,4,6,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Tick 0: Auto -->
                                <TextBlock Grid.Column="0" Text="Auto" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Left"/>
                                <!-- Tick 1: 1K -->
                                <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Text="1K" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                <!-- Tick 2: 2K -->
                                <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Text="2K" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                <!-- Tick 3: 4K -->
                                <TextBlock Grid.Column="2" Grid.ColumnSpan="2" Text="4K" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                <!-- Tick 4: 8K -->
                                <TextBlock Grid.Column="3" Grid.ColumnSpan="2" Text="8K" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                <!-- Tick 5: 16K -->
                                <TextBlock Grid.Column="4" Grid.ColumnSpan="2" Text="16K" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                <!-- Tick 6: 32K -->
                                <TextBlock Grid.Column="5" Grid.ColumnSpan="2" Text="32K" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                <!-- Tick 7: 64K -->
                                <TextBlock Grid.Column="6" Grid.ColumnSpan="2" Text="64K" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                <!-- Tick 8: 128K -->
                                <TextBlock Grid.Column="7" Grid.ColumnSpan="2" Text="128K" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                <!-- Tick 9: 256K -->
                                <TextBlock Grid.Column="8" Grid.ColumnSpan="2" Text="256K" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                <!-- Tick 10: 512K -->
                                <TextBlock Grid.Column="9" Grid.ColumnSpan="2" Text="512K" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                <!-- Tick 11: 1M -->
                                <TextBlock Grid.Column="10" Text="1M" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Batch Processing Size & Micro-Batching card -->
                    <TextBlock Text="BATCH PROCESSING &amp; HARDWARE THROUGHPUT" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="2,0,0,10"/>
                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="20" Margin="0,0,0,20">
                        <StackPanel>
                            <!-- Logical Batch Size -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="260"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Logical Batch Processing Size" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Maximum batch size evaluated simultaneously during prompt prefill (higher values increase prefill speed)." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,2,16,0"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding AvailableBatchSizes}"
                                          SelectedValue="{Binding SelectedBatchSize, Mode=TwoWay}"
                                          SelectedValuePath="Value"
                                          DisplayMemberPath="DisplayName"
                                          VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Physical Micro-Batch Size (UBatch) -->
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="260"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Micro-Batch Size (UBatch)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Physical micro-batch size dispatched to GPU Tensor Cores per step (512 tokens recommended for peak GPU throughput)." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,2,16,0"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding AvailableUBatchSizes}"
                                          SelectedValue="{Binding SelectedUBatchSize, Mode=TwoWay}"
                                          SelectedValuePath="Value"
                                          DisplayMemberPath="DisplayName"
                                          VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Speculative Decoding & Acceleration card -->
                    <TextBlock Text="SPECULATIVE DECODING &amp; ACCELERATION" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="2,0,0,10"/>
                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="20" Margin="0,0,0,20">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Enable Speculative Decoding" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Uses a smaller installed draft model (or dual-stream instance) to speculate tokens ahead for up to 5x-10x throughput." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,4,16,0"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" IsChecked="{Binding IsSpeculativeDecodingEnabled}" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="220"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Speculative Draft Model" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Select 'Auto' to dynamically use the smallest installed model, or select a specific local model." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,2,16,0"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding AvailableDraftModels}"
                                          SelectedValue="{Binding SelectedDraftModelPath, Mode=TwoWay}"
                                          SelectedValuePath="FilePath"
                                          DisplayMemberPath="DisplayName"
                                          VerticalAlignment="Center"/>
                            </Grid>

                            <Border Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="8" Padding="12,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Resolution &amp; Status:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding SpeculativeStatusMessage}" FontSize="12.5" Foreground="{DynamicResource AccentPrimaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Draft Token Speculation Count" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Number of candidate tokens speculated per step (higher value increases throughput on fast GPU draft models)." FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Slider Minimum="4" Maximum="32" TickFrequency="2" IsSnapToTickEnabled="True" Value="{Binding SpeculativeDraftCount}" Width="140" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Text="{Binding SpeculativeDraftCount, StringFormat='{}{0} tokens'}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Width="70" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- About section -->
                <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource RoleToVisibilityConverter}, ConverterParameter=About}">
                    <TextBlock Text="About" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="Information about this Klydis install." FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,24"/>

                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="20">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}">
                                    <TextBlock Text="K" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock Text="Klydis" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding AppVersion, StringFormat='Version {0}'}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="{Binding AppDescription}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
