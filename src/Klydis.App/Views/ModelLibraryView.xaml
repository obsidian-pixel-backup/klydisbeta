<UserControl x:Class="Klydis.App.Views.ModelLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:Klydis.App.ViewModels"
             xmlns:mdxam="clr-namespace:MdXaml;assembly=MdXaml"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1280">

    <UserControl.Resources>
        <!-- Icon set. These replace emoji glyphs, which rendered as flat monochrome
             text-presentation characters, clashed with the vector Path icons used in the
             navigation rail, and resolved through whatever font the user selected in
             Settings. Drawn on a 16x16 grid in the same thin-stroke style as the rail. -->
        <Geometry x:Key="IconCache">M2,5 L8,2 L14,5 L14,12 L8,15 L2,12 Z M2,5 L8,8 L14,5 M8,8 L8,15</Geometry>
        <Geometry x:Key="IconLocal">M2,4 L14,4 L14,12 L2,12 Z M2,8.5 L14,8.5 M4.2,10.4 L5.4,10.4</Geometry>
        <Geometry x:Key="IconVram">M3,5 L13,5 L13,11 L3,11 Z M5.5,11 L5.5,13 M10.5,11 L10.5,13</Geometry>
        <Geometry x:Key="IconRam">M2,5 L14,5 L14,11 L2,11 Z M5,5 L5,11 M8,5 L8,11 M11,5 L11,11</Geometry>
        <Geometry x:Key="IconCpu">M4.5,4.5 L11.5,4.5 L11.5,11.5 L4.5,11.5 Z M6.8,6.8 L9.2,6.8 L9.2,9.2 L6.8,9.2 Z M6.5,4.5 L6.5,2.5 M9.5,4.5 L9.5,2.5 M6.5,11.5 L6.5,13.5 M9.5,11.5 L9.5,13.5 M4.5,6.5 L2.5,6.5 M4.5,9.5 L2.5,9.5 M11.5,6.5 L13.5,6.5 M11.5,9.5 L13.5,9.5</Geometry>
        <Geometry x:Key="IconSearch">M7,2.2 A4.8,4.8 0 1 1 6.99,2.2 Z M10.6,10.6 L14,14</Geometry>
        <Geometry x:Key="IconRefresh">M13.2,8 A5.2,5.2 0 1 1 11.4,4.1 M11.4,4.1 L13.9,3.4 M11.4,4.1 L12.2,6.6</Geometry>
        <Geometry x:Key="IconHeart">M8,13.4 C3.2,10 1.7,7.5 2.7,5.3 C3.6,3.4 6.1,3.4 8,5.6 C9.9,3.4 12.4,3.4 13.3,5.3 C14.3,7.5 12.8,10 8,13.4 Z</Geometry>
        <Geometry x:Key="IconDownload">M8,2.5 L8,10 M5.2,7.4 L8,10.4 L10.8,7.4 M3,13.2 L13,13.2</Geometry>
        <Geometry x:Key="IconExternal">M6.2,3 L13,3 L13,9.8 M13,3 L6.6,9.4</Geometry>
        <Geometry x:Key="IconClock">M8,1.6 A6.4,6.4 0 1 1 7.99,1.6 Z M8,4.6 L8,8.2 L11,9.7</Geometry>
        <Geometry x:Key="IconCalendar">M2.6,4 L13.4,4 L13.4,13.6 L2.6,13.6 Z M2.6,7 L13.4,7 M5.6,2.4 L5.6,5.4 M10.4,2.4 L10.4,5.4</Geometry>
        <Geometry x:Key="IconParams">M3,5.2 L13,5.2 M3,10.8 L13,10.8 M6.2,3.2 L6.2,7.2 M10.2,8.8 L10.2,12.8</Geometry>
        <Geometry x:Key="IconArchitecture">M8,2 L14,5.4 L8,8.8 L2,5.4 Z M2,9.2 L8,12.6 L14,9.2</Geometry>
        <Geometry x:Key="IconContext">M5.2,3.8 L2.2,8 L5.2,12.2 M10.8,3.8 L13.8,8 L10.8,12.2</Geometry>
        <Geometry x:Key="IconLicense">M4,2.2 L10,2.2 L13,5.2 L13,13.8 L4,13.8 Z M10,2.2 L10,5.2 L13,5.2 M6.2,10.6 L10.8,10.6</Geometry>

        <Style x:Key="PillIconStyle" TargetType="Path">
            <Setter Property="Width" Value="11"/>
            <Setter Property="Height" Value="11"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="StrokeThickness" Value="1.3"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <!-- Model List Item Row Container Style -->
        <Style x:Key="ModelHubRowStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Segmented Tab Button Style -->
        <Style x:Key="SegmentedTabButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{DynamicResource KlydisFocusVisual}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Metadata Pill Badge Style -->
        <Style x:Key="MetaPillStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
        </Style>

        <!-- Top Header Status Badge Style -->
        <Style x:Key="HeaderStatusBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}" Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Row 0: Top Header & Telemetry -->
            <RowDefinition Height="Auto"/> <!-- Row 1: Segmented Tabs, Search & Filters -->
            <RowDefinition Height="*"/>    <!-- Row 2: Master-Detail Split Content -->
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- ROW 0: TOP HEADER BAR                                                     -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left: Title & Subtitle -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Model hub" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Discover, download, and run inference models locally." FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />
            </StackPanel>

            <!-- Right: System Telemetry Chips -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Protocol Capsule -->
                <Border Style="{StaticResource HeaderStatusBadgeStyle}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="#EF4444" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Auto" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,6,0"/>
                        <TextBlock Text="HTTP" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,6,0"/>
                        <TextBlock Text="Xet" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Cache count badge -->
                <Border Style="{StaticResource HeaderStatusBadgeStyle}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Style="{StaticResource PillIconStyle}" Data="{StaticResource IconCache}"/>
                        <TextBlock Text="{Binding CacheCountText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Local count badge -->
                <Border Style="{StaticResource HeaderStatusBadgeStyle}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Style="{StaticResource PillIconStyle}" Data="{StaticResource IconLocal}"/>
                        <TextBlock Text="{Binding LocalCountText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- VRAM badge -->
                <Border Style="{StaticResource HeaderStatusBadgeStyle}" ToolTip="Detected GPU VRAM Capacity">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Style="{StaticResource PillIconStyle}" Data="{StaticResource IconVram}"/>
                        <TextBlock Text="{Binding VramBadgeText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- RAM badge -->
                <Border Style="{StaticResource HeaderStatusBadgeStyle}" ToolTip="System RAM Capacity">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Style="{StaticResource PillIconStyle}" Data="{StaticResource IconRam}"/>
                        <TextBlock Text="{Binding RamBadgeText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- CPU badge -->
                <Border Style="{StaticResource HeaderStatusBadgeStyle}" ToolTip="CPU Cores &amp; Logical Threads">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Style="{StaticResource PillIconStyle}" Data="{StaticResource IconCpu}"/>
                        <TextBlock Text="{Binding CpuBadgeText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ========================================================================= -->
        <!-- ROW 1: TABS, SEARCH & FILTER TOOLBAR                                     -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/> <!-- Segmented Tabs -->
                <ColumnDefinition Width="*"/>    <!-- Search Box -->
                <ColumnDefinition Width="Auto"/> <!-- Filter Dropdowns -->
            </Grid.ColumnDefinitions>

            <!-- Segmented Switcher: [ Discover ] [ On Device ] -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="3" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Discover" Command="{Binding SelectDiscoverTabCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SegmentedTabButtonStyle}">
                                <Setter Property="FocusVisualStyle" Value="{DynamicResource KlydisFocusVisual}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedHubTab}" Value="Discover">
                                        <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="On Device" Command="{Binding SelectOnDeviceTabCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SegmentedTabButtonStyle}">
                                <Setter Property="FocusVisualStyle" Value="{DynamicResource KlydisFocusVisual}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedHubTab}" Value="OnDevice">
                                        <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Center: Search Box -->
            <Border Grid.Column="1" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Height="36" Margin="14,0,14,0" VerticalAlignment="Center">
                <Grid Margin="10,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Path Grid.Column="0" Style="{StaticResource PillIconStyle}" Data="{StaticResource IconSearch}" Width="13" Height="13" Margin="0,0,8,0"/>

                    <TextBox Grid.Column="1" AutomationProperties.Name="Search all models" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged, Delay=250}" 
                             Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}"
                             VerticalContentAlignment="Center" FontSize="13"
                             Tag="Search all models" />

                    <!-- Search Watermark Placeholder -->
                    <TextBlock Grid.Column="1" Text="Search all models" Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False" FontSize="13"
                               Visibility="{Binding SearchQuery, Converter={StaticResource StringEmptyToVisibilityConverter}}"/>

                    <Button Grid.Column="2" Content="✕" Command="{Binding ClearFiltersCommand}" Style="{StaticResource GhostButton}"
                            Padding="4,2" FontSize="10" VerticalAlignment="Center"
                            Visibility="{Binding SearchQuery, Converter={StaticResource StringToVisibilityConverter}}"/>
                </Grid>
            </Border>

            <!-- Right: Filters & Tools -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Format Filter Dropdown -->
                <ComboBox AutomationProperties.Name="Model format filter" ItemsSource="{Binding AvailableFormatFilters}" SelectedItem="{Binding SelectedFormatFilter}" Width="100" Height="34" Margin="0,0,8,0" VerticalContentAlignment="Center" />

                <!-- Capabilities Filter Dropdown -->
                <ComboBox AutomationProperties.Name="Capability filter" ItemsSource="{Binding AvailableCapabilityFilters}" SelectedItem="{Binding SelectedCapabilityFilter}" Width="145" Height="34" Margin="0,0,8,0" VerticalContentAlignment="Center" />

                <!-- Sort Filter Dropdown -->
                <ComboBox AutomationProperties.Name="Sort order" ItemsSource="{Binding AvailableSortFilters}" SelectedItem="{Binding SelectedSortFilter}" Width="145" Height="34" Margin="0,0,8,0" VerticalContentAlignment="Center" />

                <!-- Refresh / Scan Button -->
                <Button Command="{Binding ScanCommand}" ToolTip="Scan &amp; Refresh Model Hub" Style="{StaticResource GhostButton}" Width="34" Height="34" Margin="0,0,4,0" AutomationProperties.Name="Scan and Refresh Model Hub">
                    <Path Style="{StaticResource PillIconStyle}" Data="{StaticResource IconRefresh}" Width="13" Height="13" Margin="0" HorizontalAlignment="Center"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ========================================================================= -->
        <!-- ROW 2: MASTER-DETAIL SPLIT VIEW                                           -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="300" MaxWidth="500"/> <!-- Master Column -->
                <ColumnDefinition Width="16"/>                                 <!-- Gap Spacer -->
                <ColumnDefinition Width="*"/>                                   <!-- Detail Column -->
            </Grid.ColumnDefinitions>

            <!-- ========================================== -->
            <!-- LEFT PANEL: MODEL LIST                     -->
            <!-- ========================================== -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header inside list -->
                    <RowDefinition Height="Auto"/> <!-- Active Downloads Banner -->
                    <RowDefinition Height="*"/>    <!-- Scrollable Model List -->
                </Grid.RowDefinitions>

                <!-- List Header: < Models | Category Filter -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&lt; Models" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <ComboBox AutomationProperties.Name="Category filter" ItemsSource="{Binding AvailableCategoryFilters}" SelectedItem="{Binding SelectedCategoryFilter}" Width="85" Height="28" FontSize="11" Margin="0,0,8,0" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Active Downloads Tray Card -->
                <Border Grid.Row="1" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8"
                        Visibility="{Binding HasActiveDownloads, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="⚡ Active Downloads" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding ActiveDownloads}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type viewmodels:ActiveDownloadViewModel}">
                                    <Grid Margin="0,2,0,6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- The file name is fixed for the life of the row. Keeping it out of the
                                             volatile status string means this line is laid out once instead of being
                                             re-rendered on every progress tick. -->
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding FileName}" FontSize="10.5" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding FileName}"/>
                                        <Button Grid.Row="0" Grid.Column="1" Content="✕" Command="{Binding CancelCommand}" Style="{StaticResource GhostButton}" Foreground="{DynamicResource ErrorBrush}" Padding="4,0" FontSize="10" ToolTip="Cancel download" AutomationProperties.Name="Cancel download"/>
                                        <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Minimum="0" Maximum="100" Value="{Binding Progress}" Height="4" Margin="0,4,0,0" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                        <!-- Counters change every tick, so they sit alone on their own line over an
                                             opaque background: a stale glyph run cannot bleed through from beneath. -->
                                        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Status}" FontSize="10" Margin="0,3,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Background="{DynamicResource SurfaceElevatedBrush}" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Model List Items -->
                <ListBox Grid.Row="2" ItemsSource="{Binding HubItems}" SelectedItem="{Binding SelectedHubItem, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <!-- Without this the row falls back to object.ToString() and every
                                 model in the list announces "ModelHubItemViewModel". -->
                            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{DynamicResource KlydisFocusVisual}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewmodels:ModelHubItemViewModel}">
                            <Border Style="{StaticResource ModelHubRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" /> <!-- Avatar -->
                                        <ColumnDefinition Width="*" />    <!-- Name & Author -->
                                        <ColumnDefinition Width="Auto" /> <!-- Stats & Date -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Author / Brand Avatar Box -->
                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6" VerticalAlignment="Center" Margin="0,0,10,0"
                                            Background="{Binding AvatarBackground, Converter={StaticResource StringToBrushConverter}}">
                                        <TextBlock Text="{Binding AvatarLetter}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextInverse}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Model Name & Author -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding ModelName}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="190" ToolTip="{Binding ModelName}"/>
                                            <!-- Dot Indicator -->
                                            <Ellipse Width="6" Height="6" Margin="6,0,0,0" VerticalAlignment="Center"
                                                     Fill="{Binding DotColor, Converter={StaticResource StringToBrushConverter}}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Author}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <!-- Stats & Time Ago -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Path Style="{StaticResource PillIconStyle}" Data="{StaticResource IconHeart}" Width="9" Height="9" Margin="0,0,3,0"/>
                                            <TextBlock Text="{Binding Likes, Converter={StaticResource CountToFormattedStringConverter}}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                                            <Path Style="{StaticResource PillIconStyle}" Data="{StaticResource IconDownload}" Width="9" Height="9" Margin="0,0,3,0"/>
                                            <TextBlock Text="{Binding Downloads, Converter={StaticResource CountToFormattedStringConverter}}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding TimeAgo}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Empty State for Master List -->
                <!-- Sits in the list row, not the downloads-banner row above it, so it cannot paint
                     over an active download. The Style/DataTrigger that used to be here was dead:
                     a local Visibility value always outranks a Style trigger. -->
                <TextBlock Grid.Row="2" Text="No models found matching your search or filters."
                           Foreground="{DynamicResource TextSecondaryBrush}" FontStyle="Italic"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="16,0"
                           Visibility="{Binding HubItems.Count, Converter={StaticResource ZeroToCollapsedConverter}, ConverterParameter=Inverse}"/>
            </Grid>

            <!-- ========================================== -->
            <!-- RIGHT PANEL: MODEL DETAILS & README        -->
            <!-- ========================================== -->
            <Border Grid.Column="2" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20">
                <Grid>
                    <!-- Detail Content (when a model is selected) -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding SelectedHubItem, Converter={StaticResource NullToVisibilityConverter}}">
                        <StackPanel>
                            <!-- 1. Header Box: Avatar, Title, External Link, Author, Capability Pills -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Large Avatar -->
                                <Border Grid.Column="0" Width="52" Height="52" CornerRadius="10" Margin="0,0,16,0" VerticalAlignment="Top"
                                        Background="{Binding SelectedHubItem.AvatarBackground, Converter={StaticResource StringToBrushConverter}}">
                                    <TextBlock Text="{Binding SelectedHubItem.AvatarLetter}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextInverse}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Title, Author, Tags -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedHubItem.ModelName}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        <Button Command="{Binding OpenHfPageCommand}" CommandParameter="{Binding SelectedHubItem.RepoId}" Style="{StaticResource GhostButton}" ToolTip="Open repository on Hugging Face" Margin="6,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="Open repository on Hugging Face">
                                            <Path Style="{StaticResource PillIconStyle}" Data="{StaticResource IconExternal}" Width="13" Height="13" Margin="0" Stroke="{DynamicResource AccentPrimaryBrush}" StrokeThickness="1.6"/>
                                        </Button>
                                    </StackPanel>

                                    <TextBlock Text="{Binding SelectedHubItem.Author}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,8"/>

                                    <!-- Capability Tag Pills -->
                                    <ItemsControl ItemsSource="{Binding SelectedHubItem.Capabilities}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10,3" Margin="0,0,6,4">
                                                    <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>

                            <!-- 2. Quantization Selector & Action Bar -->
                            <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Quant Selection Pill -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- When GGUF Files are available -->
                                        <ComboBox AutomationProperties.Name="Quantisation file" ItemsSource="{Binding SelectedHubItem.GgufFiles}" SelectedItem="{Binding SelectedHubItem.SelectedFile}" 
                                                  MinWidth="240" Height="34" VerticalContentAlignment="Center"
                                                  Visibility="{Binding SelectedHubItem.GgufFiles.Count, Converter={StaticResource ZeroToCollapsedConverter}}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate DataType="{x:Type viewmodels:HfFileViewModel}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse Width="7" Height="7" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding QuantType}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,6,0"/>
                                                        <TextBlock Text="• GGUF" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                                                        <TextBlock Text="{Binding Size}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                                                        <TextBlock Text="⚠ Exceeds VRAM" FontSize="10" Foreground="{DynamicResource ErrorBrush}" VerticalAlignment="Center" 
                                                                   Visibility="{Binding CanFitInVram, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <!-- When Files are Loading -->
                                        <StackPanel Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding SelectedHubItem.IsLoadingFiles, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <ProgressBar IsIndeterminate="True" Width="80" Height="4" Margin="0,0,8,0" Foreground="{DynamicResource AccentPrimaryBrush}" Background="{DynamicResource BackgroundTertiary}" VerticalAlignment="Center"/>
                                            <TextBlock Text="Fetching available files..." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Right: Action Buttons (Download / Load / Delete / Role) -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Discover Mode: Download Button -->
                                        <Button Content="⬇ Download" Command="{Binding DownloadSelectedModelCommand}" Style="{StaticResource PrimaryButton}" Padding="18,7"
                                                Visibility="{Binding SelectedHubItem.IsLocal, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

                                        <!-- On-Device Mode: Role Allocation -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0"
                                                    Visibility="{Binding SelectedHubItem.IsLocal, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="Role:" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <ComboBox AutomationProperties.Name="Model role" ItemsSource="{Binding AvailableRoleFilters}" SelectedItem="{Binding SelectedHubItem.Role}" Width="110" Height="32"/>
                                        </StackPanel>

                                        <!-- On-Device Mode: Load / Unload Buttons -->
                                        <Button Content="▶ Load" Command="{Binding LoadSelectedModelCommand}" Padding="16,7" Margin="0,0,8,0">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                    <Setter Property="FocusVisualStyle" Value="{DynamicResource KlydisFocusVisual}"/>
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding SelectedHubItem.IsLocal}" Value="True"/>
                                                                <Condition Binding="{Binding SelectedHubItem.IsLoaded}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <Button Content="⏹ Unload" Command="{Binding UnloadSelectedModelCommand}" Padding="16,7" Margin="0,0,8,0">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                    <Setter Property="FocusVisualStyle" Value="{DynamicResource KlydisFocusVisual}"/>
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding SelectedHubItem.IsLocal}" Value="True"/>
                                                                <Condition Binding="{Binding SelectedHubItem.IsLoaded}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <!-- On-Device Mode: Delete Button -->
                                        <Button Content="🗑 Delete" Command="{Binding DeleteSelectedModelCommand}" Style="{StaticResource SecondaryButton}" Padding="12,7" Foreground="{DynamicResource ErrorBrush}"
                                                Visibility="{Binding SelectedHubItem.IsLocal, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Active Download Progress Indicator -->
                            <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16"
                                    Visibility="{Binding SelectedHubItem.IsDownloading, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="{Binding SelectedHubItem.DownloadStatus}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="12"/>
                                    </Grid>
                                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding SelectedHubItem.DownloadProgress}" Height="8" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- 3. Metadata Chips Bar: TimeAgo, Release Date, Downloads, Likes, Params, Arch, Context, License -->
                            <WrapPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Border Style="{StaticResource MetaPillStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource PillIconStyle}" Data="{StaticResource IconClock}"/>
                                        <TextBlock Text="{Binding SelectedHubItem.TimeAgo}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource MetaPillStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource PillIconStyle}" Data="{StaticResource IconCalendar}"/>
                                        <TextBlock Text="{Binding SelectedHubItem.ReleaseDate}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource MetaPillStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource PillIconStyle}" Data="{StaticResource IconDownload}"/>
                                        <TextBlock Text="{Binding SelectedHubItem.Downloads, Converter={StaticResource CountToFormattedStringConverter}}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource MetaPillStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource PillIconStyle}" Data="{StaticResource IconHeart}"/>
                                        <TextBlock Text="{Binding SelectedHubItem.Likes, Converter={StaticResource CountToFormattedStringConverter}}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource MetaPillStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource PillIconStyle}" Data="{StaticResource IconParams}"/>
                                        <TextBlock Text="{Binding SelectedHubItem.ParameterSize}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource MetaPillStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource PillIconStyle}" Data="{StaticResource IconArchitecture}"/>
                                        <TextBlock Text="{Binding SelectedHubItem.Architecture}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource MetaPillStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource PillIconStyle}" Data="{StaticResource IconContext}"/>
                                        <TextBlock Text="{Binding SelectedHubItem.ContextLength}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource MetaPillStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource PillIconStyle}" Data="{StaticResource IconLicense}"/>
                                        <TextBlock Text="{Binding SelectedHubItem.License}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <!-- Divider line -->
                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,16"/>

                            <!-- 4. Model Readme / Description Markdown Content -->
                            <StackPanel>
                                <!-- Loading Readme spinner -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,20"
                                            Visibility="{Binding SelectedHubItem.IsLoadingReadme, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ProgressBar IsIndeterminate="True" Width="80" Height="4" Margin="0,0,10,0" Foreground="{DynamicResource AccentPrimaryBrush}" Background="{DynamicResource BackgroundTertiary}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Loading model card documentation..." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Markdown Viewer -->
                                <mdxam:MarkdownScrollViewer Markdown="{Binding SelectedHubItem.ReadmeMarkdown}" Loaded="MarkdownViewer_Loaded" Background="Transparent" BorderThickness="0"
                                                            ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Empty Placeholder State (when no model is selected) -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding SelectedHubItem, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverse}">
                        <TextBlock Text="🤖" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Select a model from the list to view specifications and download files." FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
