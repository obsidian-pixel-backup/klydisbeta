<Window x:Class="Klydis.App.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Klydis"
        Width="540" Height="380"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        ShowInTaskbar="False"
        UseLayoutRounding="True">
    <Border BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="0,2,0,0">
        <Grid Margin="40,34,40,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Brand -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="KLYDIS" FontSize="42" FontWeight="Bold"
                           Foreground="{DynamicResource AccentPrimaryBrush}"
                           FontFamily="Segoe UI Variable Display, Segoe UI"/>
                <TextBlock Text="Desktop AI Orchestrator" FontSize="14" Margin="0,4,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>

            <!-- Status + progress -->
            <StackPanel Grid.Row="1" Margin="0,30,0,0">
                <TextBlock Text="{Binding StatusText}" FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis"/>
                <ProgressBar Height="4" Margin="0,12,0,0" BorderThickness="0"
                             Minimum="0" Maximum="1" Value="{Binding ProgressValue}"
                             Foreground="{DynamicResource AccentPrimaryBrush}"
                             Background="#264A5A60"/>
            </StackPanel>

            <!-- Startup phases -->
            <ItemsControl Grid.Row="2" Margin="0,22,0,0" ItemsSource="{Binding Phases}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="&#x2713;" FontSize="12"
                                       Foreground="{DynamicResource AccentPrimaryBrush}"
                                       VerticalAlignment="Center" Visibility="Collapsed" x:Name="DoneIcon"/>
                            <Ellipse Grid.Column="0" Width="8" Height="8" Fill="#3A4A52"
                                     HorizontalAlignment="Left" VerticalAlignment="Center" x:Name="StateDot"/>

                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" x:Name="PhaseName"/>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="1">
                                <Setter TargetName="StateDot" Property="Fill" Value="#50E8F4"/>
                                <Setter TargetName="PhaseName" Property="Foreground" Value="#C7F8FE"/>
                                <Setter TargetName="PhaseName" Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="2">
                                <Setter TargetName="StateDot" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="DoneIcon" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Grid.Row="3" Text="Klydis Beta" FontSize="11" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.55"/>
        </Grid>
    </Border>
</Window>
