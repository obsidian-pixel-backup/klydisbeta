<UserControl x:Class="Klydis.App.Views.RagView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:Klydis.App.Converters"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.Resources>
        <converters:StringEmptyToVisibilityConverter x:Key="StringEmptyToVisibilityConverter"/>

        <!-- Rounded action button matching the app's button language (PrimaryButton /
             SecondaryButton in ThemeStyles.xaml) but built locally so Background /
             Foreground / BorderBrush can be overridden per instance (accent vs. danger vs.
             neutral) without fighting a shared style's hover triggers. -->
        <Style x:Key="RoundedActionButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ======== Header ======== -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Database / index glyph -->
                    <Path Data="M 4 2 L 20 2 L 20 22 L 4 22 Z M 4 8 L 20 8 M 4 14 L 20 14 M 9 5 L 11 5 M 9 11 L 11 11"
                          Stroke="{DynamicResource AccentPrimaryBrush}" StrokeThickness="1.6" StrokeLineJoin="Round"
                          Width="24" Height="24" Stretch="Uniform" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="Vector RAG &amp; Workspace Indexer" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Index code, docs &amp; notes into local vector storage, then search it for grounded context."
                                   FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Live stats chips -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="7" Padding="12,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Workspaces  " FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding TotalIndexedDocuments}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="7" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Vector chunks  " FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding TotalVectorChunks}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======== Body ======== -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Left: Index a workspace ===== -->
            <Border Grid.Column="0" Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Path Data="M 4 5 L 10 5 L 12 7 L 20 7 L 20 19 L 4 19 Z" Stroke="{DynamicResource AccentPrimaryBrush}"
                                  StrokeThickness="1.6" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Index a workspace folder" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Folder path -->
                        <TextBlock Text="FOLDER PATH" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="FolderPathBox" Text="{Binding SelectedFolderPath, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="9,7" Background="{DynamicResource InputBackgroundBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                     BorderThickness="1" VerticalContentAlignment="Center"/>
                            <TextBlock Text="Choose a folder or paste a path…" IsHitTestVisible="False"
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                                       Margin="10,0,0,0" VerticalAlignment="Center"
                                       Visibility="{Binding SelectedFolderPath, Converter={StaticResource StringEmptyToVisibilityConverter}}"/>
                            <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseFolderCommand}"
                                    Style="{DynamicResource GhostButton}" FontSize="11.5" Padding="12,6" Margin="8,0,0,0"
                                    VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="Tip: pick a project folder — code, markdown, JSON and text files are indexed automatically."
                                   FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                        <!-- Collection name -->
                        <TextBlock Text="COLLECTION NAME" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <TextBox x:Name="CollectionNameBox" Text="{Binding CollectionName, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="9,7" Background="{DynamicResource InputBackgroundBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                 BorderThickness="1" VerticalContentAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="Defaults to the folder name." FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,16"/>

                        <!-- Actions -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="⚡  Start Indexing" Command="{Binding StartIndexingCommand}"
                                    IsEnabled="{Binding IsIndexing, Converter={StaticResource InverseBooleanConverter}}"
                                    Style="{StaticResource RoundedActionButtonStyle}" Padding="16,9"
                                    Background="{DynamicResource AccentPrimaryBrush}" Foreground="{DynamicResource TextInverse}" BorderThickness="0"/>
                            <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelIndexingCommand}"
                                    Visibility="{Binding IsIndexing, Converter={StaticResource BoolToVisConverter}}"
                                    Style="{StaticResource RoundedActionButtonStyle}" Padding="14,9" Margin="10,0,0,0"
                                    Background="{DynamicResource ErrorBrush}" Foreground="White" BorderThickness="0"/>
                        </Grid>

                        <!-- Progress -->
                        <StackPanel Visibility="{Binding IsIndexing, Converter={StaticResource BoolToVisConverter}}" Margin="0,0,0,16">
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="{Binding ProgressMessage}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding IndexingProgressPercentage, StringFormat={}{0:F0}%}" FontSize="11.5"
                                           FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                            <ProgressBar Value="{Binding IndexingProgressPercentage, Mode=OneWay}" Maximum="100" Height="6"
                                         Foreground="{DynamicResource AccentPrimaryBrush}" Background="{DynamicResource InputBackgroundBrush}"
                                         BorderThickness="0"/>
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,16"/>

                        <!-- Indexed workspaces -->
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="INDEXED WORKSPACES" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding TotalIndexedDocuments}" FontSize="10.5" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentPrimaryBrush}" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Empty state -->
                        <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="7" Padding="14,12" Margin="0,0,0,10"
                                Visibility="{Binding HasCollections, Converter={StaticResource InverseBoolToVisConverter}}">
                            <StackPanel>
                                <TextBlock Text="No workspaces indexed yet" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,3"/>
                                <TextBlock Text="Pick a folder above and click Start Indexing — the app will embed your files into local vector storage you can search from the panel on the right."
                                           FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding Collections}" Visibility="{Binding HasCollections, Converter={StaticResource BoolToVisConverter}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="7" Padding="11,9" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="4"
                                                            Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding EmbeddingModel}" FontSize="9.5"
                                                                   Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding FolderPath}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Command="{Binding DataContext.DeleteCollectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Content="🗑" FontSize="12"
                                                    Style="{DynamicResource GhostButton}" Foreground="{DynamicResource ErrorBrush}"
                                                    Padding="7,4" VerticalAlignment="Center" ToolTip="Delete this workspace index"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ===== Right: Search indexed content ===== -->
            <Border Grid.Column="2" Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Path Data="M 10 3 A 7 7 0 1 1 10 17 A 7 7 0 0 1 10 3 Z M 15.5 15.5 L 21 21"
                              Stroke="{DynamicResource AccentPrimaryBrush}" StrokeThickness="1.6" StrokeLineJoin="Round"
                              Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Search indexed content" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Query row: scope filter + query + search -->
                    <Grid Grid.Row="1" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0" ItemsSource="{Binding CollectionFilters}"
                                  SelectedItem="{Binding SelectedCollectionFilter, Mode=TwoWay}"
                                  DisplayMemberPath="Label" Height="34" VerticalContentAlignment="Center"
                                  Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                  BorderBrush="{DynamicResource BorderBrush}" ToolTip="Scope the search to one workspace or all of them"/>

                        <TextBox x:Name="SearchQueryBox" Grid.Column="2" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="9,7" Background="{DynamicResource InputBackgroundBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                 BorderThickness="1" VerticalContentAlignment="Center">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding PerformTestSearchCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="Ask anything about your indexed files…" IsHitTestVisible="False"
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="11,0,0,0"
                                   VerticalAlignment="Center" Grid.Column="2"
                                   Visibility="{Binding SearchQuery, Converter={StaticResource StringEmptyToVisibilityConverter}}"/>

                        <Button Grid.Column="3" Content="🔍  Search" Command="{Binding PerformTestSearchCommand}"
                                Style="{StaticResource RoundedActionButtonStyle}" Padding="16,9" Margin="8,0,0,0"
                                Background="{DynamicResource AccentPrimaryBrush}" Foreground="{DynamicResource TextInverse}" BorderThickness="0"/>
                    </Grid>

                    <!-- Results -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>

                        <!-- Empty state -->
                        <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="7" Padding="14,12"
                                Visibility="{Binding HasSearchResults, Converter={StaticResource InverseBoolToVisConverter}}">
                            <StackPanel>
                                <TextBlock Text="No search results yet" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,3"/>
                                <TextBlock Text="Type a question or keyword above and press Enter (or click Search) — matching context chunks from your indexed workspaces appear here with relevance scores."
                                           FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding SearchResults}" Visibility="{Binding HasSearchResults, Converter={StaticResource BoolToVisConverter}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,7">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="M 4 3 L 12 3 L 14 5 L 20 5 L 20 17 L 4 17 Z"
                                                          Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.4"
                                                          Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                    <TextBlock Text="{Binding Chunk.FileTitle}" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                        <TextBlock FontSize="10" Foreground="{DynamicResource AccentPrimaryBrush}">
                                                            <Run Text="RRF "/>
                                                            <Run Text="{Binding RrfScore, StringFormat={}{0:F3}}" FontWeight="Bold"/>
                                                        </TextBlock>
                                                    </Border>
                                                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="4" Padding="6,2">
                                                        <TextBlock FontSize="10" Foreground="{DynamicResource SuccessBrush}">
                                                            <Run Text="Dense "/>
                                                            <Run Text="{Binding DenseSimilarity, StringFormat={}{0:F2}}" FontWeight="Bold"/>
                                                        </TextBlock>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="{Binding Chunk.Content}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap" MaxHeight="110" TextTrimming="WordEllipsis"/>
                                            <TextBlock Text="{Binding Chunk.SourcePath}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                                                       Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ======== Status bar ======== -->
        <Border Grid.Row="2" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="16,8" Margin="0">
            <Grid>
                <TextBlock Text="{Binding ProgressMessage}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProgressMessage}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,16,0">
                        <Run Text="Indexed: "/>
                        <Run Text="{Binding TotalIndexedDocuments}" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                        <Run Text=" workspaces"/>
                    </TextBlock>
                    <TextBlock FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}">
                        <Run Text="Embedded: "/>
                        <Run Text="{Binding TotalVectorChunks}" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                        <Run Text=" chunks"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
