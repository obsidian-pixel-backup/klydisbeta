<UserControl x:Class="Klydis.App.Views.RagView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">
    
    <Border Background="#12141A" Padding="20">
    <Grid>
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Content Split: Indexer + Search Test -->
            <RowDefinition Height="*"/>
            <!-- Status Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Local Vector RAG &amp; Workspace Indexer" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF"/>
            <TextBlock Text="Index your local source code, markdown vaults, and documentation into microsecond SIMD vector storage for grounded LLM context." 
                       FontSize="13" Foreground="#94A3B8" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Content Grid -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Workspace Indexing Panel -->
            <Border Grid.Column="0" Background="#1E222D" CornerRadius="8" BorderBrush="#2E3445" BorderThickness="1" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Index New Workspace Folder" FontSize="16" FontWeight="SemiBold" Foreground="#60A5FA" Margin="0,0,0,12"/>

                        <!-- Folder Selection -->
                        <TextBlock Text="Folder Path" FontSize="12" Foreground="#CBD5E1" Margin="0,4,0,4"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding SelectedFolderPath, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="#0F1117" Foreground="#FFFFFF" BorderBrush="#334155" Padding="8,6" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Command="{Binding BrowseFolderCommand}" Content="Browse..." 
                                    Margin="8,0,0,0" Padding="12,6" Background="#3B82F6" Foreground="#FFFFFF" FontWeight="SemiBold" BorderThickness="0"/>
                        </Grid>

                        <!-- Collection Name -->
                        <TextBlock Text="Collection Name" FontSize="12" Foreground="#CBD5E1" Margin="0,4,0,4"/>
                        <TextBox Text="{Binding CollectionName, UpdateSourceTrigger=PropertyChanged}" 
                                 Background="#0F1117" Foreground="#FFFFFF" BorderBrush="#334155" Padding="8,6" Margin="0,0,0,16"/>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Button Command="{Binding StartIndexingCommand}" Content="⚡ Start Indexing" 
                                    IsEnabled="{Binding IsIndexing, Converter={StaticResource InverseBooleanConverter}}"
                                    Padding="16,8" Background="#10B981" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0"/>
                            <Button Command="{Binding CancelIndexingCommand}" Content="Cancel" 
                                    Visibility="{Binding IsIndexing, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Margin="10,0,0,0" Padding="12,8" Background="#EF4444" Foreground="#FFFFFF" FontWeight="SemiBold" BorderThickness="0"/>
                        </StackPanel>

                        <!-- Indexing Progress Bar -->
                        <ProgressBar Value="{Binding IndexingProgressPercentage, Mode=OneWay}" Maximum="100" Height="6" 
                                     Visibility="{Binding IsIndexing, Converter={StaticResource BooleanToVisibilityConverter}}"
                                     Foreground="#10B981" Background="#0F1117" BorderThickness="0" Margin="0,0,0,16"/>

                        <Separator Background="#2E3445" Margin="0,8,0,16"/>

                        <!-- Active Collections List -->
                        <TextBlock Text="Indexed Workspaces" FontSize="14" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding Collections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#171A23" BorderBrush="#2D3345" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#60A5FA"/>
                                                <TextBlock Text="{Binding FolderPath}" FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding EmbeddingModel}" FontSize="10" Foreground="#10B981" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Command="{Binding DataContext.DeleteCollectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Content="🗑️" Background="Transparent" Foreground="#EF4444" BorderThickness="0" Padding="6" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Right Panel: Live RAG Query Tester -->
            <Border Grid.Column="2" Background="#1E222D" CornerRadius="8" BorderBrush="#2E3445" BorderThickness="1" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Live Vector RRF Search Tester" FontSize="16" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,0,0,12"/>

                    <!-- Query Box -->
                    <Grid Grid.Row="1" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                 Background="#0F1117" Foreground="#FFFFFF" BorderBrush="#334155" Padding="10,8"/>
                        <Button Grid.Column="1" Command="{Binding PerformTestSearchCommand}" Content="🔍 Search" 
                                Margin="8,0,0,0" Padding="16,8" Background="#0EA5E9" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0"/>
                    </Grid>

                    <!-- Results List -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SearchResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#171A23" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <TextBlock Text="{Binding Chunk.FileTitle}" FontWeight="Bold" Foreground="#38BDF8" FontSize="13"/>
                                                <TextBlock HorizontalAlignment="Right" FontSize="11" Foreground="#10B981">
                                                    <Run Text="RRF Score: "/>
                                                    <Run Text="{Binding RrfScore, StringFormat={}{0:F4}}" FontWeight="Bold"/>
                                                    <Run Text=" | Dense Cosine: "/>
                                                    <Run Text="{Binding DenseSimilarity, StringFormat={}{0:F2}}"/>
                                                </TextBlock>
                                            </Grid>
                                            <TextBlock Text="{Binding Chunk.Content}" Foreground="#E2E8F0" FontSize="12" TextWrapping="Wrap" MaxHeight="120" TextTrimming="WordEllipsis"/>
                                            <TextBlock Text="{Binding Chunk.SourcePath}" Foreground="#475569" FontSize="10" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#1E222D" BorderBrush="#2E3445" BorderThickness="1" CornerRadius="4" Padding="12,6" Margin="0,16,0,0">
            <Grid>
                <TextBlock Text="{Binding ProgressMessage}" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Foreground="#CBD5E1" FontSize="12" Margin="0,0,15,0">
                        <Run Text="Workspaces: "/>
                        <Run Text="{Binding TotalIndexedDocuments}" FontWeight="Bold" Foreground="#60A5FA"/>
                    </TextBlock>
                    <TextBlock Foreground="#CBD5E1" FontSize="12">
                        <Run Text="Vector Chunks: "/>
                        <Run Text="{Binding TotalVectorChunks}" FontWeight="Bold" Foreground="#10B981"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
    </Border>
</UserControl>
