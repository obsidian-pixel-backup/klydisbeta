<UserControl x:Class="Klydis.App.Views.SystemMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1100">

    <UserControl.Resources>
        <!-- Shared card / text styles for a consistent, fully themed layout -->
        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        </Style>

        <Style x:Key="DetailLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>

        <Style x:Key="DetailValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ======== Header ======== -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Pulse glyph + live indicator -->
                    <Grid Width="24" Height="24" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Ellipse Stroke="{DynamicResource AccentPrimaryBrush}" StrokeThickness="1.4" Width="20" Height="20"/>
                        <Ellipse Fill="{DynamicResource SuccessBrush}" Width="7" Height="7" Style="{DynamicResource PulsingDotStyle}"/>
                    </Grid>
                    <StackPanel>
                        <TextBlock Text="System Monitor" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Live diagnostics — updates every 2 seconds."
                                   FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Live overview chips -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="7" Padding="10,5" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="CPU  " FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding CpuUsagePercent, StringFormat={}{0:F0}%}" FontSize="11.5" FontWeight="Bold"
                                       Foreground="{Binding CpuSeverity, Converter={StaticResource SeverityToBrushConverter}}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="7" Padding="10,5" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="GPU  " FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding GpuUsagePercent, StringFormat={}{0:F0}%}" FontSize="11.5" FontWeight="Bold"
                                       Foreground="{Binding GpuSeverity, Converter={StaticResource SeverityToBrushConverter}}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="7" Padding="10,5" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="RAM  " FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding RamUsagePercent, StringFormat={}{0:F0}%}" FontSize="11.5" FontWeight="Bold"
                                       Foreground="{Binding RamSeverity, Converter={StaticResource SeverityToBrushConverter}}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="7" Padding="10,5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Speed  " FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding CurrentTokensPerSecond, StringFormat={}{0:F1}}" FontSize="11.5" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentPrimaryBrush}"/>
                            <TextBlock Text=" tok/s" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======== Body ======== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16,16,16,20">

                <!-- OVERVIEW -->
                <TextBlock Text="OVERVIEW" Style="{StaticResource SectionLabelStyle}" Margin="2,0,0,10"/>
                <UniformGrid Columns="4" Margin="0,0,0,16">
                    <!-- CPU -->
                    <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,8,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="CPU" Style="{StaticResource SectionTitleStyle}"/>
                                <Ellipse Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Center"
                                         Fill="{Binding CpuSeverity, Converter={StaticResource SeverityToBrushConverter}}"/>
                            </Grid>
                            <TextBlock Text="{Binding CpuUsagePercent, StringFormat={}{0:F0}%}" FontSize="30" FontWeight="Bold"
                                       Foreground="{Binding CpuSeverity, Converter={StaticResource SeverityToBrushConverter}}"/>
                            <ProgressBar Maximum="100" Value="{Binding CpuUsagePercent}" Height="5" Margin="0,8,0,8"
                                         Foreground="{Binding CpuSeverity, Converter={StaticResource SeverityToBrushConverter}}"
                                         Background="{DynamicResource BackgroundTertiary}" BorderThickness="0"/>
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding CpuName}"/>
                                <Run Text="  ·  "/>
                                <Run Text="app "/>
                                <Run Text="{Binding ProcessCpuUsagePercent, StringFormat={}{0:F1}%}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <!-- GPU -->
                    <Border Style="{StaticResource SectionCardStyle}" Margin="8,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="GPU" Style="{StaticResource SectionTitleStyle}"/>
                                <Ellipse Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Center"
                                         Fill="{Binding GpuSeverity, Converter={StaticResource SeverityToBrushConverter}}"/>
                            </Grid>
                            <TextBlock Text="{Binding GpuUsagePercent, StringFormat={}{0:F0}%}" FontSize="30" FontWeight="Bold"
                                       Foreground="{Binding GpuSeverity, Converter={StaticResource SeverityToBrushConverter}}"/>
                            <ProgressBar Maximum="100" Value="{Binding GpuUsagePercent}" Height="5" Margin="0,8,0,8"
                                         Foreground="{Binding GpuSeverity, Converter={StaticResource SeverityToBrushConverter}}"
                                         Background="{DynamicResource BackgroundTertiary}" BorderThickness="0"/>
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding GpuName}"/>
                                <Run Text="  ·  "/>
                                <Run Text="{Binding GpuTemperature, StringFormat={}{0}°C}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <!-- RAM -->
                    <Border Style="{StaticResource SectionCardStyle}" Margin="8,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="RAM" Style="{StaticResource SectionTitleStyle}"/>
                                <Ellipse Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Center"
                                         Fill="{Binding RamSeverity, Converter={StaticResource SeverityToBrushConverter}}"/>
                            </Grid>
                            <TextBlock Text="{Binding RamUsagePercent, StringFormat={}{0:F0}%}" FontSize="30" FontWeight="Bold"
                                       Foreground="{Binding RamSeverity, Converter={StaticResource SeverityToBrushConverter}}"/>
                            <ProgressBar Maximum="100" Value="{Binding RamUsagePercent}" Height="5" Margin="0,8,0,8"
                                         Foreground="{Binding RamSeverity, Converter={StaticResource SeverityToBrushConverter}}"
                                         Background="{DynamicResource BackgroundTertiary}" BorderThickness="0"/>
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}">
                                <Run Text="{Binding RamUsedGb, StringFormat={}{0:F1}}"/>
                                <Run Text=" / "/>
                                <Run Text="{Binding RamTotalGb, StringFormat={}{0:F1} GB}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <!-- VRAM -->
                    <Border Style="{StaticResource SectionCardStyle}" Margin="8,0,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="VRAM" Style="{StaticResource SectionTitleStyle}"/>
                                <Ellipse Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Center"
                                         Fill="{Binding VramSeverity, Converter={StaticResource SeverityToBrushConverter}}"/>
                            </Grid>
                            <TextBlock Text="{Binding VramUsagePercent, StringFormat={}{0:F0}%}" FontSize="30" FontWeight="Bold"
                                       Foreground="{Binding VramSeverity, Converter={StaticResource SeverityToBrushConverter}}"/>
                            <ProgressBar Maximum="100" Value="{Binding VramUsagePercent}" Height="5" Margin="0,8,0,8"
                                         Foreground="{Binding VramSeverity, Converter={StaticResource SeverityToBrushConverter}}"
                                         Background="{DynamicResource BackgroundTertiary}" BorderThickness="0"/>
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}">
                                <Run Text="{Binding VramUsedMb, StringFormat={}{0:N0}}"/>
                                <Run Text=" / "/>
                                <Run Text="{Binding VramTotalMb, StringFormat={}{0:N0} MB}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- PERFORMANCE + CONTEXT -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Performance -->
                    <Border Grid.Column="0" Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Performance" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentTokensPerSecond, StringFormat={}{0:F1}}" FontSize="34" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                <TextBlock Text="tokens/sec" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Bottom" Margin="8,0,0,5"/>
                            </StackPanel>

                            <!-- Live speed sparkline -->
                            <ItemsControl ItemsSource="{Binding TokensPerSecondBarHeights}" Height="52" Margin="0,12,0,14">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource AccentPrimaryBrush}" Opacity="0.55"
                                                VerticalAlignment="Bottom" Height="{Binding}" Margin="1,0" CornerRadius="1,1,0,0"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,12,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Time to first token" Style="{StaticResource DetailLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LastTtftMs, StringFormat={}{0:F0} ms}"
                                               Style="{StaticResource DetailValueStyle}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </Grid>
                                <Grid Grid.Row="0" Grid.Column="1" Margin="12,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Prefill" Style="{StaticResource DetailLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LastPrefillTps, StringFormat={}{0:F0} tok/s}"
                                               Style="{StaticResource DetailValueStyle}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </Grid>
                                <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="End-to-end" Style="{StaticResource DetailLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LastEndToEndTps, StringFormat={}{0:F1} tok/s}"
                                               Style="{StaticResource DetailValueStyle}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </Grid>
                                <Grid Grid.Row="1" Grid.Column="1" Margin="12,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Session tokens" Style="{StaticResource DetailLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource DetailValueStyle}" Foreground="{DynamicResource TextPrimaryBrush}">
                                        <Run Text="{Binding TotalTokensIn, StringFormat={}{0:N0}}"/>
                                        <Run Text="↑ / "/>
                                        <Run Text="{Binding TotalTokensOut, StringFormat={}{0:N0}}"/>
                                        <Run Text="↓"/>
                                    </TextBlock>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Context usage -->
                    <Border Grid.Column="2" Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Context usage" Style="{StaticResource SectionTitleStyle}"/>
                                <Ellipse Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Center"
                                         Fill="{Binding ContextWindowSeverity, Converter={StaticResource SeverityToBrushConverter}}"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ContextUsedPercent, StringFormat={}{0:F0}%}" FontSize="34" FontWeight="Bold"
                                           Foreground="{Binding ContextWindowSeverity, Converter={StaticResource SeverityToBrushConverter}}"/>
                                <TextBlock Text="of context window used" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Bottom" Margin="8,0,0,5"/>
                            </StackPanel>

                            <ProgressBar Maximum="100" Value="{Binding ContextUsedPercent}" Height="8" Margin="0,12,0,12"
                                         Foreground="{Binding ContextWindowSeverity, Converter={StaticResource SeverityToBrushConverter}}"
                                         Background="{DynamicResource BackgroundTertiary}" BorderThickness="0"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Used" Style="{StaticResource DetailLabelStyle}"/>
                                <TextBlock Grid.Column="1" Text="{Binding ContextWindowUsedTokens, StringFormat={}{0:N0}}"
                                           Style="{StaticResource DetailValueStyle}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Remaining" Style="{StaticResource DetailLabelStyle}"/>
                                <TextBlock Grid.Column="1" Text="{Binding ContextWindowRemainingPercent, StringFormat={}{0:F1}%}"
                                           Style="{StaticResource DetailValueStyle}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Window size" Style="{StaticResource DetailLabelStyle}"/>
                                <TextBlock Grid.Column="1" Text="{Binding ContextWindowTotalTokens, StringFormat={}{0:N0}}"
                                           Style="{StaticResource DetailValueStyle}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Grid>

                            <Border Background="{DynamicResource BackgroundTertiary}" CornerRadius="6" Padding="10,8" Margin="0,12,0,0">
                                <TextBlock Text="{Binding ContextWindowSummary}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- SYSTEM -->
                <TextBlock Text="SYSTEM" Style="{StaticResource SectionLabelStyle}" Margin="2,0,0,10"/>
                <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Operating system" Style="{StaticResource DetailLabelStyle}"/>
                                <TextBlock Grid.Column="1" Text="{Binding OsVersion}" Style="{StaticResource DetailValueStyle}" MaxWidth="260"/>
                            </Grid>
                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Machine" Style="{StaticResource DetailLabelStyle}"/>
                                <TextBlock Grid.Column="1" Text="{Binding MachineName}" Style="{StaticResource DetailValueStyle}"/>
                            </Grid>
                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Uptime" Style="{StaticResource DetailLabelStyle}"/>
                                <TextBlock Grid.Column="1" Text="{Binding UptimeText}" Style="{StaticResource DetailValueStyle}"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Processor" Style="{StaticResource DetailLabelStyle}"/>
                                <TextBlock Grid.Column="1" Text="{Binding CpuName}" Style="{StaticResource DetailValueStyle}" MaxWidth="260"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Cores / threads" Style="{StaticResource DetailLabelStyle}"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource DetailValueStyle}">
                                    <Run Text="{Binding CoreCount}"/>
                                    <Run Text=" / "/>
                                    <Run Text="{Binding LogicalProcessorCount}"/>
                                </TextBlock>
                            </Grid>
                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Clock speed" Style="{StaticResource DetailLabelStyle}"/>
                                <TextBlock Grid.Column="1" Text="{Binding ClockSpeedMHz, StringFormat={}{0:N0} MHz}" Style="{StaticResource DetailValueStyle}"/>
                            </Grid>
                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="App working set" Style="{StaticResource DetailLabelStyle}"/>
                                <TextBlock Grid.Column="1" Text="{Binding AppRamUsedMb, StringFormat={}{0:N0} MB}" Style="{StaticResource DetailValueStyle}"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Threads / handles" Style="{StaticResource DetailLabelStyle}"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource DetailValueStyle}">
                                    <Run Text="{Binding ProcessThreadCount}"/>
                                    <Run Text=" / "/>
                                    <Run Text="{Binding ProcessHandleCount}"/>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- STORAGE -->
                <TextBlock Text="STORAGE" Style="{StaticResource SectionLabelStyle}" Margin="2,0,0,10"/>
                <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Disks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="7" Padding="12,9" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Width="150" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="  ·  " FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="80"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Format}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <ProgressBar Grid.Column="1" Maximum="100" Value="{Binding UsedPercent}" Height="6"
                                                         Foreground="{DynamicResource AccentPrimaryBrush}" Background="{DynamicResource BackgroundTertiary}"
                                                         BorderThickness="0" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <TextBlock FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" TextAlignment="Right">
                                                    <Run Text="{Binding UsedText}"/>
                                                    <Run Text=" of "/>
                                                    <Run Text="{Binding TotalText}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding FreeText}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Right" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="7" Padding="12,9"
                                Visibility="{Binding Disks.Count, Converter={StaticResource ZeroToCollapsedConverter}}">
                            <TextBlock Text="No fixed drives detected." FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- MODEL & ENGINE -->
                <TextBlock Text="MODEL &amp; ENGINE" Style="{StaticResource SectionLabelStyle}" Margin="2,0,0,10"/>
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ModelName}" Style="{StaticResource SectionTitleStyle}" FontSize="14"
                                           TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="4" Padding="7,2" Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ArchitectureLabel}" FontSize="10" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Visibility="{Binding ModelName, Converter={StaticResource StringToVisibilityConverter}}">
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Loaded" FontSize="11" Foreground="{DynamicResource SuccessBrush}"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <Grid Margin="0,0,0,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Model" Style="{StaticResource DetailLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ModelDetailsSummary}" Style="{StaticResource DetailValueStyle}" MaxWidth="260"/>
                                </Grid>
                                <Grid Margin="0,0,0,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="KV cache" Style="{StaticResource DetailLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding KvCacheSummary}" Style="{StaticResource DetailValueStyle}" MaxWidth="260"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Model memory" Style="{StaticResource DetailLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ModelMemoryMb, StringFormat={}{0:F1} MB (file size)}"
                                               Style="{StaticResource DetailValueStyle}"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <Grid Margin="0,0,0,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Speculative decoding" Style="{StaticResource DetailLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SpeculativeStatusText}" Style="{StaticResource DetailValueStyle}" MaxWidth="260"/>
                                </Grid>
                                <Grid Margin="0,0,0,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Last generation" Style="{StaticResource DetailLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LastGenerationSummary}" Style="{StaticResource DetailValueStyle}" MaxWidth="260"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Active models" Style="{StaticResource DetailLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LoadedModels.Count}" Style="{StaticResource DetailValueStyle}"/>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <Border Background="{DynamicResource BackgroundTertiary}" CornerRadius="6" Padding="10,8" Margin="0,12,0,0"
                                Visibility="{Binding LastGenerationDetail, Converter={StaticResource StringToVisibilityConverter}}">
                            <TextBlock Text="{Binding LastGenerationDetail}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
