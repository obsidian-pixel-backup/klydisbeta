<UserControl x:Class="Klydis.App.Views.ChatSidePanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewmodels="clr-namespace:Klydis.App.ViewModels"
             xmlns:mdxam="clr-namespace:MdXaml;assembly=MdXaml"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="360"
             Background="{DynamicResource SidebarBackgroundBrush}">

    <UserControl.Resources>
        <!-- Pill-style tab used by the six panel tabs (Queue / Files / Changes / Preview /
             Terminal / Notes), mirroring the app's ActivityTabStyle look. -->
        <Style x:Key="SidePanelTabStyle" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{DynamicResource KlydisFocusVisual}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderMidBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section header label used across the panel tabs. -->
        <Style x:Key="SidePanelSectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>

        <!-- Small status badge pill (Modified / Added / Untracked / html / md ...). -->
        <Style x:Key="SidePanelBadge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="5,1.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="SidePanelBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
        <Style x:Key="SidePanelListBoxItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{DynamicResource KlydisFocusVisual}"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Per-tab visibility: only the grid whose SelectedTab matches shows. Each style is
             declared independently (no BasedOn) because WPF merges triggers across BasedOn
             styles, which would show a tab whenever ANY of its base triggers matched. -->
        <Style x:Key="SidePanelTabVisibilityQueue" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SidePanel.SelectedTab}" Value="{x:Static viewmodels:SidePanelTab.Queue}">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SidePanelTabVisibilityPlan" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SidePanel.SelectedTab}" Value="{x:Static viewmodels:SidePanelTab.Plan}">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SidePanelTabVisibilityFiles" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SidePanel.SelectedTab}" Value="{x:Static viewmodels:SidePanelTab.Files}">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SidePanelTabVisibilityChanges" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SidePanel.SelectedTab}" Value="{x:Static viewmodels:SidePanelTab.Changes}">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SidePanelTabVisibilityPreview" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SidePanel.SelectedTab}" Value="{x:Static viewmodels:SidePanelTab.Preview}">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SidePanelTabVisibilityTerminal" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SidePanel.SelectedTab}" Value="{x:Static viewmodels:SidePanelTab.Terminal}">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SidePanelTabVisibilityNotes" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SidePanel.SelectedTab}" Value="{x:Static viewmodels:SidePanelTab.Notes}">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Tab strip. A WrapPanel keeps all seven tabs visible at ANY panel width by
                 flowing onto a second row when the panel is narrow — the old horizontal
                 ScrollViewer clipped tabs (user-reported clipping when shrinking the panel). -->
            <Border Grid.Row="0" Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="6,6">
                <WrapPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource SidePanelTabStyle}" GroupName="SidePanelTabs"
                                 IsChecked="{Binding SidePanel.SelectedTab, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Queue}"
                                 ToolTip="Queued / steering messages for this chat" AutomationProperties.Name="Queue" AutomationProperties.HelpText="Queued / steering messages for this chat">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Queue"/>
                            <Border CornerRadius="8" Margin="5,0,0,0" Padding="5,0" VerticalAlignment="Center"
                                    Background="{DynamicResource AccentSoftBrush}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SidePanel.QueueBadge}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding SidePanel.QueueBadge}" FontSize="9.5" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentPrimaryBrush}"/>
                            </Border>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource SidePanelTabStyle}" GroupName="SidePanelTabs"
                                 IsChecked="{Binding SidePanel.SelectedTab, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Plan}"
                                 ToolTip="The model's todo list for the current task (created with the plan tool)" AutomationProperties.Name="Plan" AutomationProperties.HelpText="The model's todo list for the current task (created with the plan tool)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Plan"/>
                            <Border CornerRadius="8" Margin="5,0,0,0" Padding="5,0" VerticalAlignment="Center"
                                    Background="{DynamicResource AccentSoftBrush}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SidePanel.PlanBadge}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding SidePanel.PlanBadge}" FontSize="9.5" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentPrimaryBrush}"/>
                            </Border>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource SidePanelTabStyle}" GroupName="SidePanelTabs"
                                 IsChecked="{Binding SidePanel.SelectedTab, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Files}"
                                 ToolTip="Files the agent worked on (git status / recent workspace writes)" AutomationProperties.Name="Files" AutomationProperties.HelpText="Files the agent worked on (git status / recent workspace writes)">
                        <TextBlock Text="Files"/>
                    </RadioButton>
                    <RadioButton Style="{StaticResource SidePanelTabStyle}" GroupName="SidePanelTabs"
                                 IsChecked="{Binding SidePanel.SelectedTab, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Changes}"
                                 ToolTip="Git changes, diff summary, and recent commits" AutomationProperties.Name="Changes" AutomationProperties.HelpText="Git changes, diff summary, and recent commits">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Changes"/>
                            <Border CornerRadius="8" Margin="5,0,0,0" Padding="5,0" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SidePanel.ChangesBadge}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding SidePanel.ChangesBadge}" FontSize="9.5" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentPrimaryBrush}"/>
                            </Border>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource SidePanelTabStyle}" GroupName="SidePanelTabs"
                                 IsChecked="{Binding SidePanel.SelectedTab, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Preview}"
                                 ToolTip="Live preview of HTML / markdown / text artifacts" AutomationProperties.Name="Preview" AutomationProperties.HelpText="Live preview of HTML / markdown / text artifacts">
                        <TextBlock Text="Preview"/>
                    </RadioButton>
                    <RadioButton Style="{StaticResource SidePanelTabStyle}" GroupName="SidePanelTabs"
                                 IsChecked="{Binding SidePanel.SelectedTab, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Terminal}"
                                 ToolTip="The model's shell commands and their outputs — its terminal usage, not debug logs" AutomationProperties.Name="Terminal" AutomationProperties.HelpText="The model's shell commands and their outputs — its terminal usage, not debug logs">
                        <TextBlock Text="Terminal"/>
                    </RadioButton>
                    <RadioButton Style="{StaticResource SidePanelTabStyle}" GroupName="SidePanelTabs"
                                 IsChecked="{Binding SidePanel.SelectedTab, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Notes}"
                                 ToolTip="Notes the model reads as part of its context" AutomationProperties.Name="Notes" AutomationProperties.HelpText="Notes the model reads as part of its context">
                        <TextBlock Text="Notes"/>
                    </RadioButton>
                </WrapPanel>
            </Border>

            <!-- ============ QUEUE ============ -->
            <Grid Grid.Row="1" Style="{StaticResource SidePanelTabVisibilityQueue}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="12,10,12,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <!-- Two-row header: the summary reads full-width on top and the controls sit
                         on their own row below, right-aligned. A single cramped row clipped the
                         sort dropdown at narrow panel widths (the observed "Manual (dmg)" cut);
                         two rows never clip at any width the splitter allows, and the controls
                         keep a consistent 26px hit target. -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding SidePanel.QueueSummaryText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
                        <!-- Controls on their own row. Star column + Auto columns instead of a
                             horizontal StackPanel: the sort combo SHRINKS with the panel (its text
                             ellipsizes) instead of overflowing, and the buttons always stay
                             visible — nothing clips at any width the splitter allows. -->
                        <Grid Grid.Row="1" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" AutomationProperties.Name="Queue mode" MinWidth="80" MaxWidth="220" Height="26" FontSize="11" Margin="0,0,8,0"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      ItemsSource="{Binding QueueSortOptions}" SelectedItem="{Binding SelectedQueueSortOption}"
                                      ToolTip="Sort the queued messages (display only — processing stays oldest-first)"
                                      Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                      BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                                <!-- Explicit template so the selected item ELLIPSIZES ("Manual (dra…")
                                     instead of being cut mid-glyph when the panel is very narrow. -->
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1" Style="{DynamicResource GhostButton}" Command="{Binding SendAllQueuedNowCommand}"
                                    Content="Send all" FontSize="11" Padding="8,3" Height="26" Margin="0,0,8,0"
                                    ToolTip="Send ALL queued messages now, one after another (cancels any running generation)" AutomationProperties.Name="Send ALL queued messages now, one after another (cancels any running generation)"/>
                            <Button Grid.Column="2" Style="{DynamicResource GhostButton}" Command="{Binding ClearQueueCommand}"
                                    Content="Clear" FontSize="11" Padding="8,3" Height="26"/>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <!-- Drag-and-drop reordering lives in code-behind (QueuedMessagesList_* handlers).
                         Dragging only works from the item body — not the edit TextBox or buttons. -->
                    <ListBox x:Name="QueuedMessagesList"
                             ItemsSource="{Binding SidePanel.QueuedMessages}"
                             Margin="10"
                             AllowDrop="True"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="False"
                             PreviewMouseLeftButtonDown="QueuedMessagesList_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="QueuedMessagesList_PreviewMouseMove"
                             DragOver="QueuedMessagesList_DragOver"
                             DragLeave="QueuedMessagesList_DragLeave"
                             Drop="QueuedMessagesList_Drop"
                             ToolTip="Drag a queued message to change its processing order (Manual order)">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="FocusVisualStyle" Value="{DynamicResource KlydisFocusVisual}"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    SnapsToDevicePixels="True">
                                                <ContentPresenter/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <!-- Drop-position indicator: a 2px accent line on the top or
                                         bottom edge of the target item (set via Tag by code-behind). -->
                                    <Trigger Property="Tag" Value="drop-before">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
                                        <Setter Property="BorderThickness" Value="0,2,0,0"/>
                                    </Trigger>
                                    <Trigger Property="Tag" Value="drop-after">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                    <Border Background="{DynamicResource InputBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="6" Margin="0,0,0,6" Padding="6,5">
                                        <Grid>
                                            <!-- Non-edit mode: badges | *message* | actions. Star column
                                                 guarantees the text always gets the remaining width and the
                                                 action buttons never get pushed out of the card. -->
                                            <Grid Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisConverter}}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,6,0" VerticalAlignment="Center">
                                                    <Border Background="{DynamicResource SurfaceElevatedBrush}" CornerRadius="4" Padding="4,1.5" Margin="0,0,4,0">
                                                        <TextBlock Text="{Binding PositionLabel}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                                    </Border>
                                                    <Button Style="{DynamicResource GhostButton}"
                                                            Command="{Binding DataContext.ToggleQueueItemModeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Switch to Steer and Direct Send" Margin="0" Padding="0" AutomationProperties.Name="Switch to Steer and Direct Send">
                                                        <Border x:Name="ModeBadgeBorder" Background="{DynamicResource AccentSoftBrush}" CornerRadius="4" Padding="5,1.5">
                                                            <TextBlock x:Name="ModeText" Text="{Binding ModeBadgeText}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                                        </Border>
                                                    </Button>
                                                </StackPanel>
                                                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                                    <Button Style="{DynamicResource GhostButton}"
                                                            Command="{Binding DataContext.SendQueuedItemNowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" ToolTip="Send now" Margin="0" Padding="2,0" VerticalAlignment="Center" AutomationProperties.Name="Send now">
                                                        <TextBlock Text="▶" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                                    </Button>
                                                    <Button Style="{DynamicResource GhostButton}" Command="{Binding BeginEditCommand}"
                                                            ToolTip="Edit queued message" Margin="4,0,0,0" Padding="2,0" VerticalAlignment="Center" AutomationProperties.Name="Edit queued message">
                                                        <TextBlock Text="✎" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                                    </Button>
                                                    <Button Style="{DynamicResource QueueItemCloseButton}"
                                                            Command="{Binding DataContext.RemoveQueuedItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" Margin="4,0,0,0" ToolTip="Cancel / remove" VerticalAlignment="Center" AutomationProperties.Name="Cancel / remove"/>
                                                </StackPanel>
                                                <!-- Message content: wraps to the width available, up to
                                                     ~5 lines, ellipsis only past that. -->
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DisplayText}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                           MaxHeight="84" LineHeight="15" FontSize="11"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" ToolTip="{Binding DisplayText}"/>

                                                <!-- Attachment badges/chips if message has attachments -->
                                                <ItemsControl Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" ItemsSource="{Binding Attachments}" Margin="0,4,0,0"
                                                              Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVisConverter}}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                                    BorderThickness="1" CornerRadius="4" Margin="0,2,4,2" Padding="4,2"
                                                                    ToolTip="{Binding FilePath}">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding IconSymbol}" FontSize="10" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding FileName}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" MaxWidth="120" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                            <!-- Edit mode: star-sized TextBox so it shrinks with the panel
                                                 instead of overflowing (the old fixed 170px clipped at
                                                 narrow widths). -->
                                            <Grid Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisConverter}}" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}" MinWidth="60" MaxHeight="60"
                                                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                                         Background="{DynamicResource PanelBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                         BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="1" Padding="4,2"/>
                                                <Button Grid.Column="1" Style="{DynamicResource GhostButton}"
                                                        Command="{Binding DataContext.SaveQueuedItemEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" ToolTip="Save changes" Margin="6,0,0,0" Padding="2,0" AutomationProperties.Name="Save changes">
                                                    <TextBlock Text="✓" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                                                </Button>
                                                <Button Grid.Column="2" Style="{DynamicResource QueueItemCloseButton}" Command="{Binding CancelEditCommand}"
                                                        Margin="4,0,0,0" ToolTip="Discard changes" VerticalAlignment="Center" AutomationProperties.Name="Discard changes"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding ModeBadgeText}" Value="Direct Send">
                                            <Setter TargetName="ModeBadgeBorder" Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
                                            <Setter TargetName="ModeText" Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="Nothing queued." FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SidePanel.QueueBadge}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>

            <!-- ============ PLAN ============ -->
            <Grid Grid.Row="1" Style="{StaticResource SidePanelTabVisibilityPlan}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="12,8,12,6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="TASK PLAN (TODO LIST)" Style="{StaticResource SidePanelSectionHeader}" Margin="0,0,0,2"/>
                            <TextBlock Grid.Column="1" Text="{Binding SidePanel.PlanStatusText}" FontSize="10"
                                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="220"
                                       ToolTip="{Binding SidePanel.PlanStatusText}"/>
                        </Grid>
                        <ProgressBar Height="4" Minimum="0" Maximum="100" Margin="0,6,0,0" BorderThickness="0"
                                     Background="{DynamicResource BackgroundTertiary}" Foreground="{DynamicResource AccentPrimaryBrush}"
                                     Value="{Binding SidePanel.PlanProgressPercent}"/>
                        <TextBlock Text="{Binding SidePanel.EpistemicSummary}" FontSize="9.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,4,0,0"
                                   Visibility="{Binding SidePanel.EpistemicSummary, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}"/>
                    </StackPanel>
                </Border>

                <ListBox Grid.Row="1" ItemsSource="{Binding SidePanel.PlanItems}" Background="Transparent" BorderThickness="0"
                         Margin="10,8" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="FocusVisualStyle" Value="{DynamicResource KlydisFocusVisual}"/>
                            <Setter Property="Padding" Value="4,3"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="IsHitTestVisible" Value="False"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="RowBackground" Background="Transparent" CornerRadius="6" Padding="4,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Checkbox glyph: filled check when the item is done -->
                                    <Border x:Name="CheckBoxGlyph" Width="15" Height="15" CornerRadius="4"
                                            BorderBrush="{DynamicResource BorderMidBrush}" BorderThickness="1.5"
                                            VerticalAlignment="Center" Margin="0,0,8,0" Background="{DynamicResource InputBackgroundBrush}">
                                        <Path x:Name="CheckMark" Data="M 2,5.5 L 6,9.5 L 12,2" Stroke="{DynamicResource AccentPrimaryBrush}"
                                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Width="11" Height="11" Stretch="Uniform" Visibility="Collapsed"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" x:Name="PlanText" Text="{Binding Text}" FontSize="11.5"
                                               Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" x:Name="CurrentBadge" Text="CURRENT" FontSize="8.5" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentPrimaryBrush}" Margin="8,0,0,0"
                                               VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                    <Setter TargetName="CheckBoxGlyph" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
                                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="PlanText" Property="TextDecorations" Value="Strikethrough"/>
                                    <Setter TargetName="PlanText" Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                    <Setter TargetName="RowBackground" Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
                                    <Setter TargetName="CheckBoxGlyph" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
                                    <Setter TargetName="PlanText" Property="FontWeight" Value="SemiBold"/>
                                    <Setter TargetName="CurrentBadge" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="1" Text="No plan yet — when the model works on a task it establishes a todo list with the 'plan' tool."
                           FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SidePanel.HasPlan}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- ============ FILES ============ -->
            <Grid Grid.Row="1" Style="{StaticResource SidePanelTabVisibilityFiles}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="12,8,12,6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="FILES WORKED ON" Style="{StaticResource SidePanelSectionHeader}" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding SidePanel.WorkspaceLabel}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding SidePanel.WorkspaceLabel}" MaxWidth="220"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{DynamicResource GhostButton}" Command="{Binding SidePanel.RefreshSessionCommand}"
                                Content="Refresh" FontSize="11" Padding="8,3" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <ListBox Grid.Row="1" ItemsSource="{Binding SidePanel.WorkspaceFiles}" Background="Transparent" BorderThickness="0" Margin="8,6,8,6"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="FocusVisualStyle" Value="{DynamicResource KlydisFocusVisual}"/>
                            <Setter Property="Padding" Value="4,3"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource SidePanelBadge}">
                                    <TextBlock Text="{Binding Status}" Style="{StaticResource SidePanelBadgeText}"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding RelativePath}" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding RelativePath}"/>
                                <TextBlock Grid.Column="2" Text="{Binding ModifiedText}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- ============ CHANGES ============ -->
            <Grid Grid.Row="1" Style="{StaticResource SidePanelTabVisibilityChanges}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="12,8,12,6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="CHANGE LOG" Style="{StaticResource SidePanelSectionHeader}" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding SidePanel.WorkspaceLabel}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding SidePanel.WorkspaceLabel}" MaxWidth="220"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{DynamicResource GhostButton}" Command="{Binding SidePanel.RefreshSessionCommand}"
                                Content="Refresh" FontSize="11" Padding="8,3" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="12,0,12,8">
                    <StackPanel>
                        <TextBlock Text="CHANGED FILES (real diffs)" Style="{StaticResource SidePanelSectionHeader}"/>
                        <ListBox ItemsSource="{Binding SidePanel.ChangeItems}"
                                 SelectedItem="{Binding SidePanel.SelectedChangeItem}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource SidePanelListBoxItem}" MaxHeight="180">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1.5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource SidePanelBadge}" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding Status}" Style="{StaticResource SidePanelBadgeText}"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding RelativePath}" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding RelativePath}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding ChangeStats}" FontSize="10.5" FontFamily="Consolas"
                                                   Foreground="{DynamicResource TextMutedBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="DIFF" Style="{StaticResource SidePanelSectionHeader}"/>
                        <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="6" Padding="8,6">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" MaxHeight="220">
                                <TextBlock Text="{Binding SidePanel.SelectedChangeDiff}" FontFamily="Consolas" FontSize="10.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="NoWrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding SidePanel.SelectedChangeDiff}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SidePanel.SelectedChangeDiff}" Value="">
                                                    <Setter Property="Text" Value="Select a changed file to see its real diff."/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </ScrollViewer>
                        </Border>

                        <TextBlock Text="SESSION ACTIVITY" Style="{StaticResource SidePanelSectionHeader}"/>
                        <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="6" Padding="8,6">
                            <TextBlock Text="{Binding SidePanel.ChangesSummary}" FontFamily="Consolas" FontSize="10.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </Border>

                        <TextBlock Text="LATEST ACTIONS" Style="{StaticResource SidePanelSectionHeader}"/>
                        <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="6" Padding="8,6">
                            <TextBlock Text="{Binding SidePanel.RecentCommitsText}" FontFamily="Consolas" FontSize="10.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ============ PREVIEW ============ -->
            <Grid Grid.Row="1" Style="{StaticResource SidePanelTabVisibilityPreview}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" MinWidth="90"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Artifact list -->
                <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0"
                        Background="{DynamicResource PanelBackgroundBrush}" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="ARTIFACTS" Style="{StaticResource SidePanelSectionHeader}" Margin="0,4,0,6"/>
                        <ListBox Grid.Row="1" ItemsSource="{Binding SidePanel.PreviewArtifacts}"
                                 SelectedItem="{Binding SidePanel.SelectedArtifact}" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="FocusVisualStyle" Value="{DynamicResource KlydisFocusVisual}"/>
                                    <Setter Property="Padding" Value="4,3"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding KindBadge}" FontSize="9" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Grid.Row="2" Style="{DynamicResource GhostButton}" Command="{Binding SidePanel.RefreshPreviewsCommand}"
                                Content="Refresh" FontSize="11" Padding="8,3" Margin="0,6,0,0" HorizontalAlignment="Stretch"/>
                    </Grid>
                </Border>

                <!-- Preview content -->
                <Grid Grid.Row="0" Grid.Column="1">
                    <Border Padding="8,6" Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Command="{Binding SidePanel.OpenArtifactInBrowserCommand}"
                                    Content="Open in browser" FontSize="11" Padding="8,3">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                        <Setter Property="FocusVisualStyle" Value="{DynamicResource KlydisFocusVisual}"/>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SidePanel.SelectedArtifact.Kind}" Value="html">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="1" Grid.Column="1">
                    <!-- HTML render -->
                    <WebBrowser x:Name="PreviewBrowser">
                        <WebBrowser.Style>
                            <Style TargetType="WebBrowser">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SidePanel.SelectedArtifact.Kind}" Value="html">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </WebBrowser.Style>
                    </WebBrowser>

                    <!-- Markdown render -->
                    <mdxam:MarkdownScrollViewer Markdown="{Binding SidePanel.PreviewMarkdown}" Background="Transparent"
                                                Loaded="MarkdownViewer_Loaded">
                        <mdxam:MarkdownScrollViewer.Style>
                            <Style TargetType="mdxam:MarkdownScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SidePanel.SelectedArtifact.Kind}" Value="md">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </mdxam:MarkdownScrollViewer.Style>
                    </mdxam:MarkdownScrollViewer>

                    <!-- Plain text render -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SidePanel.SelectedArtifact.Kind}" Value="text">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <TextBox Text="{Binding SidePanel.PreviewText}" IsReadOnly="True" FontFamily="Consolas" FontSize="11.5"
                                 Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0"
                                 TextWrapping="NoWrap" Padding="10,8" VerticalScrollBarVisibility="Auto"/>
                    </ScrollViewer>

                    <!-- Empty state -->
                    <TextBlock Text="Select an artifact to preview." FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SidePanel.SelectedArtifact.Kind}" Value="html">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SidePanel.SelectedArtifact.Kind}" Value="md">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SidePanel.SelectedArtifact.Kind}" Value="text">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>

            <!-- ============ TERMINAL ============ -->
            <!-- The model's terminal usage: every run_command the model executed, rendered as a
                 bracketed input/output transcript. NOT debug logs — the transcript is rebuilt
                 from this session's recorded tool activity on the 2s tick. -->
            <Grid Grid.Row="1" Style="{StaticResource SidePanelTabVisibilityTerminal}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="12,8,12,6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <TextBlock Text="{Binding SidePanel.TerminalStatusText}" FontSize="10"
                               Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                </Border>

                <ListBox x:Name="TerminalList" Grid.Row="1" ItemsSource="{Binding SidePanel.TerminalEntries}"
                         Background="Transparent" BorderThickness="0" Padding="10,8"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         ScrollViewer.CanContentScroll="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- Bracket: one bordered block per command, input on top, output below -->
                            <Border Margin="0,0,0,8" Padding="10" CornerRadius="4"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    Background="{DynamicResource InputBackgroundBrush}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Prompt}" FontFamily="Consolas" FontSize="11"
                                                   Foreground="{DynamicResource AccentPrimaryBrush}"
                                                   TextWrapping="Wrap"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    VerticalAlignment="Top" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Timestamp, StringFormat=HH:mm:ss}" FontSize="10"
                                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding StatusBadge}" FontSize="9" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Success}" Value="False">
                                                                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                    <Border Margin="0,8,0,0" Padding="8" CornerRadius="3"
                                            Background="{DynamicResource PanelBackgroundBrush}">
                                        <TextBlock Text="{Binding Output}" FontFamily="Consolas" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- ============ NOTES ============ -->
            <Grid Grid.Row="1" Style="{StaticResource SidePanelTabVisibilityNotes}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="12,8,12,6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="CHAT NOTES" Style="{StaticResource SidePanelSectionHeader}" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding SidePanel.NotesStatusText}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{DynamicResource GhostButton}" Command="{Binding SidePanel.NewNoteCommand}"
                                Content="New note" FontSize="11" Padding="8,3" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <ListBox Grid.Row="1" ItemsSource="{Binding SidePanel.Notes}" SelectedItem="{Binding SidePanel.SelectedNote}"
                         Background="Transparent" BorderThickness="0" Margin="10,8" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="FocusVisualStyle" Value="{DynamicResource KlydisFocusVisual}"/>
                            <Setter Property="Padding" Value="6,4"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding Content}" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="1" Text="{Binding UpdatedText}" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,3,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="2" Padding="10,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                        Background="{DynamicResource PanelBackgroundBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBox Text="{Binding SidePanel.NoteEditorText, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="72" MaxHeight="140" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="6,4"
                                 ToolTip="Write a note the model will read as part of its context on every message"/>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                            <Button Command="{Binding SidePanel.DeleteNoteCommand}"
                                    Content="Delete" FontSize="11" Padding="8,3" Margin="0,0,6,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                        <Setter Property="FocusVisualStyle" Value="{DynamicResource KlydisFocusVisual}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SidePanel.SelectedNote}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Style="{DynamicResource SecondaryButton}" Command="{Binding SidePanel.SaveNoteCommand}"
                                    Content="Save note" FontSize="11" Padding="10,4"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
