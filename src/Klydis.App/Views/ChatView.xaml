<UserControl x:Class="Klydis.App.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewmodels="clr-namespace:Klydis.App.ViewModels"
             xmlns:views="clr-namespace:Klydis.App.Views"
             xmlns:mdxam="clr-namespace:MdXaml;assembly=MdXaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800"
             Background="{DynamicResource PanelBackgroundBrush}">

    <UserControl.Resources>
        <Style x:Key="PremiumThinkingExpanderStyle" TargetType="Expander">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ToggleButton Grid.Row="0"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          OverridesDefaultStyle="True" Background="Transparent"
                                          Foreground="{TemplateBinding Foreground}"
                                          Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" Padding="0,4">
                                            <StackPanel Orientation="Horizontal">
                                                <Path x:Name="Arrow" Data="M 1,2 L 5,6 L 9,2"
                                                      Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      RenderTransformOrigin="0.5,0.5" Width="10" Height="8" Margin="0,0,8,0">
                                                    <Path.RenderTransform>
                                                        <RotateTransform Angle="-90"/>
                                                    </Path.RenderTransform>
                                                </Path>
                                                <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="UIElement.RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="0"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="False">
                                                <Setter TargetName="Arrow" Property="UIElement.RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="-90"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Arrow" Property="Opacity" Value="0.8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter Content="{TemplateBinding Header}"/>
                            </ToggleButton>

                            <Border x:Name="ExpandSite" Grid.Row="1" Opacity="0" Visibility="Collapsed">
                                <Border.LayoutTransform>
                                    <ScaleTransform ScaleY="0" />
                                </Border.LayoutTransform>
                                <Border.RenderTransform>
                                    <TranslateTransform Y="-10"/>
                                </Border.RenderTransform>

                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Focusable="false" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Opacity" Value="1"/>
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ExpandSite" Property="FrameworkElement.LayoutTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleY="1"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="ExpandSite" Property="UIElement.RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="0"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ExpandSite" Property="Opacity" Value="0"/>
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="ExpandSite" Property="FrameworkElement.LayoutTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleY="0"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="ExpandSite" Property="UIElement.RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="-10"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Markdown element styling (tables, code blocks, headings, quotes) lives in the
             shared Themes/MarkdownStyles.xaml dictionary and is applied by
             MarkdownViewerStyler (see ChatView.xaml.cs / ChatSidePanelView.xaml.cs). -->

        <!-- One tool invocation: status icon + name + command preview + expandable output -->
        <DataTemplate x:Key="ToolCallTemplate" DataType="{x:Type viewmodels:ToolCallViewModel}">
            <Border Background="{DynamicResource ToolBubbleBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="12,6" Margin="0,1">
                <Expander Style="{StaticResource PremiumThinkingExpanderStyle}"
                          IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                          Foreground="{DynamicResource TextSecondaryBrush}">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse Style="{StaticResource PulsingDotStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Visibility="{Binding Status, Converter={StaticResource RoleToVisibilityConverter}, ConverterParameter=running}"/>
                                <Path Data="M 3,8 L 6,11 L 13,3" Stroke="{DynamicResource SuccessBrush}" StrokeThickness="2"
                                      Stretch="Uniform" Width="11" Height="11"
                                      Visibility="{Binding Status, Converter={StaticResource RoleToVisibilityConverter}, ConverterParameter=done}"/>
                                <Path Data="M 2,2 L 12,12 M 2,12 L 12,2" Stroke="{DynamicResource ErrorBrush}" StrokeThickness="2"
                                      Stretch="Uniform" Width="10" Height="10"
                                      Visibility="{Binding Status, Converter={StaticResource RoleToVisibilityConverter}, ConverterParameter=failed}"/>
                            </Grid>
                            <TextBlock Text="{Binding Name}" FontFamily="Consolas" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CommandText, StringFormat=' › {0}'}" FontFamily="Consolas" FontSize="11.5"
                                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="6,0,0,0"
                                       TextTrimming="CharacterEllipsis" MaxWidth="380">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CommandText}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Margin="10,0,0,0" FontSize="11.5" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="running">
                                                <Setter Property="Text" Value="running"/>
                                                <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="done">
                                                <Setter Property="Text" Value="completed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="failed">
                                                <Setter Property="Text" Value="failed"/>
                                                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Expander.Header>
                    <Border Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="10,8" Margin="0,6,0,2">
                        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <!-- Executing Command / Arguments -->
                                <TextBlock Text="COMMAND / PARAMETERS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,0,0,3">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Arguments}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Border Background="{DynamicResource SurfaceElevatedBrush}" CornerRadius="4" Padding="8,5" Margin="0,0,0,8">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Arguments}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Arguments}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontFamily="Consolas" FontSize="12"/>
                                </Border>

                                <!-- Output -->
                                <TextBlock Text="OUTPUT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,3"/>
                                <TextBlock Text="{Binding Output}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontFamily="Consolas" FontSize="12"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Expander>
            </Border>
        </DataTemplate>

        <!-- Section header for the inline chat-settings menu. -->
        <Style x:Key="SettingsMenuSectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>

        <!-- Option row for the inline chat-settings menu: radio dot + label, checked row
             tinted with the accent so the current selection is obvious at a glance. -->
        <Style x:Key="SettingsOptionStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="8,5" Margin="0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Dot" Width="14" Height="14" CornerRadius="7"
                                        BorderBrush="{DynamicResource TextMutedBrush}" BorderThickness="1.5"
                                        Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Ellipse x:Name="DotFill" Width="8" Height="8" Fill="{DynamicResource AccentPrimaryBrush}" Visibility="Collapsed"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{TemplateBinding Content}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter TargetName="Dot" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
                                <Setter TargetName="DotFill" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Personality list rows: same radio-dot look as the option rows above. -->
        <Style x:Key="SettingsPersonalityItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="8,5" Margin="0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Dot" Width="14" Height="14" CornerRadius="7"
                                        BorderBrush="{DynamicResource TextMutedBrush}" BorderThickness="1.5"
                                        Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Ellipse x:Name="DotFill" Width="8" Height="8" Fill="{DynamicResource AccentPrimaryBrush}" Visibility="Collapsed"/>
                                </Border>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter TargetName="Dot" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
                                <Setter TargetName="DotFill" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left session-sidebar (chat list). Width/MinWidth are driven from code-behind
                 (0 when collapsed) so a collapsed sidebar does not reserve layout space. -->
            <ColumnDefinition x:Name="SessionSidebarColumn" Width="250" MinWidth="150" MaxWidth="600"/>
            <ColumnDefinition Width="*"/>
            <!-- Right-side chat panel (queue / files / changes / preview / terminal / notes).
                 Width is driven from code-behind (0 when the panel is closed) so a collapsed
                 panel does not reserve layout space. -->
            <ColumnDefinition x:Name="SidePanelColumn" Width="360" MinWidth="280" MaxWidth="720"/>
        </Grid.ColumnDefinitions>

        <!-- Session List Panel (visibility follows IsSessionSidebarOpen) -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0"
                Visibility="{Binding IsSessionSidebarOpen, Converter={StaticResource BoolToVisConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Button Margin="12,12,12,6" Command="{Binding CreateNewSessionCommand}" Background="Transparent" BorderThickness="0" Padding="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" CornerRadius="9" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderMidBrush}" BorderThickness="1" Padding="8" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Border.RenderTransform>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="+" Margin="0,0,8,0" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                    <TextBlock Text="New Chat" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
                                </Trigger>
                                <EventTrigger RoutedEvent="PreviewMouseDown">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.97" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.97" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="PreviewMouseUp">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <ListBox Grid.Row="1" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" Background="Transparent" BorderThickness="0" Margin="0,4,0,10" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="Margin" Value="7,2"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <Grid>
                                                <Border x:Name="SelBar" Width="3" CornerRadius="2" HorizontalAlignment="Left" Margin="-6,2,0,2" Background="{DynamicResource AccentPrimaryBrush}" Visibility="Collapsed"/>
                                                <ContentPresenter />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                                <Setter TargetName="SelBar" Property="Visibility" Value="Visible"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Background="Transparent">
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Toggle Pin" Command="{Binding DataContext.TogglePinSessionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                                        <MenuItem Header="Rename" Command="{Binding DataContext.BeginEditTitleCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                                        <MenuItem Header="Delete" Command="{Binding DataContext.DeleteSessionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Path x:Name="PinIcon" Grid.Column="0" Visibility="Collapsed" Data="M 4,2 L 8,2 L 8,6 L 10,8 L 10,10 L 7,10 L 7,14 L 6,15 L 5,14 L 5,10 L 2,10 L 2,8 L 4,6 Z" Fill="{DynamicResource AccentPrimaryBrush}" Width="10" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="TitleText" Text="{Binding Title}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <!-- Per-chat working indicator: a pulsing dot + live status next to
                                                 the title so it is obvious WHICH chat the model is currently
                                                 working on, including while the user is viewing another chat. -->
                                            <StackPanel x:Name="WorkingBadge" Orientation="Horizontal" Visibility="Collapsed" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <Ellipse Width="7" Height="7" Margin="0,0,5,0" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{DynamicResource AccentPrimaryBrush}"/>
                                                            <Setter Property="Opacity" Value="1"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsWorking}" Value="True">
                                                                    <DataTrigger.EnterActions>
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.6" AutoReverse="True" RepeatBehavior="Forever"/>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </DataTrigger.EnterActions>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding WorkingStatusText}" FontSize="11" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding WorkingModel, StringFormat=Model: {0}}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBox x:Name="TitleEdit" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Visibility="Collapsed" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="1" BorderBrush="{DynamicResource AccentPrimaryBrush}" Padding="2">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Return" Command="{Binding DataContext.CommitEditTitleCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                                                <KeyBinding Key="Esc" Command="{Binding DataContext.CancelEditTitleCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                                            </TextBox.InputBindings>
                                        </TextBox>
                                    </Grid>
                                    <TextBlock x:Name="PreviewText" Text="{Binding LastMessagePreview}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <!-- Action Buttons visible on hover -->
                                <StackPanel x:Name="ActionButtons" Grid.Column="2" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center" Margin="5,0,0,0">
                                    <Button ToolTip="Toggle Pin" Command="{Binding DataContext.TogglePinSessionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Padding="4" Margin="0,0,2,0" Cursor="Hand">
                                        <Path Data="M 4,2 L 8,2 L 8,6 L 10,8 L 10,10 L 7,10 L 7,14 L 6,15 L 5,14 L 5,10 L 2,10 L 2,8 L 4,6 Z" Fill="{DynamicResource TextSecondaryBrush}" Width="12" Height="12" Stretch="Uniform"/>
                                    </Button>
                                    <Button ToolTip="Rename" Command="{Binding DataContext.BeginEditTitleCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Padding="4" Margin="0,0,2,0" Cursor="Hand">
                                        <Path Data="M 1,11 L 4,14 L 14,4 L 11,1 Z M 1,14 L 1,11 L 4,14 Z" Fill="{DynamicResource TextSecondaryBrush}" Width="12" Height="12" Stretch="Uniform"/>
                                    </Button>
                                    <Button ToolTip="Delete" Command="{Binding DataContext.DeleteSessionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Padding="4" Cursor="Hand">
                                        <Path Data="M 3,3 L 11,3 M 5,3 L 5,1 L 9,1 L 9,3 M 4,3 L 4,13 C 4,14 5,14 5,14 L 9,14 C 9,14 10,14 10,13 L 10,3" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5" Fill="Transparent" Width="12" Height="12" Stretch="Uniform"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding LastMessagePreview}" Value="">
                                    <Setter TargetName="PreviewText" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding LastMessagePreview}" Value="{x:Null}">
                                    <Setter TargetName="PreviewText" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsEditingTitle}" Value="True">
                                    <Setter TargetName="TitleText" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="PreviewText" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="TitleEdit" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                    <Setter TargetName="PinIcon" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsWorking}" Value="True">
                                    <Setter TargetName="WorkingBadge" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="ActionButtons" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Sidebar Resizer (hidden when the sidebar is collapsed) -->
        <GridSplitter x:Name="SessionSidebarSplitter" Grid.Column="0" Width="6" HorizontalAlignment="Right" VerticalAlignment="Stretch" Cursor="SizeWE" Background="Transparent" Panel.ZIndex="10" Margin="0,0,-3,0"
                      Visibility="{Binding IsSessionSidebarOpen, Converter={StaticResource BoolToVisConverter}}">
            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Border Background="Transparent" Padding="2,0">
                        <Border x:Name="VisualIndicator" Background="Transparent" Width="2" HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="VisualIndicator" Property="Background" Value="{DynamicResource AccentPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="VisualIndicator" Property="Background" Value="{DynamicResource AccentPrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <!-- Right-side panel splitter -->
        <GridSplitter x:Name="SidePanelSplitter" Grid.Column="2" Width="6" HorizontalAlignment="Left" VerticalAlignment="Stretch" Cursor="SizeWE" Background="Transparent" Panel.ZIndex="10" Margin="-3,0,0,0">
            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Border Background="Transparent" Padding="0,2">
                        <Border x:Name="VisualIndicator" Background="Transparent" Width="2" HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="VisualIndicator" Property="Background" Value="{DynamicResource AccentPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="VisualIndicator" Property="Background" Value="{DynamicResource AccentPrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <!-- Right-side chat panel host (visibility follows SidePanel.IsPanelOpen) -->
        <views:ChatSidePanelView x:Name="SidePanelHost" Grid.Column="2"
                                 Visibility="{Binding SidePanel.IsPanelOpen, Converter={StaticResource BoolToVisConverter}}"/>

        <!-- Chat Area -->
        <!-- The whole chat area (header + transcript + composer) is a drop target for files,
             folders and images dragged in from outside the app — they become context
             attachments. A dashed overlay signals the gesture while dragging. -->
        <Grid x:Name="ChatAreaGrid" Grid.Column="1" AllowDrop="True"
              PreviewDragEnter="ChatAreaGrid_PreviewDragEnter"
              PreviewDragOver="ChatAreaGrid_PreviewDragOver"
              DragLeave="ChatAreaGrid_DragLeave"
              PreviewDrop="ChatAreaGrid_PreviewDrop">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top Bar -->
            <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Background="{DynamicResource PanelBackgroundBrush}">
                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <!-- Collapse/expand toggle for the left session sidebar. The chevron
                             points left when the list is open, right when collapsed. -->
                        <ToggleButton IsChecked="{Binding IsSessionSidebarOpen, Mode=TwoWay}"
                                      ToolTip="Show / hide the session list"
                                      Width="28" Height="28" Padding="0" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                      VerticalAlignment="Center" Margin="0,0,6,0">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ToggleButton.Style>
                            <Path Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="11" Height="12" Stretch="Uniform"
                                  Data="M 8,2 L 3,7 L 8,12">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="False">
                                                <Setter Property="Data" Value="M 3,2 L 8,7 L 3,12"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </ToggleButton>
                        <Grid VerticalAlignment="Center">
                        <StackPanel x:Name="HeaderTitleDisplay" Orientation="Horizontal" Background="Transparent"
                                    ToolTip="Click to rename this chat" Cursor="Hand">
                            <StackPanel.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding BeginEditTitleCommand}" CommandParameter="{Binding SelectedSession}"/>
                            </StackPanel.InputBindings>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedSession.IsEditingTitle}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{Binding SessionTitle}" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="520"/>
                            <!-- Live working indicator for the open chat: pulsing dot + status, so
                                 the model's current state stays visible in the chat itself after
                                 switching between conversations. -->
                            <StackPanel x:Name="HeaderWorkingBadge" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedSession.IsWorking}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource AccentPrimaryBrush}"/>
                                            <Setter Property="Opacity" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedSession.IsWorking}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.6" AutoReverse="True" RepeatBehavior="Forever"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding SelectedSession.WorkingStatusText}" FontSize="12" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedSession.WorkingModel, StringFormat=Model: {0}}"/>
                            </StackPanel>
                            <Path Data="M 1,11 L 4,14 L 14,4 L 11,1 Z M 1,14 L 1,11 L 4,14 Z" Fill="{DynamicResource TextMutedBrush}"
                                  Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="8,1,0,0">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Opacity" Value="0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=HeaderTitleDisplay}" Value="True">
                                                <Setter Property="Opacity" Value="0.7"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </StackPanel>
                        <TextBox x:Name="HeaderTitleEdit" Text="{Binding SelectedSession.Title, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="15" FontWeight="SemiBold" MinWidth="220" MaxWidth="520" Padding="6,3"
                                 MaxLines="1" MaxHeight="36"
                                 VerticalAlignment="Center" VerticalContentAlignment="Center"
                                 IsVisibleChanged="HeaderTitleEdit_IsVisibleChanged" LostFocus="HeaderTitleEdit_LostFocus">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding CommitEditTitleCommand}" CommandParameter="{Binding SelectedSession}"/>
                                <KeyBinding Key="Esc" Command="{Binding CancelEditTitleCommand}" CommandParameter="{Binding SelectedSession}"/>
                            </TextBox.InputBindings>
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedSession.IsEditingTitle}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Command="{Binding ExportChatCommand}" 
                                ToolTip="Export Chat Log" Background="Transparent" BorderThickness="0"
                                Padding="8,4" Cursor="Hand" VerticalAlignment="Center">
                            <Grid>
                                <Path Data="M 14,14 L 2,14 M 8,2 L 8,11 M 4,7 L 8,11 L 12,7" 
                                      Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5" Fill="Transparent"
                                      Width="14" Height="14" Stretch="Uniform"/>
                            </Grid>
                        </Button>

                        <!-- Right-side panel toggle (Queue / Files / Changes / Preview /
                             Terminal / Notes). ToggleButton bound TwoWay so the panel stays
                             open/closed as the user left it. -->
                        <ToggleButton IsChecked="{Binding SidePanel.IsPanelOpen, Mode=TwoWay}" 
                                      ToolTip="Show / hide the workbench panel (queue, files, changes, preview, terminal, notes)"
                                      Padding="8,4" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                      VerticalAlignment="Center" Margin="2,0,0,0">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ToggleButton.Style>
                            <Path Data="M 4,2 L 4,14 M 9,2 L 9,14 M 14,2 L 14,14" 
                                  Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Opacity" Value="0.55"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                                <Setter Property="Opacity" Value="1"/>
                                                <Setter Property="Stroke" Value="{DynamicResource AccentPrimaryBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </ToggleButton>
                    </StackPanel>

                </Grid>
            </Border>

            <!-- Message List -->
            <Grid Grid.Row="1">
                <ListBox x:Name="MessagesList" ItemsSource="{Binding Messages}"
                          Background="Transparent" BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.ScrollChanged="ScrollViewer_ScrollChanged"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          PreviewMouseWheel="MessagesList_PreviewMouseWheel"
                          Padding="0">
                    <!-- Standard (non-recycling) virtualization deliberately, even though
                         it re-creates containers on scroll: Recycling mode reuses a
                         MarkdownScrollViewer across different messages, and that container's
                         Engine/MarkdownViewer_Loaded re-parse logic doesn't repeat on reuse -
                         which let a recycled container end up showing stale or blank content
                         during fast scroll. Correctness over the extra re-creation cost.
                         No per-item entrance animation either: it used to replay on every
                         freshly-created container as items scrolled into view, reading as
                         janky, unresponsive scrolling. -->
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- Grid stretches to fill available width -->
                            <Grid Margin="20,1">
                                <!-- User Message -->
                                <Grid Visibility="{Binding Role, Converter={StaticResource RoleToVisibilityConverter}, ConverterParameter=user}">
                                    <!-- Normal View -->
                                    <Border CornerRadius="14,14,4,14" Padding="14,8" HorizontalAlignment="Right" Margin="100,8,0,8"
                                            Background="{DynamicResource UserBubbleBackgroundBrush}" BorderThickness="0"
                                            Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisConverter}}">
                                        <DockPanel LastChildFill="True">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,0,0,0">
                                                <Button Command="{Binding BeginEditCommand}" 
                                                        Foreground="{DynamicResource UserBubbleTextBrush}"
                                                        Style="{StaticResource ChatActionButtonStyle}"
                                                        ToolTip="Edit and resubmit">
                                                    <Grid>
                                                        <Path Data="M 12.2,2.8 C 12.7,2.3 13.5,2.3 14,2.8 L 15.2,4 C 15.7,4.5 15.7,5.3 15.2,5.8 L 5,16 L 2,16 L 2,13 L 12.2,2.8 Z M 14.5,4.5 L 13.5,3.5 M 4,14 L 5.5,14 L 13.5,6 L 12,4.5 L 4,12.5 Z"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                              StrokeThickness="1.2" Width="14" Height="14" Stretch="Uniform"/>
                                                    </Grid>
                                                </Button>
                                                <Button Command="{Binding CopyToClipboardCommand}"
                                                        Foreground="{DynamicResource UserBubbleTextBrush}"
                                                        Style="{StaticResource ChatActionButtonStyle}"
                                                        ToolTip="Copy message"
                                                        Margin="5,0,0,0">
                                                    <Grid>
                                                        <Path Data="M 2,5 L 2,14 L 11,14 M 5,2 L 14,2 L 14,11 L 5,11 Z"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                              StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform"
                                                              Visibility="{Binding IsCopied, Converter={StaticResource InverseBoolToVisConverter}}"/>
                                                        <Path Data="M 3,8 L 6,11 L 13,3"
                                                              Stroke="{DynamicResource SuccessBrush}"
                                                              StrokeThickness="2" Width="14" Height="14" Stretch="Uniform"
                                                              Visibility="{Binding IsCopied, Converter={StaticResource BoolToVisConverter}}"/>
                                                    </Grid>
                                                </Button>
                                            </StackPanel>                                             <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Content}" Foreground="{DynamicResource UserBubbleTextBrush}"
                                                           TextWrapping="Wrap" FontSize="15" LineHeight="22"/>
                                                
                                                <!-- Message Attachments Display -->
                                                <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,8,0,0"
                                                              Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVisConverter}}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#20FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="6" Margin="0,0,6,6" Padding="6,4">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Image Source="{Binding Thumbnail}" MaxWidth="160" MaxHeight="120" Stretch="Uniform" Margin="0,0,6,0">
                                                                        <Image.Style>
                                                                            <Style TargetType="Image">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Image.Style>
                                                                    </Image>
                                                                    <TextBlock Text="{Binding IconSymbol}" FontSize="14" Margin="0,0,4,0" VerticalAlignment="Center">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                    <StackPanel VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding FileName}" MaxWidth="160" TextTrimming="CharacterEllipsis" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource UserBubbleTextBrush}"/>
                                                                        <TextBlock Text="{Binding SizeDisplay}" FontSize="10" Foreground="{DynamicResource UserBubbleTextBrush}" Opacity="0.8"/>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    
                                    <!-- Edit View -->
                                    <Border CornerRadius="8" Padding="14,10" HorizontalAlignment="Right" Margin="100,4,0,4" MinWidth="400"
                                            Background="{DynamicResource SurfaceBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                                            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisConverter}}">
                                        <StackPanel>
                                            <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}" 
                                                     TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60"
                                                     Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                                                     BorderThickness="0" FontSize="15" Padding="0,0,0,10"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                                <Button Content="Cancel" Command="{Binding CancelEditCommand}" 
                                                        Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}"
                                                        BorderThickness="0" Margin="0,0,8,0" Padding="12,6" Cursor="Hand"/>
                                                <Button Content="Save &amp; Submit"
                                                        Command="{Binding DataContext.SubmitEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Background="{DynamicResource AccentPrimaryBrush}" Foreground="{DynamicResource TextInverse}"
                                                        BorderThickness="0" Padding="16,6" Cursor="Hand">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Thought (Thinking) Message -->
                                <Border CornerRadius="10" Padding="0" HorizontalAlignment="Left" Margin="0,1,100,1"
                                        Visibility="{Binding Role, Converter={StaticResource RoleToVisibilityConverter}, ConverterParameter=thought}">
                                    <Expander Style="{StaticResource PremiumThinkingExpanderStyle}" IsExpanded="{Binding IsThinkingExpanded}"
                                              Foreground="{DynamicResource TextMutedBrush}" FontSize="12">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Thinking" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center"/>
                                                <Ellipse Style="{StaticResource PulsingDotStyle}" Width="5" Height="5" Margin="7,1,0,0" VerticalAlignment="Center"
                                                         Visibility="{Binding IsStreaming, Converter={StaticResource BoolToVisConverter}}"/>
                                            </StackPanel>
                                        </Expander.Header>
                                        <Border Background="{DynamicResource ThinkingBubbleBackgroundBrush}"
                                                BorderBrush="{DynamicResource AccentSoftBrush}" BorderThickness="2,0,0,0"
                                                Padding="12,8" CornerRadius="0,8,8,0" Margin="4,4,0,0">
                                            <mdxam:MarkdownScrollViewer Markdown="{Binding RenderedContent}"
                                                                        MaxHeight="320"
                                                                        VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                                                        TextElement.Foreground="{DynamicResource TextSecondaryBrush}"
                                                                        FontSize="12.5" Margin="0" Padding="0"
                                                                        Loaded="MarkdownViewer_Loaded"/>
                                        </Border>
                                    </Expander>
                                </Border>

                                <!-- Live Tool Call Card(s) -->
                                <ItemsControl ItemsSource="{Binding ToolCalls}" ItemTemplate="{StaticResource ToolCallTemplate}"
                                              HorizontalAlignment="Left" Margin="0,0,100,0"
                                              Visibility="{Binding Role, Converter={StaticResource RoleToVisibilityConverter}, ConverterParameter=toolcall}"/>

                                <!-- Historic Tool Output -->
                                <Border CornerRadius="10" Padding="12,6" HorizontalAlignment="Left" Margin="0,1,100,1"
                                        Background="{DynamicResource ToolBubbleBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                                        Visibility="{Binding Role, Converter={StaticResource RoleToVisibilityConverter}, ConverterParameter=tool}">
                                    <Expander Style="{StaticResource PremiumThinkingExpanderStyle}" Foreground="{DynamicResource TextSecondaryBrush}" IsExpanded="False">
                                        <Expander.Header>
                                            <TextBlock Text="Tool output" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                        </Expander.Header>
                                        <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,6,0,2">
                                            <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="Consolas" FontSize="12"/>
                                        </ScrollViewer>
                                    </Expander>
                                </Border>

                                <!-- System Message -->
                                <Border CornerRadius="20" Padding="14,5" MaxWidth="800" HorizontalAlignment="Center" Margin="0,2"
                                        Background="{DynamicResource SurfaceBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                                        Visibility="{Binding Role, Converter={StaticResource RoleToVisibilityConverter}, ConverterParameter=system}">
                                    <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Center" FontSize="12"/>
                                </Border>

                                <!-- Error Message -->
                                <Border CornerRadius="10" Padding="14,8" HorizontalAlignment="Left" Margin="0,2,100,2"
                                        Background="{DynamicResource ErrorBubbleBackgroundBrush}" BorderThickness="3,0,0,0" BorderBrush="{DynamicResource ErrorBrush}"
                                        Visibility="{Binding Role, Converter={StaticResource RoleToVisibilityConverter}, ConverterParameter=error}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Data="M 8,1 L 15,14 L 1,14 Z M 8,6 L 8,10 M 8,12 L 8,12.01" Stroke="{DynamicResource ErrorBrush}" StrokeThickness="1.5"
                                              Width="15" Height="14" Stretch="Uniform" VerticalAlignment="Top" Margin="0,2,10,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Content}" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}" FontSize="12.5"/>
                                    </Grid>
                                </Border>

                                <!-- Generating indicator: breathing K badge + cycling status words, Claude-style -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="4,4"
                                            Visibility="{Binding Role, Converter={StaticResource RoleToVisibilityConverter}, ConverterParameter=typing}">
                                    <Border Width="22" Height="22" CornerRadius="7" Background="{DynamicResource AccentSoftBrush}"
                                            VerticalAlignment="Center" Margin="0,0,9,0" RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                                        </Border.RenderTransform>
                                        <Border.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                         From="1" To="1.18" Duration="0:0:0.85">
                                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                         From="1" To="1.18" Duration="0:0:0.85">
                                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="0.75" To="1" Duration="0:0:0.85">
                                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Border.Triggers>
                                        <TextBlock Text="K" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock x:Name="GeneratingWord" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" Text="Thinking…">
                                        <TextBlock.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever" Duration="0:0:10.5">
                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Text">
                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0">
                                                                <DiscreteObjectKeyFrame.Value><sys:String>Thinking…</sys:String></DiscreteObjectKeyFrame.Value>
                                                            </DiscreteObjectKeyFrame>
                                                            <DiscreteObjectKeyFrame KeyTime="0:0:2.1">
                                                                <DiscreteObjectKeyFrame.Value><sys:String>Weaving…</sys:String></DiscreteObjectKeyFrame.Value>
                                                            </DiscreteObjectKeyFrame>
                                                            <DiscreteObjectKeyFrame KeyTime="0:0:4.2">
                                                                <DiscreteObjectKeyFrame.Value><sys:String>Conjuring…</sys:String></DiscreteObjectKeyFrame.Value>
                                                            </DiscreteObjectKeyFrame>
                                                            <DiscreteObjectKeyFrame KeyTime="0:0:6.3">
                                                                <DiscreteObjectKeyFrame.Value><sys:String>Distilling…</sys:String></DiscreteObjectKeyFrame.Value>
                                                            </DiscreteObjectKeyFrame>
                                                            <DiscreteObjectKeyFrame KeyTime="0:0:8.4">
                                                                <DiscreteObjectKeyFrame.Value><sys:String>Composing…</sys:String></DiscreteObjectKeyFrame.Value>
                                                            </DiscreteObjectKeyFrame>
                                                        </ObjectAnimationUsingKeyFrames>
                                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                                            <LinearDoubleKeyFrame KeyTime="0:0:0.3" Value="1"/>
                                                            <LinearDoubleKeyFrame KeyTime="0:0:1.8" Value="1"/>
                                                            <LinearDoubleKeyFrame KeyTime="0:0:2.1" Value="0"/>
                                                            <LinearDoubleKeyFrame KeyTime="0:0:2.4" Value="1"/>
                                                            <LinearDoubleKeyFrame KeyTime="0:0:3.9" Value="1"/>
                                                            <LinearDoubleKeyFrame KeyTime="0:0:4.2" Value="0"/>
                                                            <LinearDoubleKeyFrame KeyTime="0:0:4.5" Value="1"/>
                                                            <LinearDoubleKeyFrame KeyTime="0:0:6" Value="1"/>
                                                            <LinearDoubleKeyFrame KeyTime="0:0:6.3" Value="0"/>
                                                            <LinearDoubleKeyFrame KeyTime="0:0:6.6" Value="1"/>
                                                            <LinearDoubleKeyFrame KeyTime="0:0:8.1" Value="1"/>
                                                            <LinearDoubleKeyFrame KeyTime="0:0:8.4" Value="0"/>
                                                            <LinearDoubleKeyFrame KeyTime="0:0:8.7" Value="1"/>
                                                            <LinearDoubleKeyFrame KeyTime="0:0:10.2" Value="1"/>
                                                            <LinearDoubleKeyFrame KeyTime="0:0:10.5" Value="0"/>
                                                        </DoubleAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </TextBlock.Triggers>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Assistant Message — bubble-less model output: no background,
                                     no border, minimal padding, so the reply reads as plain text
                                     directly on the chat surface (cleaner, more minimal). -->
                                <Border Padding="2,0" HorizontalAlignment="Left" Margin="0,2,100,2"
                                        Background="Transparent" BorderThickness="0"
                                        TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
                                        TextElement.FontSize="15"
                                        Visibility="{Binding Role, Converter={StaticResource RoleToVisibilityConverter}, ConverterParameter=assistant}">
                                    <DockPanel LastChildFill="True">
                                        <Button DockPanel.Dock="Right" Command="{Binding CopyToClipboardCommand}"
                                                Foreground="{DynamicResource TextSecondaryBrush}"
                                                Style="{StaticResource ChatActionButtonStyle}"
                                                VerticalAlignment="Top"
                                                Margin="10,0,0,0"
                                                ToolTip="Copy message">
                                            <Grid>
                                                <Path Data="M 2,5 L 2,14 L 11,14 M 5,2 L 14,2 L 14,11 L 5,11 Z"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform"
                                                      Visibility="{Binding IsCopied, Converter={StaticResource InverseBoolToVisConverter}}"/>
                                                <Path Data="M 3,8 L 6,11 L 13,3"
                                                      Stroke="{DynamicResource SuccessBrush}"
                                                      StrokeThickness="2" Width="14" Height="14" Stretch="Uniform"
                                                      Visibility="{Binding IsCopied, Converter={StaticResource BoolToVisConverter}}"/>
                                            </Grid>
                                        </Button>
                                        <StackPanel>
                                            <mdxam:MarkdownScrollViewer Markdown="{Binding RenderedContent}"
                                                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                                                        TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
                                                                        HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" Margin="0" Padding="0" FontSize="15"
                                                                        Loaded="MarkdownViewer_Loaded"/>
                                            <Rectangle Width="8" Height="14" Fill="{DynamicResource AccentPrimaryBrush}" HorizontalAlignment="Left" Margin="0,2,0,0"
                                                       Visibility="{Binding IsStreaming, Converter={StaticResource BoolToVisConverter}}">
                                                <Rectangle.Style>
                                                    <Style TargetType="Rectangle">
                                                        <Style.Triggers>
                                                            <EventTrigger RoutedEvent="Loaded">
                                                                <BeginStoryboard>
                                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.15" Duration="0:0:0.45"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </EventTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Rectangle.Style>
                                            </Rectangle>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Empty state -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Messages.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Border Width="64" Height="64" CornerRadius="18" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center">
                        <TextBlock Text="K" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Start a conversation" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,16,0,4"/>
                    <TextBlock Text="Pick a model below and send your first message." FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Scroll To Bottom Floating Button -->
                <Button x:Name="ScrollToBottomButton"
                        Click="ScrollToBottomButton_Click"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,16"
                        Width="38" Height="38"
                        Cursor="Hand"
                        ToolTip="Scroll to bottom"
                        Visibility="Collapsed"
                        Panel.ZIndex="10">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="BtnBorder"
                                        Background="{DynamicResource SurfaceElevatedBrush}"
                                        BorderBrush="{DynamicResource BorderMidBrush}"
                                        BorderThickness="1"
                                        CornerRadius="19"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                    </Border.RenderTransform>
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.35"/>
                                    </Border.Effect>
                                    <Path x:Name="BtnIcon"
                                          Data="M 12,4 L 12,15 M 6,10 L 12,16 L 18,10 M 5,19 L 19,19"
                                          Stroke="{DynamicResource TextPrimaryBrush}"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Width="16" Height="16"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Border>

                                <!-- Unread Notification Badge Dot -->
                                <Ellipse x:Name="UnreadBadge"
                                         Width="10" Height="10"
                                         Fill="{DynamicResource AccentPrimaryBrush}"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Top"
                                         Margin="0,0,0,0"
                                         Visibility="Collapsed">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#007ACC" Opacity="0.85"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                    <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
                                    <Setter TargetName="BtnIcon" Property="Stroke" Value="{DynamicResource AccentPrimaryBrush}"/>
                                </Trigger>
                                <EventTrigger RoutedEvent="PreviewMouseDown">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BtnBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.92" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="BtnBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.92" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="PreviewMouseUp">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BtnBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="BtnBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Input Area -->
            <Border Grid.Row="2" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,12">
                <StackPanel>
                    <!-- Working-elsewhere notice: shown when the model is generating in a
                         DIFFERENT chat than the one displayed, so this chat never looks frozen
                         or broken — the user can see exactly where the model is and that their
                         next message here will be queued until it finishes. -->
                    <Border Background="{DynamicResource SurfaceElevatedBrush}"
                            BorderBrush="{DynamicResource AccentSoftBrush}"
                            BorderThickness="1" CornerRadius="8" Margin="0,0,0,10" Padding="10,8"
                            Visibility="{Binding IsWorkingElsewhere, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{DynamicResource AccentPrimaryBrush}"/>
                            <TextBlock Text="{Binding WorkingElsewhereText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Pending Attachments Preview Panel -->
                    <Border Visibility="{Binding HasPendingAttachments, Converter={StaticResource BoolToVisConverter}}"
                            Background="{DynamicResource SurfaceElevatedBrush}"
                            BorderBrush="{DynamicResource BorderMidBrush}"
                            BorderThickness="1" CornerRadius="8" Margin="0,0,0,10" Padding="10,8">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📎 Context Attachments:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="10" Padding="6,1.5" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PendingAttachments.Count, StringFormat='{}{0} item(s)'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                    </Border>
                                </StackPanel>
                                <Button DockPanel.Dock="Right" Style="{DynamicResource GhostButton}" Command="{Binding ClearPendingAttachmentsCommand}" ToolTip="Remove all attachments" VerticalAlignment="Center" Padding="6,3">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="✕ Clear All" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                </Button>
                            </DockPanel>

                            <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                <ItemsControl ItemsSource="{Binding PendingAttachments}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource InputBackgroundBrush}"
                                                    BorderBrush="{DynamicResource BorderMidBrush}"
                                                    BorderThickness="1" CornerRadius="8" Margin="0,0,8,8" Padding="6,4">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Image Source="{Binding Thumbnail}" Width="24" Height="24" Stretch="UniformToFill" Margin="0,0,6,0" VerticalAlignment="Center">
                                                        <Image.Style>
                                                            <Style TargetType="Image">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Image.Style>
                                                    </Image>
                                                    <TextBlock Text="{Binding IconSymbol}" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding FileName}" MaxWidth="140" TextTrimming="CharacterEllipsis" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <TextBlock Text="{Binding SizeDisplay}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                                    </StackPanel>
                                                    <Button Style="{DynamicResource QueueItemCloseButton}" Command="{Binding RemoveCommand}" ToolTip="Remove attachment" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Bottom">
                            <!-- Plus Sign (+) Context Menu Button -->
                            <Button x:Name="AddContextButton"
                                    Click="AddContextButton_Click"
                                    Width="40" Height="40" Margin="0,0,6,0"
                                    Style="{DynamicResource SecondaryButton}"
                                    ToolTip="Add Attachments, Screenshots &amp; Context (+)">
                                <Button.ContextMenu>
                                    <ContextMenu x:Name="ContextAddMenu" Background="{DynamicResource SurfaceElevatedBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
                                        <MenuItem Header="📷 Take Screenshot" Command="{Binding CaptureScreenshotCommand}"/>
                                        <Separator/>
                                        <MenuItem Header="📁 Attach Files or Code" Command="{Binding AttachFilesCommand}"/>
                                        <MenuItem Header="🖼️ Attach Image" Command="{Binding AttachImageCommand}"/>
                                        <MenuItem Header="🎙️ Attach Audio Clip" Command="{Binding AttachAudioCommand}"/>
                                        <Separator/>
                                        <MenuItem Header="📝 Add Text or Code Snippet" Command="{Binding AddTextContextCommand}"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <!-- Was a plain text "+" glyph (font metrics don't center the
                                     crossbar of "+" on the true vertical middle) then a Path
                                     with Stroke+Stretch (Path.Stretch normalizes off the raw
                                     geometry bounds, not the stroked/round-capped bounds, so a
                                     2px stroke with round caps rendered visibly off-center at
                                     this small a size - it read as a dagger, not a plus). Two
                                     independently-centered filled Rectangles sidestep both
                                     problems entirely: each bar is trivially centered by
                                     alignment alone, no stroke/stretch math involved. -->
                                <Canvas Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Rectangle Canvas.Left="7.75" Canvas.Top="1" Width="2.5" Height="16" RadiusX="1.25" RadiusY="1.25" Fill="{DynamicResource AccentPrimaryBrush}"/>
                                    <Rectangle Canvas.Left="1" Canvas.Top="7.75" Width="16" Height="2.5" RadiusX="1.25" RadiusY="1.25" Fill="{DynamicResource AccentPrimaryBrush}"/>
                                </Canvas>
                            </Button>
                            <!-- Single inline chat-settings menu: tool risk + message mode +
                                 personality in one popup, all applied instantly (no restart). -->
                            <Button x:Name="ChatSettingsButton" Click="ChatSettingsButton_Click"
                                    Height="40" Padding="10,0" Margin="0,0,6,0"
                                    Style="{DynamicResource SecondaryButton}"
                                    ToolTip="Chat settings — tool risk, message mode, and personality (apply instantly)">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⚙ " FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding CurrentSettingsSummary}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Button>

                            <Popup x:Name="ChatSettingsPopup"
                                   Placement="Top" StaysOpen="False" AllowsTransparency="True"
                                   VerticalOffset="-4">
                                <Border Background="{DynamicResource SurfaceElevatedBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10"
                                        Padding="10,8" MaxHeight="440">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.5"/>
                                    </Border.Effect>
                                    <StackPanel Width="240">
                                        <TextBlock Text="TOOL RISK" Style="{StaticResource SettingsMenuSectionHeader}" Margin="0,2,0,4"/>
                                        <TextBlock Text="Controls whether tool calls execute or request approval." FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,2"/>
                                        <RadioButton Content="Safe" Style="{StaticResource SettingsOptionStyle}" GroupName="ChatSettingsRisk"
                                                     IsChecked="{Binding SelectedRiskLevel, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Safe}"/>
                                        <RadioButton Content="Standard" Style="{StaticResource SettingsOptionStyle}" GroupName="ChatSettingsRisk"
                                                     IsChecked="{Binding SelectedRiskLevel, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Standard}"/>
                                        <RadioButton Content="AutoPilot" Style="{StaticResource SettingsOptionStyle}" GroupName="ChatSettingsRisk"
                                                     IsChecked="{Binding SelectedRiskLevel, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=AutoPilot}"/>

                                        <TextBlock Text="MESSAGE MODE" Style="{StaticResource SettingsMenuSectionHeader}"/>
                                        <TextBlock Text="How queued messages are handled: Steer lets the model pick the moment to incorporate them." FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,2"/>
                                        <RadioButton Content="Steer" Style="{StaticResource SettingsOptionStyle}" GroupName="ChatSettingsMode"
                                                     IsChecked="{Binding SelectedQueueMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Steer}"/>
                                        <RadioButton Content="Direct Send" Style="{StaticResource SettingsOptionStyle}" GroupName="ChatSettingsMode"
                                                     IsChecked="{Binding SelectedQueueMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=DirectSend}"/>

                                        <TextBlock Text="PERSONALITY" Style="{StaticResource SettingsMenuSectionHeader}"/>
                                        <TextBlock Text="Switches the model's output style for the next generation." FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,2"/>
                                        <ListBox ItemsSource="{Binding AvailablePersonalities}"
                                                 SelectedItem="{Binding SelectedPersonality}"
                                                 MaxHeight="150" Background="Transparent" BorderThickness="0"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource SettingsPersonalityItem}"/>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </StackPanel>

                        <Grid Grid.Column="1">
                            <TextBox x:Name="InputTextBox" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                     MinLines="1" MaxLines="6" TextWrapping="Wrap" AcceptsReturn="True"
                                     PreviewKeyDown="InputTextBox_PreviewKeyDown"
                                     AllowDrop="False"
                                     Background="{DynamicResource InputBackgroundBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderThickness="1" BorderBrush="{DynamicResource BorderMidBrush}"
                                     Padding="12,10,12,10" VerticalContentAlignment="Center"
                                     VerticalScrollBarVisibility="Auto" FontSize="15"/>

                            <!-- State-aware placeholder -->
                            <TextBlock IsHitTestVisible="False" Margin="42,0,0,0" VerticalAlignment="Center" FontSize="15"
                                       Foreground="{DynamicResource TextMutedBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Setter Property="Text" Value="Message Klydis…"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsModelReady}" Value="False">
                                                <Setter Property="Text" Value="Load a model below to start chatting"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsModelLoading}" Value="True">
                                                <Setter Property="Text" Value="Model is loading — you can type while you wait…"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsGenerating}" Value="True">
                                                <Setter Property="Text" Value="Klydis is responding… (Press Enter to queue)"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Text, ElementName=InputTextBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!-- Shortcut hint: only while focused and empty -->
                            <TextBlock Text="Shift+Enter for new line" IsHitTestVisible="False"
                                       Margin="0,0,14,0" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}" Opacity="0.7">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsKeyboardFocused, ElementName=InputTextBox}" Value="True"/>
                                                    <Condition Binding="{Binding Text, ElementName=InputTextBox}" Value=""/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <StackPanel Grid.Column="2" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="10,0,0,0">
                            <Button Style="{DynamicResource SecondaryButton}" Command="{Binding EnqueueMessageCommand}" Height="40" Padding="8,0" Margin="0,0,6,0" ToolTip="Add message to processing queue">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="+ Queue" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource PrimaryButton}" Command="{Binding SendMessageCommand}" Visibility="{Binding IsGenerating, Converter={StaticResource InverseBoolToVisConverter}}" Width="40" Height="40" Background="{DynamicResource AccentPrimaryBrush}" BorderThickness="0" Padding="0" ToolTip="Send (Enter)">
                                <Path Data="M 2,8 L 13,8 M 8,3 L 13,8 L 8,13" Stroke="{DynamicResource TextInverse}" StrokeThickness="2" Width="15" Height="14" Stretch="Uniform" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Button>
                            <Button Style="{DynamicResource SecondaryButton}" Command="{Binding ForceSendMessageCommand}" Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVisConverter}}" Height="40" Padding="8,0" Margin="0,0,6,0" ToolTip="Interrupt active generation and force send message (Ctrl+Enter)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚡ Interrupt" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource PrimaryButton}" Command="{Binding CancelCommand}" Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVisConverter}}" Width="40" Height="40" Background="{DynamicResource ErrorBubbleBackgroundBrush}" BorderThickness="0" Padding="0" ToolTip="Stop generating">
                                <Rectangle Width="12" Height="12" RadiusX="2" RadiusY="2" Fill="{DynamicResource ErrorBrush}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- In-App Modal Overlay for Tool Approvals & Alerts -->
            <Grid Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="1000">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsApprovalPending}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsAlertPending}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.InputBindings>
                    <KeyBinding Key="Esc" Command="{Binding DenyToolCommand}"/>
                    <KeyBinding Key="Return" Command="{Binding ApproveToolCommand}"/>
                </Grid.InputBindings>

                <!-- Semi-transparent Dimmed Backdrop -->
                <Border Background="#70000000">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <!-- Tool Approval Modal Card (Emerges from User Input Section) -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Margin="24,0,24,18" Width="540" MaxWidth="640"
                        Background="{DynamicResource SurfaceElevatedBrush}"
                        BorderBrush="{DynamicResource BorderMidBrush}"
                        BorderThickness="1" CornerRadius="16"
                        Padding="22,18">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsApprovalPending}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.5"/>
                    </Border.Effect>

                    <StackPanel>
                        <!-- Header with Icon & Title -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="12" 
                                    Background="{DynamicResource AccentSoftBrush}" Margin="0,0,14,0">
                                <Path Data="M 12,2 L 22,6 V 12 C 22,17.5 17.5,21.8 12,23 C 6.5,21.8 2,17.5 2,12 V 6 Z M 12,8 V 13 M 12,16 V 17"
                                      Stroke="{DynamicResource AccentPrimaryBrush}" StrokeThickness="2" 
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PendingApprovalTitle}" FontSize="16" FontWeight="Bold" 
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Action requires your confirmation before proceeding" FontSize="12" 
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Tool Content Area -->
                        <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" 
                                BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Requested Tool:" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="8,3">
                                        <TextBlock Text="{Binding PendingToolName}" FontSize="12.5" FontWeight="Bold" 
                                                   Foreground="{DynamicResource AccentPrimaryBrush}" FontFamily="Consolas, Cascadia Code, Courier New, monospace"/>
                                    </Border>
                                </StackPanel>
                                
                                <TextBlock Text="{Binding PendingApprovalMessage}" FontSize="13.5" TextWrapping="Wrap" 
                                           Foreground="{DynamicResource TextPrimaryBrush}" LineHeight="18" Margin="0,2,0,6"/>

                                <!-- Arguments Detail Box -->
                                <Border Margin="0,6,0,0" Padding="10,8" Background="{DynamicResource PanelBackgroundBrush}" 
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                                        Visibility="{Binding PendingToolArguments, Converter={StaticResource StringToVisibilityConverter}}">
                                    <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                                        <TextBlock Text="{Binding PendingToolArguments}" FontSize="11.5" TextWrapping="Wrap" 
                                                   Foreground="{DynamicResource TextSecondaryBrush}" 
                                                   FontFamily="Consolas, Cascadia Code, Courier New, monospace"/>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Action Buttons -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Press Esc to Deny • Enter to Allow" 
                                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}" 
                                       VerticalAlignment="Center" Opacity="0.75"/>

                            <Button Grid.Column="1" Command="{Binding DenyToolCommand}" Style="{DynamicResource SecondaryButton}" 
                                    Content="Deny" Width="90" Margin="0,0,10,0" Height="36"/>
                            <Button Grid.Column="2" Command="{Binding ApproveToolCommand}" Style="{DynamicResource PrimaryButton}" 
                                    Content="Allow Operation" Width="140" Height="36"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Alert Modal Card -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Margin="24,0,24,18" Width="480" MaxWidth="580"
                        Background="{DynamicResource SurfaceElevatedBrush}"
                        BorderBrush="{DynamicResource BorderMidBrush}"
                        BorderThickness="1" CornerRadius="16"
                        Padding="22,18">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAlertPending}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.5"/>
                    </Border.Effect>

                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="12" 
                                    Background="{DynamicResource AccentSoftBrush}" Margin="0,0,14,0">
                                <Path Data="M 12,2 C 6.48,2 2,6.48 2,12 C 2,17.52 6.48,22 12,22 C 17.52,22 22,17.52 22,12 C 22,6.48 17.52,2 12,2 Z M 13,17 L 11,17 L 11,15 L 13,15 L 13,17 Z M 13,13 L 11,13 L 11,7 L 13,7 L 13,13 Z"
                                      Fill="{DynamicResource WarningBrush}"
                                      Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding AlertTitle}" FontSize="16" FontWeight="Bold" 
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Grid>

                        <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" 
                                BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,16">
                            <TextBlock Text="{Binding AlertMessage}" FontSize="13.5" TextWrapping="Wrap" 
                                       Foreground="{DynamicResource TextPrimaryBrush}" LineHeight="18"/>
                        </Border>

                        <Button HorizontalAlignment="Right" Command="{Binding CloseAlertModalCommand}" Style="{DynamicResource PrimaryButton}" 
                                Content="OK" Width="100" Height="36"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Drag & drop overlay: appears while files / folders / images are dragged over
                 the chat area. Non-interactive (IsHitTestVisible=False) so it never steals
                 input; the drop lands on the underlying ChatAreaGrid handlers. -->
            <Border x:Name="DropOverlay" Grid.RowSpan="3" Panel.ZIndex="5000"
                    IsHitTestVisible="False" Visibility="Collapsed"
                    Background="{DynamicResource PanelBackgroundBrush}" Opacity="0.9">
                <Border BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="2"
                        CornerRadius="14" Padding="36,24" Margin="24"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📎" FontSize="34" Margin="0,0,18,0" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center" MaxWidth="430">
                            <TextBlock Text="Drop to attach as context" FontSize="17" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Files, folders and images are added as context attachments. Send them with your message, or queue them while the model is busy."
                                       FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</UserControl>
