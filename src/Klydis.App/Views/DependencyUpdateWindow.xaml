<Window x:Class="Klydis.App.Views.DependencyUpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dependency Updates" Height="540" Width="620"
        MinHeight="440" MinWidth="540"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResizeWithGrip">

    <!-- Custom chrome mirrors MainWindow / TextContextWindow so this dialog follows
         Klydis's internal theme instead of the OS light/dark setting. -->
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CornerRadius="10" CaptionHeight="32" ResizeBorderThickness="6"/>
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Border Grid.Row="0" Background="{DynamicResource TitleBarBackgroundBrush}" CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                        <TextBlock Text="K" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Dependency Updates" Margin="6,0,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource TitleBarButtonStyle}" Click="MinimizeButton_Click">
                            <Path Data="M 0,5 L 10,5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
                        </Button>
                        <Button x:Name="MaximizeButton" Style="{StaticResource TitleBarButtonStyle}" Click="MaximizeButton_Click">
                            <Path Data="M 1,1 L 1,9 L 9,9 L 9,1 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
                        </Button>
                        <Button Style="{StaticResource CloseButtonStyle}" Click="CloseButton_Click">
                            <Path Data="M 1,1 L 9,9 M 1,9 L 9,1" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock Text="⚙ Dependency Updates" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Newer stable versions of Klydis's NuGet dependencies were found. Click Update to bump the pinned versions in the project files and restore the packages — the new versions apply after you restart Klydis."
                               FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>

                <ListBox Grid.Row="2" x:Name="UpdateList"
                         Background="Transparent" BorderBrush="{DynamicResource BorderMidBrush}" BorderThickness="1"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ItemsSource="{Binding Items, RelativeSource={RelativeSource AncestorType=Window}}"
                         Margin="0,0,0,14">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="FocusVisualStyle" Value="{DynamicResource KlydisFocusVisual}"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="6,4"/>
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding PackageId}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding VersionLine}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding ResultText}" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{Binding ResultBrush}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
                    <ProgressBar x:Name="ProgressBar" Width="180" Height="6" IsIndeterminate="True"
                                 Visibility="Collapsed" Foreground="{DynamicResource AccentPrimaryBrush}" Background="{DynamicResource BorderMidBrush}"
                                 VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                               Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <Border Grid.Row="4" x:Name="RestoreOutputPanel" Background="{DynamicResource InputBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderMidBrush}" BorderThickness="1" CornerRadius="6"
                        Padding="10" Margin="0,0,0,14" Visibility="Collapsed">
                    <ScrollViewer MaxHeight="90" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="RestoreOutputText" FontFamily="Consolas, Cascadia Code, Courier New"
                                   FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Border>

                <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="CloseButton" Content="Close" Click="CloseButton_Click" Width="90" Height="34" Margin="0,0,10,0" Style="{DynamicResource SecondaryButton}"/>
                    <Button x:Name="UpdateAllButton" Content="Update All" Click="UpdateAllButton_Click" Width="120" Height="34" Style="{DynamicResource PrimaryButton}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
