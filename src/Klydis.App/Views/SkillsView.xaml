<UserControl x:Class="Klydis.App.Views.SkillsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:Klydis.App.Converters"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.Resources>
        <converters:BoolToVisConverter x:Key="BoolToVisConverter"/>
        <converters:InverseBoolToVisConverter x:Key="InverseBoolToVisConverter"/>

        <!-- Rounded action button, matching the app's button language (PrimaryButton /
             SecondaryButton in ThemeStyles.xaml) rather than the default sharp-cornered
             WPF button - built locally so Background/Foreground/BorderBrush can still be
             overridden per-instance (danger vs. success vs. neutral) without fighting a
             shared style's own hover triggers. -->
        <Style x:Key="RoundedActionButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{DynamicResource KlydisFocusVisual}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, sans-serif"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Skill list row: selection/hover previously fell back to the OS default
             highlight (ListBox had no ItemContainerStyle), which ignored the app theme
             entirely and looked out of place. Selected/hover states now use the same
             accent-tinted convention as the session list and Settings nav. -->
        <Style x:Key="SkillRowStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="2"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M 12 2 L 2 7 L 12 12 L 22 7 Z M 2 17 L 12 22 L 22 17 M 2 12 L 12 17 L 22 12"
                          Stroke="{DynamicResource AccentPrimaryBrush}" StrokeThickness="2" Width="22" Height="22" Stretch="Uniform" Margin="0,0,10,0"/>
                    <TextBlock Text="Skill Library &amp; Brain" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Search & Filters -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBox Width="220" Height="32" AutomationProperties.Name="Search skills" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search skills by name, tag, or description"
                             Padding="8,6" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalContentAlignment="Center" Margin="0,0,10,0"/>

                    <ComboBox Width="180" Height="32" AutomationProperties.Name="Skill category filter" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                              Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                              VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Reload" Command="{Binding ReloadLibraryCommand}" Style="{StaticResource RoundedActionButtonStyle}"
                            Padding="12,6" Margin="0,0,8,0" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                    <Button Content="+ New Skill" Command="{Binding NewSkillCommand}" Style="{StaticResource RoundedActionButtonStyle}"
                            Padding="14,6" Background="{DynamicResource AccentPrimaryBrush}" Foreground="{DynamicResource TextInverse}" FontWeight="SemiBold" BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body: 2 Columns (Skill List | Skill Editor) -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Skill List -->
            <Border Grid.Column="0" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource TitleBarBackgroundBrush}" Padding="12,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Text="{Binding FilteredSkills.Count, StringFormat='Skills ({0})'}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Border>

                    <ListBox Grid.Row="1" ItemsSource="{Binding FilteredSkills}" SelectedItem="{Binding SelectedSkill}"
                             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{DynamicResource KlydisFocusVisual}"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SkillRowStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Enable/Disable Checkbox -->
                                        <CheckBox IsChecked="{Binding IsEnabled}" AutomationProperties.Name="{Binding Name, StringFormat='Enable {0}'}" VerticalAlignment="Top" Margin="0,3,10,0"
                                                  Command="{Binding DataContext.ToggleSkillCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                  CommandParameter="{Binding}"/>

                                        <StackPanel Grid.Column="1">
                                            <!-- Category pill used to sit inline next to the name (first in
                                                 a fixed MaxWidth box that clipped it, then in an Auto column
                                                 that squeezed the name down to a handful of characters once
                                                 the pill was allowed to show a long category in full). Long
                                                 category labels like "System Navigation & App Management"
                                                 don't leave enough room for either to breathe on one line at
                                                 this panel width, so the pill now sits on its own line below
                                                 the name - both get the full row width to themselves. -->
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" TextTrimming="CharacterEllipsis"/>

                                            <Border Background="{DynamicResource AccentSoftBrush}" Padding="6,2" CornerRadius="10" HorizontalAlignment="Left" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{DynamicResource AccentPrimaryBrush}" FontWeight="SemiBold"/>
                                            </Border>

                                            <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,4,0,4" TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis"/>

                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="{DynamicResource SurfaceElevatedBrush}" Padding="4,1" Margin="0,0,6,0" CornerRadius="3">
                                                    <TextBlock Text="{Binding Source}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </Border>
                                                <TextBlock Text="{Binding TagsText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Right Skill Details & Editor -->
            <Border Grid.Column="1" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Editor Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding EditName}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding EditId, StringFormat='({0})'}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Editor Form & Code Box -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Skill Name" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                                    <TextBox AutomationProperties.Name="Skill name" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Padding="6" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Category" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                                    <TextBox AutomationProperties.Name="Skill category" Text="{Binding EditCategory, UpdateSourceTrigger=PropertyChanged}" Padding="6" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Complexity Level" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                                    <ComboBox AutomationProperties.Name="Complexity level" ItemsSource="{Binding AvailableComplexities}" SelectedItem="{Binding EditComplexity}" Padding="6" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Tags (comma separated)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                                    <TextBox AutomationProperties.Name="Skill tags" Text="{Binding EditTags, UpdateSourceTrigger=PropertyChanged}" Padding="6" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Description" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                                <!-- Prose-length content: wraps instead of clipping mid-word
                                     off the edge of the panel (a single-line box was cutting
                                     descriptions off with no indication there was more text). -->
                                <TextBox AutomationProperties.Name="Skill description" Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="52" MaxHeight="110"
                                         VerticalScrollBarVisibility="Auto"
                                         Padding="6" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}"/>
                            </StackPanel>

                            <!-- Prompt Instructions Editor: was a hardcoded #1E1E1E/#D4D4D4
                                 block that never adapted to the app theme (jarring in light
                                 mode). Now uses the same code-surface convention as the chat
                                 view's markdown code blocks (SurfaceElevatedBrush + a visible
                                 border), so it stays legible and on-brand in every combination. -->
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Prompt Instructions &amp; Knowledge Directive (Markdown)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" FontWeight="SemiBold"/>
                                <TextBox AutomationProperties.Name="Prompt instructions and knowledge directive" Text="{Binding EditInstruction, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" MinHeight="260"
                                         FontFamily="Consolas, Courier New, monospace" FontSize="12"
                                         Padding="10" Background="{DynamicResource SurfaceElevatedBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer Buttons & Status -->
                    <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,8,0,0">
                        <!-- A shared cell with the status text stretching full-width and the
                             buttons right-aligned on top of it let a long status message
                             (e.g. "Saved skill '<long name>'") render underneath the buttons.
                             Splitting into two real columns, with the status text trimmed and
                             given a Margin clear of the button column, removes that overlap. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,16,0"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <!-- Outlined rather than solid-filled: ErrorBrush is tuned per
                                     mode for legibility as text/border against the panel, not
                                     as a big filled background needing its own paired
                                     foreground - this sidesteps having to pick a foreground
                                     that stays readable across every mode. Kept red rather than
                                     accent-colored even as themes/accents change, since a
                                     destructive action staying a fixed danger hue (it still
                                     shifts shade between Dark/Light) is what keeps it
                                     recognizable regardless of which accent is selected. -->
                                <Button Content="Delete Skill" Command="{Binding DeleteSkillCommand}" Style="{StaticResource RoundedActionButtonStyle}" Margin="0,0,10,0"
                                        Padding="12,6" Background="Transparent" Foreground="{DynamicResource ErrorBrush}" BorderBrush="{DynamicResource ErrorBrush}" BorderThickness="1"/>
                                <!-- Was a fixed SuccessBrush green with hardcoded white text,
                                     so it never reflected the selected accent theme. Switched to
                                     the same AccentPrimaryBrush/TextInverse pairing used by
                                     "+ New Skill" so this button's color follows whichever
                                     accent (Fluorescent/Violet/Amber/Rose/Forest) is active. -->
                                <Button Content="Save Changes" Command="{Binding SaveSkillCommand}" Style="{StaticResource RoundedActionButtonStyle}"
                                        Padding="16,6" Background="{DynamicResource AccentPrimaryBrush}" Foreground="{DynamicResource TextInverse}" FontWeight="Bold" BorderThickness="0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
