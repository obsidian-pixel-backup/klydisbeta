<UserControl x:Class="Klydis.App.Controls.CodeBlockControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="120" d:DesignWidth="400">

    <UserControl.Resources>
        <Style x:Key="CodeCopyButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{DynamicResource KlydisFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource SurfaceElevatedBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Margin="0,6,0,6"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header bar with language tag and copy button -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,5,8,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Language indicator -->
                    <TextBlock x:Name="LanguageLabel"
                               Grid.Column="0"
                               Text="CODE"
                               FontFamily="Consolas"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center"/>

                    <!-- Copy button -->
                    <Button x:Name="CopyButton"
                            Grid.Column="1"
                            Style="{StaticResource CodeCopyButtonStyle}"
                            Click="CopyButton_Click"
                            ToolTip="Copy code to clipboard" AutomationProperties.Name="Copy code to clipboard">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center">
                                <Path x:Name="CopyIcon"
                                      Data="M 2,4 L 2,12 L 10,12 M 4,2 L 12,2 L 12,10 L 4,10 Z"
                                      Stroke="{DynamicResource TextSecondaryBrush}"
                                      StrokeThickness="1.3"
                                      Stretch="Uniform"/>
                                <Path x:Name="CheckIcon"
                                      Data="M 2,7 L 5,10 L 11,3"
                                      Stroke="{DynamicResource SuccessBrush}"
                                      StrokeThickness="1.8"
                                      Stretch="Uniform"
                                      Visibility="Collapsed"/>
                            </Grid>
                            <TextBlock x:Name="CopyText"
                                       Text="Copy"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Code content area with horizontal scrolling -->
            <ScrollViewer Grid.Row="1"
                          x:Name="CodeScrollViewer"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          Padding="12,10"
                          Focusable="False"
                          PreviewMouseWheel="CodeScrollViewer_PreviewMouseWheel">
                <RichTextBox x:Name="CodeRichTextBox"
                             IsReadOnly="True"
                             IsDocumentEnabled="True"
                             Background="Transparent"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderThickness="0"
                             Padding="0"
                             Margin="0"
                             FontFamily="Consolas"
                             FontSize="13"
                             Focusable="True"
                             SelectionBrush="{DynamicResource AccentPrimaryBrush}"
                             SelectionOpacity="0.3">
                    <RichTextBox.Resources>
                        <Style TargetType="{x:Type Paragraph}">
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="LineHeight" Value="19"/>
                        </Style>
                    </RichTextBox.Resources>
                    <FlowDocument PagePadding="0">
                        <Paragraph x:Name="CodeParagraph"/>
                    </FlowDocument>
                </RichTextBox>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
