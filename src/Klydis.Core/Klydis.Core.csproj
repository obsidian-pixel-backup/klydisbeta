<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Klydis.Core</RootNamespace>
    <AssemblyName>Klydis.Core</AssemblyName>
    <Description>Klydis Core - Self-contained LLM inference engine with zero external dependencies</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- In-process GGUF inference - replaces Ollama entirely.
         LLamaSharp is vendored at third_party/LLamaSharp (v0.27.0) with a patched
         LLamaContextParams that matches the CURRENT llama.cpp ABI (n_rs_seq,
         n_outputs_max, ctx_type, ctx_other). This lets the app auto-update the native
         llama.dll to the latest llama.cpp release (e.g. minicpm5 tokenizer support).
         The backend packages below are the bundled baseline; the app's native
         auto-updater (NativeEngineManager) overrides them from %USERPROFILE%\.klydis\native\. -->
    <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
    <ProjectReference Include="..\..\third_party\LLamaSharp\LLama\LLamaSharp.csproj" />
    <PackageReference Include="LLamaSharp.Backend.Cuda12" Version="0.27.0" />
    <PackageReference Include="LLamaSharp.Backend.Vulkan" Version="0.27.0" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.27.0" />
    
    <!-- SQLite for message/session storage -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    
    <!-- Structured logging -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    
    <!-- WMI for system profiling (Windows) -->
    <PackageReference Include="System.Management" Version="10.0.11" />

    <!-- Playwright for local web crawling -->
    <PackageReference Include="Microsoft.Playwright" Version="1.62.0" />
    <PackageReference Include="ManagedCode.Playwright.Stealth" Version="1.0.1" />
    <PackageReference Include="ReverseMarkdown" Version="6.2.1" />
  </ItemGroup>

</Project>
